<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="410" d:DesignHeight="220"
             x:Class="XeniaManager.BigScreen.Controls.OptionsCard"
             x:DataType="vm:OptionsCardViewModel"
             Focusable="True"
             Classes.selected="{Binding IsSelected}">
    <Border x:Name="Tile" Background="{DynamicResource CardBackground}" CornerRadius="8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24" Spacing="16">
            <fluent:SymbolIcon Symbol="{Binding Icon}" FontSize="32" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" FontSize="22" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
