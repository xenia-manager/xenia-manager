<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.ViewModels.Controls"
             mc:Ignorable="d"
             d:DesignWidth="700"
             d:DesignHeight="500"
             x:Class="XeniaManager.Controls.TextFileDialog"
             x:DataType="vm:TextFileDialogViewModel"
             Width="700">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0"
                      MaxHeight="450"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Content}"
                                 TextWrapping="NoWrap"
                                 Margin="4" />
        </ScrollViewer>
        <TextBlock Grid.Row="1"
                   FontSize="12"
                   Margin="0,8,0,0">
            <Run Text="{DynamicResource TextFileDialog.Encoding.Label}" />
            <Run Text=": " />
            <Run Text="{Binding EncodingName}" />
            <TextBlock.Foreground>
                <DynamicResource ResourceKey="TextFillColorSecondaryBrush" />
            </TextBlock.Foreground>
        </TextBlock>
    </Grid>
</UserControl>