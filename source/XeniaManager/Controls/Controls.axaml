<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FluentAvalonia.UI.Controls"
        xmlns:cards="using:XeniaManager.Controls.Cards">
    <!-- Card Controls -->
    <StyleInclude Source="/Controls/Cards/CardHeader.axaml" />
    <StyleInclude Source="/Controls/Cards/CustomCard.axaml" />
    <StyleInclude Source="/Controls/Cards/DownloadProgressCard.axaml" />
    <StyleInclude Source="/Controls/Cards/ComboBoxCard.axaml" />
    <StyleInclude Source="/Controls/Cards/NumberBoxCard.axaml" />
    <StyleInclude Source="/Controls/Cards/SliderCard.axaml" />
    <StyleInclude Source="/Controls/Cards/TextBoxCard.axaml" />
    <StyleInclude Source="/Controls/Cards/ToggleSwitchCard.axaml" />

    <!-- Marks the currently controller-selected item in a context menu (experimental
         controller navigation), since arrow-key navigation isn't reliably simulatable
         for MenuFlyout popups, so a manual cursor + this highlight style are used instead -->
    <Style Selector="MenuItem.controllerCursor">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- Same idea, applied to the side navigation menu items (experimental controller
         navigation of Open Xenia/Library/Xenia Settings/Manage Xenia) -->
    <Style Selector="controls|FANavigationViewItem.controllerCursor">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- Marks the currently controller-selected control on "form-style" pages (Manage Xenia,
         Xenia Settings, Settings, About) - see PageGamepadNavigator. Uses a drop-shadow glow
         via Effect rather than Background: several of the custom Card controls hardcode their
         own Background in their control template (see CustomCard.axaml), so a Background
         setter here wouldn't actually be visible on them, while Effect is applied by the
         renderer on top of a control's whole visual output regardless of its template. -->
    <Style Selector="Button.controllerCursor, Expander.controllerCursor, ToggleSwitch.controllerCursor, ComboBox.controllerCursor, cards|ToggleSwitchCard.controllerCursor, cards|ComboBoxCard.controllerCursor, cards|NumberBoxCard.controllerCursor, cards|SliderCard.controllerCursor, cards|TextBoxCard.controllerCursor">
        <Setter Property="Effect">
            <DropShadowEffect Color="{DynamicResource SystemAccentColor}" BlurRadius="16" OffsetX="0" OffsetY="0" />
        </Setter>
    </Style>

    <!-- Add other Control Styles here -->
</Styles>