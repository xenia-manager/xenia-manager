<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:style="using:FluentAvalonia.Styling"
             xmlns:converters="using:XeniaManager.Core.Converters"
             xmlns:media="using:Avalonia.Media.Imaging"
             x:Class="XeniaManager.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:NotNullConverter x:Key="NotNullConverter" />
            <converters:StringIsNotEmptyConverter x:Key="StringIsNotEmptyConverter" />
            <converters:StringIsEmptyConverter x:Key="StringIsEmptyConverter" />
            <converters:CollectionIsEmptyConverter x:Key="CollectionIsEmptyConverter" />
            <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSourceConverter" />
            <converters:CompatibilityRatingColorConverter x:Key="CompatibilityRatingColorConverter" />
            <converters:CompatibilityRatingToStringConverter x:Key="CompatibilityRatingToStringConverter" />
            <converters:ConfigControlTypeToVisibilityConverter x:Key="ConfigControlTypeToVisibilityConverter" />
            <converters:DiscCountConverter x:Key="DiscCountConverter" />
            <converters:DoubleFormatConverter x:Key="DoubleFormatConverter" />
            <converters:PlaytimeConverter x:Key="PlaytimeConverter" />
            <converters:ZoomScaleConverter x:Key="ZoomScaleConverter" />
            <converters:XeniaVersionToIconConverter x:Key="XeniaVersionToIconConverter" />
            <converters:XeniaVersionToStringConverter x:Key="XeniaVersionToStringConverter" />
            <converters:EnumToValueConverter x:Key="EnumToValueConverter" />
            <converters:DateTimeToRelativeConverter x:Key="DateTimeToRelativeConverter" />
            <converters:MousehookSupportRatingToStringConverter x:Key="MousehookSupportRatingToStringConverter" />
            <converters:NetplayStatusValueToStringConverter x:Key="NetplayStatusValueToStringConverter" />

            <!-- Xbox controller button icons for the experimental controller navigation's hint
                 bar (see LibraryPage.axaml). Theme-adaptive via ThemeDictionaries: Avalonia
                 resolves DynamicResource lookups against the ambient ActualThemeVariant, so the
                 right glyph (colored for contrast against a light vs. dark background) is picked
                 automatically and updates live when the user switches theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <media:Bitmap x:Key="ControllerIcon.A">avares://XeniaManager/Assets/ControllerIcons/A_color_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.B">avares://XeniaManager/Assets/ControllerIcons/B_color_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.X">avares://XeniaManager/Assets/ControllerIcons/X_color_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.Y">avares://XeniaManager/Assets/ControllerIcons/Y_color_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.View">avares://XeniaManager/Assets/ControllerIcons/View_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.LB">avares://XeniaManager/Assets/ControllerIcons/LB_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.RB">avares://XeniaManager/Assets/ControllerIcons/RB_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.DPad">avares://XeniaManager/Assets/ControllerIcons/Digipad_dark.png</media:Bitmap>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <media:Bitmap x:Key="ControllerIcon.A">avares://XeniaManager/Assets/ControllerIcons/A_color_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.B">avares://XeniaManager/Assets/ControllerIcons/B_color_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.X">avares://XeniaManager/Assets/ControllerIcons/X_color_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.Y">avares://XeniaManager/Assets/ControllerIcons/Y_color_dark_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.View">avares://XeniaManager/Assets/ControllerIcons/View_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.LB">avares://XeniaManager/Assets/ControllerIcons/LB_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.RB">avares://XeniaManager/Assets/ControllerIcons/RB_light_32.png</media:Bitmap>
                    <media:Bitmap x:Key="ControllerIcon.DPad">avares://XeniaManager/Assets/ControllerIcons/Digipad_light.png</media:Bitmap>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <style:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="False" />
        <!-- Custom Controls -->
        <StyleInclude Source="/Controls/Controls.axaml" />
    </Application.Styles>
</Application>