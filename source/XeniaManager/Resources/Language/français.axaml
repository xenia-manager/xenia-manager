    <sys:String x:Key="MousehookControlsEditorDialog.RemoveEntry.ToolTip">Supprimer cette attribution</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.ToolTip">Détecter une touche</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.SubToolTip">Appuyez sur une touche ou un bouton de la souris</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.NoInputDetected.Title">Aucune touche détectée</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.NoInputDetected.Message">Aucune commande clavier ou souris n'a été détectée en 10 secondes.</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.Error.Title">Erreur de détection</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.Error.Message">Une erreur est survenue lors de la détection. Veuillez réessayer.</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.Save.Failed.Title">Échec de l'enregistrement</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.Validation.Key.None">La touche ne peut pas être "Aucune" pour l'attribution : {0}. Veuillez choisir une touche valide.</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.Validation.Value.None">La valeur ne peut pas être "Aucune" pour l'attribution : {0}. Veuillez choisir une commande manette valide.</sys:String>
