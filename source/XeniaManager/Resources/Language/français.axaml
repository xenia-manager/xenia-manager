    <sys:String x:Key="XeniaSettingsPage.NoConfigFile.SubMessage">Vérifiez que l'émulateur est installé ou lancez un jeu pour générer les fichiers de configuration.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.LoadConfig.Error.Title">Erreur de chargement</sys:String>
    <sys:String x:Key="XeniaSettingsPage.LoadConfig.Error.Message">Impossible de charger la configuration '{0}' : {1}</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.NoSelection.Title">Aucune configuration sélectionnée</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.NoSelection.Message">Veuillez sélectionner un fichier de configuration avant de réinitialiser les paramètres.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Confirmation.Title">Réinitialiser les paramètres</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Confirmation.Message">Voulez-vous vraiment restaurer tous les paramètres par défaut ?&#10;Cette action est irréversible.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Success.Title">Paramètres réinitialisés</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Success.Message">Configuration réinitialisée avec succès pour : {0}</sys:String>
