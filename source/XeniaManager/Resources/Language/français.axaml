    <sys:String x:Key="XeniaSettingsPage.ResetSettings.ToolTip">Réinitialiser les paramètres</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.ToolTip">Optimiser les paramètres</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoSelection.Title">Aucune configuration sélectionnée</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoSelection.Message">Veuillez sélectionner un fichier de configuration avant d'optimiser les paramètres.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoGame.Title">Aucun jeu sélectionné</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoGame.Message">Veuillez sélectionner un jeu avant d'optimiser les paramètres.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NotFound.Title">Configurations optimisées introuvables</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NotFound.Message">Aucune configuration optimisée trouvée pour : {0}</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.ConfigNotFound.Title">Configuration introuvable</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.ConfigNotFound.Message">Impossible de charger le fichier de configuration pour : {0}</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.Success.Title">Paramètres optimisés</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.Success.Message">Configurations optimisées appliquées avec succès pour : {0}</sys:String>
