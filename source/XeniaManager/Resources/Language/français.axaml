    <sys:String x:Key="SettingsPage.Ui.Theme.Option.System">Système</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Title">Écran de chargement</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Description">Afficher un arrière-plan au lancement des jeux</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.ToolTip">Affiche une animation d'écran de chargement pendant le démarrage des jeux</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Title">Options de débogage</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Description">Configurer le comportement et la verbosité des journaux</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Title">Niveau de journalisation</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Description">Définir le niveau minimal de sortie pour les journaux</sys:String>
    <sys:String x:Key="SettingsPage.General.Title">Paramètres généraux</sys:String>
    <sys:String x:Key="SettingsPage.General.Description">Configure les options générales de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia">Analyser les infos des jeux avec Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.Description">Analyser automatiquement les détails des jeux via l'émulateur Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.ToolTip">Activez cette option si vous rencontrez des problèmes pour détecter les jeux ou leurs détails</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle">Utiliser le MediaId pour le titre</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.Description">Utiliser le MediaId du jeu pour trouver le titre correspondant</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.ToolTip">Désactivez pour toujours utiliser le titre de la base de données globale</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork">Utiliser les illustrations intégrées</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.Description">Utiliser les images intégrées au jeu (icône, miniatures) avant de les télécharger</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.ToolTip">Si activé, l'icône et les images sont extraites du fichier de jeu (STFS/SVOD/ISO/ZAR/XEX). Désactivez pour toujours les télécharger.</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup">Vérifier les mises à jour au démarrage</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.Description">Rechercher automatiquement les mises à jour de Xenia et du Manager au lancement</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.ToolTip">Désactivez cette option pour ignorer la recherche des mises à jour au démarrage</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames">Détection automatique des nouveaux jeux</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.Description">Détecter automatiquement l'ajout de nouveaux jeux dans le dossier de jeux</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.ToolTip">Affiche une notification lorsque de nouveaux fichiers de jeux sont détectés dans le dossier</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc">Fusionner auto des jeux multi-disques</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.Description">Fusionner automatiquement les disques d'un même jeu lors de l'analyse</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.ToolTip">Si activé, les disques additionnels correspondant à un jeu existant sont fusionnés sans confirmation</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen">Démarrer en mode Bigscreen</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.Description">Lancer le mode Bigscreen à la place de la fenêtre principale au démarrage</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.ToolTip">Si activé, Xenia Manager ouvre directement le mode Bigscreen au lancement</sys:String>

