    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Failure.Message">Impossible de réinitialiser le fichier de configuration '{0}' : {1}</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OpenInEditor.NoSelection.Title">Aucune configuration sélectionnée</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OpenInEditor.NoSelection.Message">Veuillez sélectionner un fichier de configuration avant d'ouvrir l'éditeur.</sys:String>
