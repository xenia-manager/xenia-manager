    <!-- Config UI Settings - APU Options -->
    <sys:String x:Key="ConfigUiSettings.APU.apu.Title">Système audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.Comment">Système audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.any">N'importe lequel (Any)</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.nop">Aucun (Nop)</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.sdl">SDL</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.xaudio2">XAudio2</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu_max_queued_frames.Title">Nombre max de trames en file d'attente</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu_max_queued_frames.Comment">Permet de modifier le tampon audio max pour réduire la latence&#10;Baisser cette valeur peut affecter les performances</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.mute.Title">Couper le son</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.mute.Comment">Coupe toute la sortie audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.enable_xmp.Title">XMP</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.enable_xmp.Comment">Active la lecture du lecteur de musique&#10;Peut corriger les musiques dans certains jeux</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xmp_default_volume.Title">Volume XMP par défaut</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xmp_default_volume.Comment">Volume de la musique par défaut si le jeu ne le définit pas</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_dedicated_xma_thread.Title">Thread XMA dédié</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_dedicated_xma_thread.Comment">Active le décodage XMA sur un thread distinct&#10;Désactiver cette option offre de meilleurs résultats, mais réduit les performances</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_new_decoder.Title">Décodeur audio XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_new_decoder.Comment">Active l'utilisation du nouveau décodeur audio XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.Title">Décodeur XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.Comment">fake : Aucun audio ne sera décodé&#10;master : Version identique à la version de base de Xenia&#10;old : Basé sur master avec quelques améliorations&#10;new : Nouvelle version. Offre la meilleure stabilité, mais n'est pas terminée</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.fake">Fake</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.master">Master</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.old">Ancien (Old)</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.new">Nouveau (New)</sys:String>

    <!-- Config UI Settings - Content Options -->
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.Title">Masque de licence</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.Comment">- Sans licence : Mode démo&#10;- Première licence : Généralement la licence du jeu complet pour les titres Xbox Live Arcade&#10;- Toutes les licences : Active toutes les licences possibles, mais peut causer des comportements imprévus</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.0">Sans licence</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.1">Première licence</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.-1">Toutes les licences</sys:String>

    <!-- Config UI Settings - CPU Options -->
    <sys:String x:Key="ConfigUiSettings.CPU.break_on_unimplemented_instructions.Title">Interrompre sur instructions non implémentées</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.break_on_unimplemented_instructions.Comment">Interrompt vers le débogueur hôte (ou plante si aucun débogueur n'est connecté) si une instruction PowerPC non implémentée est rencontrée</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disable_context_promotion.Title">Désactiver la promotion de contexte</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disable_context_promotion.Comment">Désactive les optimisations de promotion de contexte&#10;Cela peut être nécessaire pour certains jeux de sport, mais réduira les performances</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disassemble_functions.Title">Désassembler les fonctions</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disassemble_functions.Comment">Désassemble les fonctions pendant la génération</sys:String>

    <!-- Config UI Settings - D3D12 Options -->
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_allow_variable_refresh_rate_and_tearing.Title">Autoriser le taux de rafraîchissement variable et le déchirement</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_allow_variable_refresh_rate_and_tearing.Comment">En plein écran, autorise le taux de rafraîchissement variable (VRR) sur les écrans compatibles&#10;Sur les écrans non compatibles, des déchirements d'écran (tearing) peuvent survenir dans certains cas</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.Title">Priorité de la file d'attente</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.Comment">Priorité de planification de la file d'attente des commandes graphiques (directes)&#10;0 - Normale&#10;1 - Haute&#10;2 - Temps réel global (nécessite les privilèges administrateur et peut impacter la réactivité du système)</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.0">Normale</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.1">Haute</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.2">Temps réel global</sys:String>

    <!-- Config UI Settings - Display Options -->
    <sys:String x:Key="ConfigUiSettings.Display.fullscreen.Title">Plein écran</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.fullscreen.Comment">Indique si l'émulateur doit se lancer en plein écran</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.present_letterbox.Title">Affichage Letterbox (Bandes noires)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.present_letterbox.Comment">Conserve le rapport d'aspect lors de l'étirement en affichant des bandes noires autour de l'image lorsqu'il n'y a plus de zone de surbalayage à rogner</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.Title">Anti-aliasing (Anticrénelage)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.Comment">Effet d'anti-aliasing de post-traitement à appliquer sur la sortie de l'image du jeu</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.none">Aucun</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.fxaa">FXAA</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.fxaa_extreme">FXAA Extrême</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.Title">Mise à l'échelle et Netteté</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.Comment">Effet de post-traitement à utiliser pour le rééchantillonnage et/ou l'amélioration de la netteté de l'image finale</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.bilinear">Bilinéaire</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.cas">CAS</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.fsr">FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_sharpness_reduction.Title">Réduction de la netteté FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_sharpness_reduction.Comment">Réduction de la netteté pour l'AMD FidelityFX Super Resolution 1.0 (FSR), en paliers&#10;Une valeur plus basse donne une image plus nette</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_cas_additional_sharpness.Title">Netteté additionnelle CAS</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_cas_additional_sharpness.Comment">Netteté supplémentaire pour l'AMD FidelityFX Contrast Adaptive Sharpening (CAS), de 0 à 1&#10;Une valeur plus élevée donne une image plus nette</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_max_upsampling_passes.Title">Passes d'upsampling max FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_max_upsampling_passes.Comment">Nombre maximum de passes de mise à l'échelle effectuées avec l'AMD FidelityFX Super Resolution 1.0 (FSR) avant de basculer sur un étirement bilinéaire après la dernière passe</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_dither.Title">Dithering (Trame de diffusion)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_dither.Comment">Applique un trame (dithering) sur l'image finale pour passer de la précision interne à 8 bits par canal afin de rendre les dégradés plus fluides</sys:String>

    <!-- Config UI Settings - General Options -->
    <sys:String x:Key="ConfigUiSettings.General.allow_plugins.Title">Autoriser les plug-ins</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.allow_plugins.Comment">Autorise le chargement de plug-ins/trainers depuis plugins\\title_id\\plugin.xex&#10;Les plug-ins sont des modules xex artisanaux utilisés pour créer des mods&#10;Cette fonction est expérimentale</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.discord.Title">Discord Rich Presence</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.discord.Comment">Activer la Rich Presence Discord</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.apply_patches.Title">Appliquer les patchs</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.apply_patches.Comment">Active les fonctionnalités de patch personnalisées</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.controller_hotkeys.Title">Raccourcis de la manette</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.controller_hotkeys.Comment">Raccourcis pour manettes Xbox et PlayStation</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.launch_module.Title">Module de lancement</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.launch_module.Comment">Exécutable à lancer depuis l'ISO ou le package à la place de default.xex ou du module spécifié par le jeu&#10;Laisser vide pour lancer le module par défaut</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.notification_sound_path.Title">Chemin du son de notification</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.notification_sound_path.Comment">Chemin d'accès complet (nom de fichier inclus) vers le son de notification choisi&#10;NOTE : Le son DOIT être au format wav !</sys:String>

    <!-- Config UI Settings - GPU Options -->
    <sys:String x:Key="ConfigUiSettings.GPU.vsync.Title">Synchronisation verticale (VSync)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.vsync.Comment">Active la VSync</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.framerate_limit.Title">Limite de framerate</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.framerate_limit.Comment">Nombre maximum d'images par seconde&#10;0 = Images illimitées&#10;Par défaut à 60 si défini sur 0 et que la VSync est activée</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.Title">Système graphique</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.Comment">Système graphique à utiliser</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.any">N'importe lequel (Any)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.d3d12">D3D12</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.vulkan">Vulkan</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.null">Null</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.Title">Chemin du Render Target (D3D12)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.Comment">Chemin d'émulation de la cible de rendu sur Direct3D 12&#10;RTV - Cibles de rendu de l'hôte&#10;ROV - Vues ordonnées par le rastériseur</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.any">Auto</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.rtv">RTV</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.rov">ROV</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.Title">Chemin du Render Target (Vulkan)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.Comment">Chemin d'émulation de la cible de rendu sur Vulkan&#10;FBO - Framebuffers de l'hôte&#10;FSI - Verrouillage des fragments de shaders</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.any">Auto</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.fbo">FBO</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.fsi">FSI</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.Title">Lecture différée (Readback Resolve)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.Comment">Contrôle la relecture processeur des résultats de rendu vers texture&#10;None - Désactive la relecture&#10;Fast - Délai de 1 image&#10;Full - Précis mais lent</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.none">Aucun </sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.fast">Rapide </sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.full">Complet </sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_memexport.Title">Lecture Memexport </sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_memexport.Comment">Lit sur le processeur les données écrites par export de mémoire dans les shaders.&#10;Peut être requis par certains jeux, mais cause une synchronisation en milieu d'image avec un énorme impact sur les performances</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_x.Title">Échelle de résolution de rendu X</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_x.Comment">Échelle entière de la largeur des pixels utilisée pour multiplier la résolution de rendu de façon transparente pour le jeu</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_y.Title">Échelle de résolution de rendu Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_y.Comment">Échelle entière de la hauteur des pixels utilisée pour multiplier la résolution de rendu de façon transparente pour le jeu</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu_allow_invalid_fetch_constants.Title">Autoriser les constantes de récupération invalides</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu_allow_invalid_fetch_constants.Comment">Autorise les constantes de récupération de texture et de vertex de type invalide&#10;Généralement risqué, mais peut servir à contourner les erreurs de type de constante de récupération dans certains jeux</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gamma_render_target_as_srgb.Title">Cible de rendu Gamma en sRGB</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gamma_render_target_as_srgb.Comment">Lorsque l'hôte ne peut pas écrire directement un gamma linéaire par morceaux avec un mélange correct, utilise la sortie sRGB sur l'hôte pour un mélange conceptuellement correct dans l'espace colorimétrique linéaire</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_lower_threshold.Title">Seuil inférieur de test d'occlusion</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_lower_threshold.Comment">Si défini sur -1, aucun compteur d'échantillons n'est écrit, les jeux peuvent se bloquer&#10;Sinon, le compteur d'échantillons de chaque tuile sera incrémenté à chaque EVENT_WRITE_ZPD de cette valeur</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_upper_threshold.Title">Seuil supérieur de test d'occlusion</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_upper_threshold.Comment">À définir sur une valeur plus élevée que le seuil inférieur de test d'occlusion&#10;Cette valeur est ignorée si le seuil inférieur est défini sur -1</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.use_fuzzy_alpha_epsilon.Title">Utiliser le Fuzzy Alpha Epsilon</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.use_fuzzy_alpha_epsilon.Comment">Utilise une comparaison approximative pour les valeurs alpha afin d'éviter les clignotements sur les cartes graphiques NVIDIA</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.clear_memory_page_state.Title">Vider l'état des pages mémoire</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.clear_memory_page_state.Comment">Actualise l'état des pages mémoire pour activer les données écrites par le GPU</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.Title">Forcer le filtrage anisotrope</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.Comment">Force le filtrage anisotrope (AF) pour les textures éligibles&#10;Des valeurs plus élevées gardent les textures plus nettes sous des angles obliques au prix de la bande passante GPU&#10;Dans de rares cas, forcer l'AF peut introduire des artefacts visuels</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.-1">Pas de modification (Par défaut)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.0">Désactiver le filtrage anisotrope</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.1">1x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.2">2x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.3">4x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.4">8x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.5">16x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.async_shader_compilation.Title">Compilation de shaders asynchrone</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.async_shader_compilation.Comment">Compile les shaders et crée les pipelines de manière asynchrone dans des threads d'arrière-plan&#10;Élimine les saccades dues à la compilation des shaders, mais peut provoquer de légers artefacts visuels temporaires pendant la création des pipelines&#10;Si désactivé, les pipelines sont créés de manière synchrone, ce qui cause des saccades mais aucun artefact visuel</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.Title">Requête d'occlusion (Occlusion Query)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.Comment">Contrôle le comportement de la requête d'occlusion matérielle pour EVENT_WRITE_ZPD&#10;Utilisé pour des effets comme les reflets d'objectif (lens flares), le masquage d'objets (culling) et l'exposition auto&#10;fake : Écrit un faux résultat sans interroger le GPU. Sûr pour la plupart des jeux&#10;fast : Interroge le GPU mais sans attendre. Écrit un résultat mis en cache, actualisé dès que le GPU rattrape son retard (Par défaut)&#10;fast-alt : Comme fast, mais conserve les résultats zéro mis en cache pour les rapports non résolus&#10;strict : Interroge le GPU et attend le résultat réel. Le plus précis, mais moins performant</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fake">Fake</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fast">Fast (Par défaut)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fast-alt">Fast-Alt</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.strict">Strict</sys:String>

    <!-- Config UI Settings - HID Options -->
    <sys:String x:Key="ConfigUiSettings.HID.hid.Title">Système d'entrées </sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.Comment">Système de commandes à utiliser</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.any">N'importe lequel (Any)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.nop">Aucun (Nop)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.sdl">SDL</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.winkey">WinKey</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.xinput">XInput</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.Title">Mode clavier</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.Comment">Permet de spécifier le mode de fonctionnement du clavier :&#10;0 - Désactivé&#10;1 - Activé&#10;2 - Mode relais (Passthrough), nécessite qu'une manette soit connectée</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.0">Désactivé</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.1">Activé</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.2">Mode relais (Passthrough)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_user_index.Title">Index utilisateur du clavier</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_user_index.Comment">Port de manette émulé par le clavier (0-3)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.left_stick_deadzone_percentage.Title">Zone morte du stick gauche</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.left_stick_deadzone_percentage.Comment">Définit le niveau de zone morte pour le stick gauche (0-100%)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.right_stick_deadzone_percentage.Title">Zone morte du stick droit</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.right_stick_deadzone_percentage.Comment">Définit le niveau de zone morte pour le stick droit (0-100%)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.vibration.Title">Vibration</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.vibration.Comment">Activer ou désactiver les vibrations de la manette</sys:String>

    <!-- Config UI Settings - HID.WinKey Options -->
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_a.Title">Bouton A</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_a.Comment">Liste des touches à attribuer à A, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_b.Title">Bouton B</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_b.Comment">Liste des touches à attribuer à B, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_back.Title">Bouton BACK</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_back.Comment">Liste des touches à attribuer à BACK, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_down.Title">Croix directionnelle Bas</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_down.Comment">Liste des touches à attribuer à DPAD_DOWN, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "^S" signifie Maj+S</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_left.Title">Croix directionnelle Gauche</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_left.Comment">Liste des touches à attribuer à DPAD_LEFT, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "^A" signifie Maj+A</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_right.Title">Croix directionnelle Droite</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_right.Comment">Liste des touches à attribuer à DPAD_RIGHT, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "^D" signifie Maj+D</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_up.Title">Croix directionnelle Haut</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_up.Comment">Liste des touches à attribuer à DPAD_UP, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "^W" signifie Maj+W</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_guide.Title">Bouton Guide</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_guide.Comment">Liste des touches à attribuer à GUIDE, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "0x08" correspond à Retour arrière (Backspace)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_shoulder.Title">Gâchette haute gauche (LB)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_shoulder.Comment">Liste des touches à attribuer à LEFT_SHOULDER, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb.Title">Pression stick gauche</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb.Comment">Liste des touches à attribuer à LEFT_THUMB_PRESSED, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_down.Title">Stick gauche Bas</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_down.Comment">Liste des touches à attribuer à LEFT_THUMB_DOWN, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "_S" signifie S sans la touche Maj</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_left.Title">Stick gauche Gauche</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_left.Comment">Liste des touches à attribuer à LEFT_THUMB_LEFT, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "_A" signifie A sans la touche Maj</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_right.Title">Stick gauche Droite</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_right.Comment">Liste des touches à attribuer à LEFT_THUMB_RIGHT, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "_D" signifie D sans la touche Maj</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_up.Title">Stick gauche Haut</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_up.Comment">Liste des touches à attribuer à LEFT_THUMB_UP, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "_W" signifie W sans la touche Maj</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_trigger.Title">Gâchette basse gauche (LT)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_trigger.Comment">Liste des touches à attribuer à LEFT_TRIGGER, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I à la même gâchette</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_shoulder.Title">Gâchette haute droite (RB)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_shoulder.Comment">Liste des touches à attribuer à RIGHT_SHOULDER, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb.Title">Pression stick droit</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb.Comment">Liste des touches à attribuer à RIGHT_THUMB_PRESSED, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_down.Title">Stick droit Bas</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_down.Comment">Liste des touches à attribuer à RIGHT_THUMB_DOWN, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "0x28" correspond à la flèche Bas</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_left.Title">Stick droit Gauche</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_left.Comment">Liste des touches à attribuer à RIGHT_THUMB_LEFT, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "0x25" correspond à la flèche Gauche</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_right.Title">Stick droit Droite</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_right.Comment">Liste des touches à attribuer à RIGHT_THUMB_RIGHT, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "0x27" correspond à la flèche Droite</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_up.Title">Stick droit Haut</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_up.Comment">Liste des touches à attribuer à RIGHT_THUMB_UP, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "0x26" correspond à la flèche Haut</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_trigger.Title">Gâchette basse droite (RT)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_trigger.Comment">Liste des touches à attribuer à RIGHT_TRIGGER, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "E O" attribue à la fois E et O à la même gâchette</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_start.Title">Bouton START</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_start.Comment">Liste des touches à attribuer à START, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_x.Title">Bouton X</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_x.Comment">Liste des touches à attribuer à X, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_y.Title">Bouton Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_y.Comment">Liste des touches à attribuer à Y, séparées par des espaces. Format : Code de touche virtuelle (0x26), caractère unique (A-Z, 0-9), avec modificateurs (^ requiert Maj, _ requiert aucun Maj). Exemple : "Q I" attribue à la fois Q et I</sys:String>

    <!-- Config UI Settings - Kernel Options -->
    <sys:String x:Key="ConfigUiSettings.Kernel.apply_title_update.Title">Appliquer les mises à jour de jeu (TU)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.apply_title_update.Comment">Applique les mises à jour des jeux</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.cl.Title">Ligne de commande</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.cl.Comment">Spécifier des arguments de ligne de commande supplémentaires pour le système invité</sys:String>

    <!-- Config UI Settings - Logging Options -->
    <sys:String x:Key="ConfigUiSettings.Logging.enable_console.Title">Activer la console</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.enable_console.Comment">Ouvre une fenêtre de console en même temps que la fenêtre principale</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.Title">Niveau de journalisation</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.Comment">Niveau maximal d'informations à enregistrer dans le journal</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.0">Erreur </sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.1">Avertissement </sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.2">Infos </sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.3">Débogage </sys:String>

    <!-- Config UI Settings - Memory Options -->
    <sys:String x:Key="ConfigUiSettings.Memory.protect_zero.Title">Protéger la page zéro</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.protect_zero.Comment">Protège la page zéro contre les lectures et les écritures</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.scribble_heap.Title">Scribble Heap</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.scribble_heap.Comment">Remplit de valeurs spécifiques ou aléatoires toute la mémoire du tas allouée</sys:String>

    <!-- Config UI Settings - Storage Options -->
    <sys:String x:Key="ConfigUiSettings.Storage.mount_cache.Title">Monter le cache</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_cache.Comment">Active le montage du dossier cache</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_scratch.Title">Monter le scratch</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_scratch.Comment">Active le montage du dossier de stockage temporaire (scratch)</sys:String>

    <!-- Config UI Settings - UI Options -->
    <sys:String x:Key="ConfigUiSettings.UI.show_achievement_notification.Title">Afficher les notifications de succès</sys:String>
    <sys:String x:Key="ConfigUiSettings.UI.show_achievement_notification.Comment">Affiche une notification à l'écran lors du déverrouillage d'un succès</sys:String>

    <!-- Config UI Settings - Video Options -->
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.Title">Résolution d'affichage interne</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.Comment">Permet aux jeux compatibles avec différentes résolutions de s'afficher dans une résolution spécifique</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.0">640x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.1">640x576</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.2">720x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.3">720x576</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.4">800x600</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.5">848x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.6">1024x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.7">1152x864</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.8">1280x720</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.9">1280x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.10">1280x960</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.11">1280x1024</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.12">1360x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.13">1440x900</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.14">1680x1050</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.15">1920x540</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.16">1920x1080</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.17">Personnalisée (X/Y)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Title">Largeur de résolution personnalisée</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Comment">Largeur personnalisée pour la résolution d'affichage interne&#10;NOTE : Nécessite que la résolution d'affichage interne soit définie sur "Personnalisée (X/Y)" pour s'appliquer</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Title">Hauteur de résolution personnalisée</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Comment">Hauteur personnalisée pour la résolution d'affichage interne&#10;NOTE : Nécessite que la résolution d'affichage interne soit définie sur "Personnalisée (X/Y)" pour s'appliquer</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.widescreen.Title">Écran large (Widescreen)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.widescreen.Comment">Bascule entre un rapport d'aspect 16:9 et 4:3</sys:String>

    <!-- Config UI Settings - Vulkan Options -->
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_immediate.Title">Autoriser le mode d'affichage immédiat</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_immediate.Comment">Si disponible, autorise le mode d'affichage immédiat (priorité 1), offrant la plus faible latence possible avec un risque de déchirement de l'image (tearing) dans certains cas</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_mailbox.Title">Autoriser le mode d'affichage boîte aux lettres (Mailbox)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_mailbox.Comment">Si disponible, autorise le mode d'affichage boîte aux lettres (priorité 2), offrant une faible latence sans aucun déchirement de l'image</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_fifo_relaxed.Title">Autoriser le mode d'affichage FIFO Relaxed</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_fifo_relaxed.Comment">Si disponible, autorise le mode d'affichage premier entré, premier sorti assoupli (priorité 3), ce qui force l'attente de la synchronisation verticale de l'écran hôte, mais peut provoquer des déchirements si le framerate descend sous le taux de rafraîchissement</sys:String>

    <!-- Config UI Settings - Live/Netplay Options -->
    <sys:String x:Key="ConfigUiSettings.Live.api_address.Title">Adresse de l'API</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.api_address.Comment">Adresse du serveur Xenia (ex: IP:PORT)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.discord_presence_user_index.Title">Index utilisateur Discord RPC</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.discord_presence_user_index.Comment">Index du profil utilisateur utilisé pour la Rich Presence Discord [0-3]</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.Title">Mode réseau</sys:Title>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.Comment">Mode réseau&#10;0 - Hors ligne&#10;1 - Liaison multiconsole (Systemlink)&#10;2 - Xbox Live</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.0">Hors ligne</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.1">Liaison multiconsole (Systemlink)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.2">Xbox Live</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.upnp.Title">UPnP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.upnp.Comment">Ouvrir automatiquement les ports à l'aide de l'UPnP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xhttp.Title">XHTTP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xhttp.Comment">Activer ou désactiver le protocole XHTTP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xlink_kai_systemlink_hack.Title">Hack SystemLink XLink Kai</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xlink_kai_systemlink_hack.Comment">Active les hacks pour la compatibilité avec XLink Kai&#10;Peut faire planter certains jeux</sys:String>

    <!-- Config UI Settings - MouseHook Options -->
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_autoaim.Title">Désactiver la visée automatique</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_autoaim.Comment">Désactive la visée automatique dans les jeux qui la prennent en charge (GoldenEye, Perfect Dark, Saints Row, COD)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_fullscreen_esc_bind.Title">Désactiver la touche Échap en plein écran</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_fullscreen_esc_bind.Comment">Empêche la touche Échap de quitter le mode plein écran lorsque celui-ci est actif</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.fov_sensitivity.Title">Sensibilité du FOV</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.fov_sensitivity.Comment">Échelle de la souris lorsque le FOV est réduit (Jeux COD, DR, RDR &amp; UE3)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_aim_turn_distance.Title">(GoldenEye/Perfect Dark)&#10;Distance de rotation de visée</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_aim_turn_distance.Comment">(GoldenEye/Perfect Dark) Distance maximale de déplacement du réticule en mode visée avant de faire pivoter la caméra</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_debug_menu.Title">(GoldenEye)&#10;Menu de débogage</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_debug_menu.Comment">(GoldenEye) Active le menu de débogage, accessible avec LB/1</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_gun_sway.Title">(GoldenEye/Perfect Dark)&#10;Oscillation de l'arme</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_gun_sway.Comment">(GoldenEye/Perfect Dark) Active l'oscillation de l'arme lorsque la caméra tourne</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_remove_blur.Title">(GoldenEye)&#10;Supprimer le flou</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_remove_blur.Comment">(GoldenEye) Supprime le flou basse résolution en mode graphismes classiques</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.internal_hook.Title">Injection interne (Internal Hook)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.internal_hook.Comment">Utilise une meilleure technique d'accroche pour de meilleurs résultats d'injection de la souris (Saints Row 1)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_x.Title">Inverser l'axe X</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_x.Comment">Inverse l'axe horizontal (X) de la souris</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_y.Title">Inverser l'axe Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_y.Comment">Inverse l'axe vertical (Y) de la souris</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.menu_sensitivity.Title">(GoldenEye/Saints Row 1)&#10;Sensibilité dans les menus</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.menu_sensitivity.Comment">(GoldenEye/Saints Row 1) Sensibilité de la souris lors de la navigation dans les menus</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_snappy_wheel.Title">(Red Dead Redemption)&#10;Roue des armes magnétique</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_snappy_wheel.Comment">(Red Dead Redemption) Aligne la roue des armes par paliers de 45 degrés</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_turbo_gallop_horse.Title">(Red Dead Redemption)&#10;Grand galop turbo</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_turbo_gallop_horse.Comment">(Red Dead Redemption) Active le grand galop turbo pour les chevaux et les diligences</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sensitivity.Title">Sensibilité de la souris</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sensitivity.Comment">Sensibilité générale de la souris</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.source_sniper_sensitivity.Title">Sensibilité lunette (Source)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.source_sniper_sensitivity.Comment">Sensibilité de la lunette de sniper pour les jeux utilisant le moteur Source</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr1_increase_vehicle_rotation_limit.Title">(Saints Row 1)&#10;Limite de rotation des véhicules</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr1_increase_vehicle_rotation_limit.Comment">(Saints Row 1) Aligne la limite de rotation verticale des véhicules pour qu'elle soit quasiment identique à celle à pied</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_better_handbrake_cam.Title">(Saints Row 2)&#10;Meilleure caméra au frein à main</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_better_handbrake_cam.Comment">(Saints Row 2) Dissocie la rotation X des véhicules lors de l'utilisation du frein à main comme dans SR1</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_hold_fine_aim.Title">(Saints Row 2)&#10;Maintenir la visée précise</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_hold_fine_aim.Comment">(Saints Row 2) Alterne la visée précise (ADS) d'un mode bascule à un mode maintenir enfoncé</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_better_drive_cam.Title">(Saints Row 1 &amp; 2)&#10;Meilleure caméra de conduite</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_better_drive_cam.Comment">(Saints Row 1 &amp; 2) Dissocie la rotation X des véhicules lorsque le centrage automatique est désactivé</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_disable_shared_reload.Title">(Saints Row 1)&#10;Désactiver le rechargement partagé</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_disable_shared_reload.Comment">(Saints Row 1) Désactive le rechargement des armes lors de la pression sur le bouton interne (A)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.swap_wheel.Title">(Saints Row 1)&#10;Inverser la molette</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.swap_wheel.Comment">Inverse les commandes de la molette pour la sélection des armes et le zoom de la carte dans Saints Row 1</sys:String>

    <!-- About Page -->
    <sys:String x:Key="AboutPage.App.Description">Un outil de gestion complet pour l'émulateur Xenia. Installez, mettez à jour et gérez facilement les différentes versions de Xenia grâce à une interface intuitive.</sys:String>
    <sys:String x:Key="AboutPage.WebsiteButton.Text">Site web</sys:String>
    <sys:String x:Key="AboutPage.GithubButton.Text">GitHub</sys:String>
    <sys:String x:Key="AboutPage.CheckForUpdatesButton.Text">Rechercher des MAJ</sys:String>
    <sys:String x:Key="AboutPage.UpdateXeniaManagerButton.Text">Mettre à jour Xenia Manager</sys:String>
    <sys:String x:Key="AboutPage.CheckForUpdatesFailed.Title">Échec de la recherche</sys:String>
    <sys:String x:Key="AboutPage.CheckForUpdatesFailed.Message">Une erreur est survenue lors de la recherche de mises à jour :&#10;{0}</sys:String>
    <sys:String x:Key="AboutPage.UpdateFailed.Title">Échec de la mise à jour</sys:String>
    <sys:String x:Key="AboutPage.UpdateFailed.Message">Une erreur est survenue lors de la mise à jour de Xenia Manager :&#10;{0}</sys:String>
    <sys:String x:Key="AboutPage.UpdateFailed.NoReleaseInfo">Impossible de récupérer les informations de version. Veuillez réessayer plus tard.</sys:String>
    <sys:String x:Key="AboutPage.DownloadingUpdate">Téléchargement de la mise à jour</sys:String>
    <sys:String x:Key="AboutPage.ExtractingUpdate">Extraction de la mise à jour</sys:String>
    <sys:String x:Key="AboutPage.LicenseCredits.Text">Licence &amp; Crédits</sys:String>
    <sys:String x:Key="AboutPage.LicenseCredits.SideText">Informations légales et remerciements</sys:String>
    <sys:String x:Key="AboutPage.License.Text">Ce logiciel est sous licence BSD-3-Clause.</sys:String>
    <sys:String x:Key="AboutPage.Xbox360Emulation.Header">Émulation Xbox 360</sys:String>
    <sys:String x:Key="AboutPage.Libraries.Header">Bibliothèques</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaProject.Title">Projet Xenia</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaProject.ToolTip"> - L'émulateur Xbox 360 d'origine</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaCanary.Title">Xenia Canary</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaCanary.ToolTip"> - Version expérimentale intégrant les dernières nouveautés</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaNetplay.Title">Xenia Netplay</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaNetplay.ToolTip"> - Support des fonctionnalités multijoueurs</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaMousehook.Title">Xenia Mousehook</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaMousehook.ToolTip"> - Support du clavier et de la souris</sys:String>
    <sys:String x:Key="AboutPage.Credits.AvaloniaUi.Title">Avalonia UI</sys:String>
    <sys:String x:Key="AboutPage.Credits.AvaloniaUi.ToolTip"> - Framework d'interface multiplateforme au design Fluent</sys:String>
    <sys:String x:Key="AboutPage.Credits.CommunityToolkitMvvm.Title">CommunityToolkit.Mvvm</sys:String>
    <sys:String x:Key="AboutPage.Credits.CommunityToolkitMvvm.ToolTip"> - Framework MVVM pour .NET</sys:String>
    <sys:String x:Key="AboutPage.Credits.DependencyInjection.Title">Microsoft.Extensions.DependencyInjection</sys:String>
    <sys:String x:Key="AboutPage.Credits.DependencyInjection.ToolTip"> - Conteneur d'injection de dépendances pour .NET</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentAvalonia.Title">FluentAvalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentAvalonia.ToolTip"> - Contrôles et thèmes Fluent Design pour Avalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentIcons.Title">FluentIcons</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentIcons.ToolTip"> - Framework d'intégration des icônes Fluent</sys:String>
    <sys:String x:Key="AboutPage.Credits.NLog.Title">NLog</sys:String>
    <sys:String x:Key="AboutPage.Credits.NLog.ToolTip"> - Framework de journalisation flexible pour .NET</sys:String>
    <sys:String x:Key="AboutPage.Credits.Xbox360Toolkit.Title">Xbox 360 Toolkit</sys:String>
    <sys:String x:Key="AboutPage.Credits.Xbox360Toolkit.ToolTip"> - Analyse des informations des jeux</sys:String>
    <sys:String x:Key="AboutPage.Credits.Sdl3Cs.Title">ppy.SDL3-CS</sys:String>
    <sys:String x:Key="AboutPage.Credits.Sdl3Cs.ToolTip"> - Liaisons SDL3 pour la prise en charge des manettes</sys:String>
    <sys:String x:Key="AboutPage.Credits.SharpCompress.Title">SharpCompress</sys:String>
    <sys:String x:Key="AboutPage.Credits.SharpCompress.ToolTip"> - Gestion des archives et de la compression</sys:String>
    <sys:String x:Key="AboutPage.Credits.SystemIOHashing.Title">System.IO.Hashing</sys:String>
    <sys:String x:Key="AboutPage.Credits.SystemIOHashing.ToolTip"> - Algorithmes de hachage rapides (XxHash)</sys:String>
    <sys:String x:Key="AboutPage.Credits.TweenAvalonia.Title">TweenAvalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.TweenAvalonia.ToolTip"> - Animations d'interpolation programmées pour Avalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.ZstdSharp.Title">ZstdSharp</sys:String>
    <sys:String x:Key="AboutPage.Credits.ZstdSharp.ToolTip"> - Compression Zstandard pour .NET</sys:String>
    <sys:String x:Key="AboutPage.FooterNote.Text">Cette application n'est en aucun cas affiliée, approuvée ou sponsorisée par Microsoft Corporation ou le projet Xenia. Toutes les marques commerciales, logos et noms de marque sont la propriété de leurs détenteurs respectifs.&#10;Xbox 360 est une marque déposée de Microsoft Corporation aux États-Unis et/ou dans d'autres pays.&#10;Xenia est une marque déposée du projet Xenia.&#10;Toute référence à ces marques ou à d'autres marques est faite uniquement dans le but d'identifier la compatibilité ou la fonctionnalité et n'implique aucune association ou approbation par les détenteurs desdites marques.&#10;Ce logiciel est destiné uniquement à des fins éducatives et d'information. Il ne contient ni ne distribue aucun contenu protégé par le droit d'auteur appartenant à Microsoft Corporation ou à un tiers. Les utilisateurs sont seuls responsables de s'assurer que leur utilisation de ce logiciel est conforme à toutes les lois applicables, y compris les lois sur le droit d'auteur et les licences.&#10;Toute utilisation de cette application pour exécuter des logiciels ou des micrologiciels propriétaires ou interagir avec eux doit être effectuée dans les limites des contrats de licence utilisateur final (CLUF) applicables. Les développeurs et distributeurs de cette application ne cautionnent ni ne soutiennent le piratage sous quelque forme que ce soit.&#10;Cette application est fournie "en l'état", sans garantie d'aucune sorte, expresse ou implicite. Utilisez-la à vos propres risques.</sys:String>
    <sys:String x:Key="AboutPage.UseExperimentalBuild.Title">Utiliser la version expérimentale</sys:String>
    <sys:String x:Key="AboutPage.UseExperimentalBuild.Description">Activer pour recevoir les mises à jour des fonctionnalités expérimentales et un accès anticipé aux nouveautés</sys:String>
    <sys:String x:Key="AboutPage.WebsiteButton.ToolTip">Ouvre le site web de Xenia Manager</sys:String>
    <sys:String x:Key="AboutPage.GithubButton.ToolTip">Ouvre le dépôt GitHub de Xenia Manager</sys:String>
    <sys:String x:Key="AboutPage.InfoBar.XeniaManagerUpdateAvailable.Message">Une nouvelle version de Xenia Manager est disponible.</sys:String>
    <sys:String x:Key="AboutPage.InfoBar.NoXeniaManagerUpdateAvailable.Message">Vous utilisez actuellement la dernière version de Xenia Manager.</sys:String>

    <!-- Library Page - Drag & Drop -->
    <sys:String x:Key="LibraryPage.DragDrop.Title">Déposez les fichiers pour ajouter des jeux</sys:String>
    <sys:String x:Key="LibraryPage.DragDrop.Subtitle">Les fichiers .iso, .xex, .zar sont pris en charge</sys:String>

    <!-- Multi-Disc Support -->
    <sys:String x:Key="GameButton.ContextFlyout.EditGame.ManageDiscs.Header">Gérer les disques</sys:String>
    <sys:String x:Key="GameButton.ContextFlyout.EditGame.ManageDiscs.ToolTip">Ajouter, renommer ou supprimer des disques pour les jeux multi-disques</sys:String>
    <sys:String x:Key="GameButton.ContextFlyout.ManageDiscs.Error.Title">Échec de la gestion des disques</sys:String>
    <sys:String x:Key="GameButton.ContextFlyout.ManageDiscs.Error.Message">Une erreur est survenue lors de la gestion des disques.&#10;{0}</sys:String>
    <sys:String x:Key="LibraryPage.GameButton.DiscCount">{0} disques</sys:String>
    <sys:String x:Key="LibraryPage.MultiDisc.MergePrompt.Title">Ajouter comme disque additionnel ?</sys:String>
    <sys:String x:Key="LibraryPage.MultiDisc.MergePrompt.Message">Ce fichier semble être un autre disque de '{0}', qui est déjà présent dans votre logithèque.&#10;&#10;Voulez-vous l'ajouter en tant que disque additionnel pour '{0}' au lieu de créer une entrée séparée ?</sys:String>

    <!-- Disc Selection Dialog (shown when launching a multi-disc game) -->
    <sys:String x:Key="DiscSelectionDialog.Header">Sélectionner un disque</sys:String>
    <sys:String x:Key="DiscSelectionDialog.SubHeader">Ce jeu contient plusieurs disques. Choisissez celui à lancer.</sys:String>
    <sys:String x:Key="DiscSelectionDialog.Disc1">Disque 1</sys:String>
    <sys:String x:Key="DiscSelectionDialog.DiscN">Disque {0}</sys:String>
    <sys:String x:Key="DiscSelectionDialog.LastPlayedSuffix">(Dernier joué)</sys:String>
    <sys:String x:Key="DiscSelectionDialog.MissingSuffix">(Fichier manquant)</sys:String>

    <!-- Manage Discs Dialog -->
    <sys:String x:Key="ManageDiscsDialog.Title">{0} - Gérer les disques</sys:String>
    <sys:String x:Key="ManageDiscsDialog.Subtitle">Ajoutez, renommez ou supprimez des disques. Le disque que vous lancez sera mémorisé pour la prochaine fois.</sys:String>
    <sys:String x:Key="ManageDiscsDialog.CloseButton">Fermer</sys:String>
    <sys:String x:Key="ManageDiscsDialog.Disc1Label">Disque 1</sys:String>
    <sys:String x:Key="ManageDiscsDialog.DiscNLabel">Disque {0}</sys:String>
    <sys:String x:Key="ManageDiscsDialog.AddDisc.Button">Ajouter un disque</sys:String>
    <sys:String x:Key="ManageDiscsDialog.RemoveDisc.ToolTip">Supprimer ce disque</sys:String>
    <sys:String x:Key="ManageDiscsDialog.MissingFile">Fichier introuvable</sys:String>
    <sys:String x:Key="ManageDiscsDialog.FilePicker.Title">Sélectionner le fichier du disque</sys:String>
    <sys:String x:Key="ManageDiscsDialog.MissingStorageProvider.Title">Stockage indisponible</sys:String>
    <sys:String x:Key="ManageDiscsDialog.MissingStorageProvider.Message">Le fournisseur de stockage est indisponible.</sys:String>
    <sys:String x:Key="ManageDiscsDialog.DuplicateDisc.Title">Disque déjà ajouté</sys:String>
    <sys:String x:Key="ManageDiscsDialog.DuplicateDisc.Message">Ce fichier est déjà associé à ce jeu.</sys:String>

    <!-- Game Files Dialog -->
