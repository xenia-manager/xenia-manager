    <!-- Settings Page -->
    <sys:String x:Key="SettingsPage.Ui.Title">Paramètres de l'interface</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Description">Personnaliser l'interface utilisateur de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Title">Langue</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Description">Changer la langue de l'interface utilisateur de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.ToolTip">REMARQUE : Certains éléments de l'interface resteront dans la langue d'origine jusqu'à la réouverture de l'application.</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Title">Thème</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Description">Changer le thème de l'interface utilisateur de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Light">Clair</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Amoled">AMOLED</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Dark">Sombre</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Steam">Steam</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.System">Système</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Title">Écran de chargement</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Description">Afficher un arrière-plan d'écran de chargement lors du lancement des jeux</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.ToolTip">Affiche une animation d'écran de chargement pendant le démarrage des jeux</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Title">Paramètres de débogage</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Description">Configurer le comportement et la verbosité des journaux</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Title">Niveau des journaux</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Description">Définir le niveau minimum d'enregistrement pour la sortie des journaux</sys:String>
    <sys:String x:Key="SettingsPage.General.Title">Paramètres généraux</sys:String>
    <sys:String x:Key="SettingsPage.General.Description">Configurer les options générales de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia">Analyser les détails du jeu avec Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.Description">Analyser automatiquement les détails du jeu à l'aide de l'émulateur Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.ToolTip">Activez cette option si vous rencontrez des difficultés pour détecter les jeux ou leurs détails</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle">Utiliser le MediaId pour le titre du jeu</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.Description">Utiliser le MediaId des fichiers de jeu pour trouver un titre de média correspondant</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.ToolTip">Désactivez cette option pour toujours utiliser le titre de la base de données au lieu des titres spécifiques au média</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork">Utiliser les illustrations intégrées</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.Description">Utiliser les illustrations intégrées aux fichiers de jeu (icônes, miniatures) avant de les télécharger depuis la base de données</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.ToolTip">Lorsqu'elle est activée, cette option extrait d'abord l'icône et les miniatures directement du fichier du jeu (STFS/SVOD/ISO/ZAR/XEX). Désactivez-la pour toujours télécharger les illustrations depuis la base de données.</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup">Vérifier les mises à jour au démarrage</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.Description">Vérifier automatiquement les mises à jour de Xenia et de Xenia Manager au lancement de l'application</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.ToolTip">Désactivez cette option pour ignorer la vérification des mises à jour lors du démarrage de l'application</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames">Détection automatique des nouveaux jeux</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.Description">Détecter automatiquement l'ajout de nouveaux jeux dans le dossier Games</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.ToolTip">Affiche une notification lorsque de nouveaux fichiers de jeu sont détectés dans le répertoire Games</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc">Fusion automatique des jeux multi-disques</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.Description">Fusionner automatiquement les disques détectés d'un même jeu lors de l'analyse de la bibliothèque</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.ToolTip">Lorsqu'elle est activée, les disques supplémentaires correspondant à un jeu déjà présent dans la bibliothèque sont fusionnés automatiquement sans demande de confirmation</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen">Démarrer en mode Big Screen</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.Description">Lancer le mode Big Screen au lieu de la fenêtre principale au démarrage</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.ToolTip">Lorsqu'elle est activée, Xenia Manager ouvre directement le mode Big Screen dès son lancement</sys:String>

