    <sys:String x:Key="LibraryPage.DeleteSelected.Success.Message">{0} jeu(x) ont été supprimés avec succès.</sys:String>
    <sys:String x:Key="LibraryPage.DeleteSelected.PartialSuccess.Title">Succès partiel</sys:String>
