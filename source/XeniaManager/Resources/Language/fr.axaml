    <sys:String x:Key="LibraryPage.Sort.Playtime">Temps de jeu</sys:String>
    <sys:String x:Key="LibraryPage.Sort.XeniaVersion">Version Xenia</sys:String>
    <sys:String x:Key="LibraryPage.Sort.LastPlayed">Dernièrement joué</sys:String>
