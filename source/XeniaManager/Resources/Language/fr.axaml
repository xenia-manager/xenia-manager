    <sys:String x:Key="LibraryPage.Options.EditListView.MediaId.Header">ID du média</sys:String>
    <sys:String x:Key="LibraryPage.Options.DoubleClickLaunch.Header">Lancer par double-clic</sys:String>
    <sys:String x:Key="LibraryPage.Options.DoubleClickLaunch.ToolTip">Basculez entre le simple et le double-clic pour lancer les jeux</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Header">Analyser les dossiers</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ToolTip">Analyse le dossier sélectionné pour trouver des jeux. Consultez le Wiki pour plus de détails sur le fonctionnement de cette fonctionnalité.</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.MissingStorageProvider.Title">Fournisseur de stockage manquant</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.MissingStorageProvider.Message">Le fournisseur de stockage n'est pas disponible. {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.NoXeniaInstalled.Title">Xenia n'est pas installé</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.NoXeniaInstalled.Message">Aucune version de Xenia n'est actuellement installée. Veuillez installer Xenia avant de continuer.</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.XeniaSelectionError.Title">Erreur de sélection de Xenia</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.XeniaSelectionError.Message">Échec de la sélection de la version de Xenia. {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.FolderPicker.Title">Sélectionner le dossier à analyser</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Success.Title">Analyse terminée</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Success.Message">{0} jeu(x) ont été ajoutés avec succès à votre bibliothèque.</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.NoGamesFound.Title">Analyse terminée</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.NoGamesFound.Message">Aucun nouveau jeu n'a été trouvé dans le dossier sélectionné. Le dossier ne contient peut-être pas de fichiers de jeu compatibles, ou les jeux sont déjà présents dans votre bibliothèque.</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Error.Title">Échec de l'analyse</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Error.Message">Une erreur est survenue lors de l'analyse du dossier : {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ScanError.Title">Erreur d'analyse</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ScanChoice.Title">Analyser les dossiers</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ScanChoice.Message">Sélectionnez la source de l'analyse :</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ScanChoice.GamesFolder">Analyser le dossier Games</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ScanChoice.CustomFolder">Analyser un dossier personnalisé</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.ScanChoice.Cancel">Annuler</sys:String>

    <!-- Folder Scan Progress Dialog -->
    <sys:String x:Key="FolderScanProgressDialog.Title">Analyse des jeux en cours</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Subtitle">Veuillez patienter pendant la recherche de fichiers de jeu</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Status.Starting">Démarrage de l'analyse...</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Status.Scanning">Analyse en cours : {0}</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Status.Complete">Analyse terminée ! {0} jeu(x) trouvé(s)</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Status.Cancelled">Analyse annulée</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Status.Initializing">Initialisation...</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Status.Error">Erreur : {0}</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Statistics.Folders">Dossiers</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Statistics.GamesFound">Jeux trouvés</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Button.Cancel">Annuler</sys:String>
    <sys:String x:Key="FolderScanProgressDialog.Button.Close">Fermer</sys:String>

    <!-- Add Games Progress Dialog -->
    <sys:String x:Key="AddGamesProgressDialog.Title">Ajout des jeux à la bibliothèque</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Subtitle">Traitement des fichiers de jeu découverts</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Statistics.Processed">Traités</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Statistics.Added">Ajoutés</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Statistics.Skipped">Ignorés</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Statistics.Failed">Échoués</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Button.Close">Fermer</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Status.Complete">Terminé ! {0} jeu(x) ajouté(s)</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Status.Initializing">Initialisation</sys:String>
    <sys:String x:Key="AddGamesProgressDialog.Status.Error">Erreur : {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.Header">Ajouter un jeu</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.ToolTip">Ajoute le fichier de jeu sélectionné à Xenia Manager</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.MissingStorageProvider.Title">Fournisseur de stockage manquant</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.MissingStorageProvider.Message">Le fournisseur de stockage n'est pas disponible. {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.MissingXenia.Title">Xenia manquant</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.MissingXenia.Message">Aucune version de Xenia n'est actuellement installée. Veuillez installer Xenia avant de continuer.</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.Failed.Title">Échec de l'ajout du jeu</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.Failed.Message">Une erreur est survenue lors de l'ajout de {0}. {1}</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.FailedDetection.Title">Échec de la détection du jeu</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.FailedDetection.Message">Impossible de détecter les détails du jeu pour {0}. Voulez-vous tout de même ajouter ce jeu avec des informations limitées ?</sys:String>
    <sys:String x:Key="LibraryPage.Options.AddGame.FilePicker.Title">Sélectionner le jeu à ajouter</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Progress.Processing">Traitement en cours : {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Progress.SkippingDuplicate">Copie ignorée : {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Progress.SkippingInvalid">Jeu non valide ignoré : {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ScanDirectory.Progress.Processed">Traités : {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Header">Exportation de masse</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.ToolTip">Exporter en masse tous les jeux de Xenia Manager vers le dossier désigné</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.MissingStorageProvider.Title">Fournisseur de stockage manquant</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.MissingStorageProvider.Message">Le fournisseur de stockage n'est pas disponible.</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.FolderPicker.Title">Sélectionner le dossier d'exportation</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Success.Title">Raccourcis exportés</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Success.Message">Exportation réussie de {0} raccourci(s) de jeu. Échecs : {1} Exportations réussies : {2} Exportations échouées : {3}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Error.Title">Échec de l'exportation</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Error.Message">Une erreur est survenue lors de l'exportation des raccourcis de jeu. {0}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.ChooseTarget.Title">Exporter les raccourcis de jeu</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.ChooseTarget.Message">Où souhaitez-vous exporter les raccourcis de jeu ?</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.ChooseTarget.Folder">Dossier</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.ChooseTarget.Steam">Steam</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.ChooseTarget.Cancel">Annuler</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.SteamSuccess.Title">Raccourcis Steam exportés</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.SteamSuccess.Message">Exportation réussie de {0} raccourci(s) Steam. Échecs : {1} Exportations réussies : {2} Exportations échouées : {3}</sys:String>
    <sys:String x:Key="LibraryPage.Options.UpdateCompatibilityRatings.Header">Mettre à jour les évaluations de compatibilité</sys:String>
    <sys:String x:Key="LibraryPage.Options.UpdateCompatibilityRatings.ToolTip">Met à jour les évaluations de compatibilité pour tous les jeux de la bibliothèque à partir de la base de données en ligne</sys:String>
    <sys:String x:Key="LibraryPage.Options.UpdateCompatibilityRatings.Success.Title">Mise à jour terminée</sys:String>
    <sys:String x:Key="LibraryPage.Options.UpdateCompatibilityRatings.Success.Message">Mise à jour réussie de {0} jeu(x). Inchangés : {1} Échecs : {2}</sys:String>
    <sys:String x:Key="LibraryPage.Options.UpdateCompatibilityRatings.Error.Title">Échec de la mise à jour</sys:String>
    <sys:String x:Key="LibraryPage.Options.UpdateCompatibilityRatings.Error.Message">Une erreur est survenue lors de la mise à jour des évaluations de compatibilité. {0}</sys:String>
    <sys:String x:Key="CompatibilityRatingSelectionDialog.Title">Mettre à jour les évaluations de compatibilité</sys:String>
    <sys:String x:Key="CompatibilityRatingSelectionDialog.GameCompatibility">Compatibilité du jeu</sys:String>
    <sys:String x:Key="CompatibilityRatingSelectionDialog.MousehookCompatibility">Compatibilité Mousehook</sys:String>
    <sys:String x:Key="CompatibilityRatingSelectionDialog.NetplayCompatibility">Compatibilité Netplay</sys:String>
    <sys:String x:Key="CompatibilityRatingSelectionDialog.UpdateButton">Mettre à jour</sys:String>
    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.Header">Optimiser les jeux</sys:String>
    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.ToolTip">Applique les paramètres optimisés de la base de données en ligne à tous les jeux de la bibliothèque</sys:String>
    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.Success.Title">Optimisation terminée</sys:String>
    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.Success.Message">Optimisation réussie de {0} jeu(x). Inchangés : {1} Non trouvés : {2} Échecs : {3} Jeux optimisés : {4} Jeux inchangés : {5} Jeux sans paramètres optimisés : {6} Échecs d'optimisation : {7}</sys:String>
    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.Error.Title">Échec de l'optimisation</sys:String>
    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.Error.Message">Une erreur est survenue lors de l'optimisation des paramètres de jeu. {0}</sys:String>

    <!-- Remove Invalid Games -->
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Header">Supprimer les jeux non valides</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.ToolTip">Supprime de la bibliothèque tous les jeux dont les chemins de fichiers sont manquants ou corrompus</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Confirmation.Title">Supprimer les jeux non valides</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Confirmation.SingleMessage">Il y a 1 jeu non valide dans votre bibliothèque. Voulez-vous le supprimer ?</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Confirmation.MultipleMessage">Il y a {0} jeux non valides dans votre bibliothèque. Voulez-vous les supprimer ?</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.NoneFound.Title">Aucun jeu non valide</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.NoneFound.Message">Il n'y a aucun jeu non valide dans votre bibliothèque.</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Success.Title">Jeux non valides supprimés</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Success.Message">{0} jeu(x) non valide(s) ont été supprimés avec succès de la bibliothèque.</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Error.Title">Échec de la suppression des jeux</sys:String>
    <sys:String x:Key="LibraryPage.Options.RemoveInvalidGames.Error.Message">Une erreur est survenue lors de la suppression des jeux non valides. {0}</sys:String>

