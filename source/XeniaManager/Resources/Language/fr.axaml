    <sys:String x:Key="LibraryPage.Options.EditGridView.XeniaVersion.ToolTip">Afficher l'icône de la version Xenia pour chaque jeu</sys:String>
    <sys:String x:Key="LibraryPage.Options.EditListView.Header">Modifier la vue en liste</sys:String>
    <sys:String x:Key="LibraryPage.Options.EditListView.ToolTip">Afficher/Masquer des colonnes dans la vue en liste</sys:String>
    <sys:String x:Key="LibraryPage.Options.EditListView.CompatibilityRating.Header">Évaluation de compatibilité</sys:String>
    <sys:String x:Key="LibraryPage.Options.EditListView.Playtime.Header">Temps de jeu</sys:String>
    <sys:String x:Key="LibraryPage.Options.EditListView.XeniaVersion.Header">Version Xenia</sys:String>
    <sys:String x:Key="LibraryPage.Options.EditListView.XeniaVersion.ToolTip">Afficher l'icône de la version Xenia pour chaque jeu</sys:String>
