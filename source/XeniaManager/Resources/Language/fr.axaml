    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Confirmation.Title">Réinitialiser les paramètres</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Confirmation.Message">Êtes-vous sûr de vouloir réinitialiser tous les paramètres par défaut ? Cette action est irréversible.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.ResetSettings.Success.Title">Paramètres réinitialisés</sys:String>
