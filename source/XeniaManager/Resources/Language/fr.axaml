    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.Title">Sauvegarde automatique des sauvegardes</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.Description">Sauvegarde automatiquement la partie pour le profil sélectionné</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.NoProfiles.Title">Aucun profil disponible</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.NoProfiles.Message">Aucun profil trouvé pour activer la sauvegarde automatique. Veuillez d'abord créer ou importer un profil.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Title">Dossier de contenu unifié</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Description">Permet à toutes les versions de Xenia de partager le même dossier de contenu. Nécessite les droits administrateur et un lecteur NTFS.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.ToolTip">REMARQUE : Nécessite des privilèges d'administrateur et un lecteur formaté en NTFS car cette fonctionnalité utilise des liens symboliques</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.AdminRequired.Title">Administrateur requis</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.AdminRequired.Message">Cette action nécessite que Xenia Manager soit exécuté en tant qu'administrateur. Veuillez redémarrer Xenia Manager avec les privilèges administratifs.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Title">Séparer les dossiers de contenu</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Message">Voulez-vous séparer les dossiers de contenu ? Chaque version de Xenia aura son propre répertoire de contenu indépendant.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Title">Unifier les dossiers de contenu</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Message">Voulez-vous unifier les dossiers de contenu ? Toutes les versions de Xenia partageront le même répertoire de contenu. Sélectionnez le contenu de la version à utiliser comme base.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Success.Title">Unification du dossier de contenu réussie</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Success.Message">Les dossiers de contenu ont été unifiés avec succès. Toutes les versions de Xenia partagent désormais le même répertoire de contenu.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Success.Title">Séparation du dossier de contenu réussie</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Success.Message">Les dossiers de contenu ont été séparés avec succès. Chaque version de Xenia a désormais son propre répertoire de contenu indépendant.</sys:String>
