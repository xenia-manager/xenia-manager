    <sys:String x:Key="XeniaSettingsPage.NoConfigFile.SubMessage">Veuillez vous assurer que l'émulateur est installé ou lancez un jeu pour générer les fichiers de configuration.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.LoadConfig.Error.Title">Erreur de chargement de la config</sys:String>
    <sys:String x:Key="XeniaSettingsPage.LoadConfig.Error.Message">Échec du chargement de la config '{0}' : {1}</sys:String>
