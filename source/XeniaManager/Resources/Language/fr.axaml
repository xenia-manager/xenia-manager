    <sys:String x:Key="LibraryPage.DeleteSelected.Button">Supprimer la sélection</sys:String>
    <sys:String x:Key="LibraryPage.DeleteSelected.OneGameSelected">1 jeu sélectionné</sys:String>
    <sys:String x:Key="LibraryPage.DeleteSelected.MultipleGamesSelected">{0} jeux sélectionnés</sys:String>
    <sys:String x:Key="LibraryPage.DeleteSelected.Confirmation.Title">Supprimer les jeux sélectionnés</sys:String>
