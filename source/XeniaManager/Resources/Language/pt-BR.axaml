    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Title">Pasta de conteúdo unificada</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Description">Faz com que todas as versões do Xenia compartilhem a mesma pasta de conteúdo. Requer privilégios de administrador e unidade NTFS.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.ToolTip">NOTA: Requer privilégios de administrador e uma unidade formatada em NTFS, pois este recurso utiliza links simbólicos</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.AdminRequired.Title">Administrador necessário</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.AdminRequired.Message">Esta ação requer que o Xenia Manager seja executado como Administrador.&#10;Reinicie o Xenia Manager com privilégios administrativos.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Title">Separar pastas de conteúdo</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Message">Deseja separar as pastas de conteúdo?&#10;Cada versão do Xenia terá seu próprio diretório de conteúdo independente.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Title">Unificar pastas de conteúdo</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Message">Deseja unificar as pastas de conteúdo?&#10;Todas as versões do Xenia compartilharão o mesmo diretório de conteúdo.&#10;&#10;Selecione qual versão terá seu conteúdo usado como base.</sys:String>
