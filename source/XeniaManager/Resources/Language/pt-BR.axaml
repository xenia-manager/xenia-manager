    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Success.Message">As pastas de conteúdo foram unificadas com sucesso.&#10;Todas as versões do Xenia agora compartilham o mesmo diretório de conteúdo.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Success.Title">Separação concluída com sucesso</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Success.Message">As pastas de conteúdo foram separadas com sucesso.&#10;Cada versão do Xenia agora possui sua própria pasta de conteúdo independente.</sys:String>
