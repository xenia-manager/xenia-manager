    <!-- Settings Page -->
    <sys:String x:Key="SettingsPage.Ui.Title">Configurações de interface</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Description">Personalizar a interface do Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Title">Idioma</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Description">Alterar o idioma da interface do Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.ToolTip">NOTA: Alguns elementos da interface permanecerão no idioma original até que o aplicativo seja reiniciado.</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Title">Tema</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Description">Alterar o tema visual da interface do Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Light">Claro</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Amoled">AMOLED</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Dark">Escuro</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Steam">Steam</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.System">Sistema</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Title">Tela de carregamento</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Description">Exibir tela de carregamento com imagem do jogo ao iniciá-lo</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.ToolTip">Exibe uma animação na tela de carregamento enquanto os jogos estão iniciando</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Title">Configurações de depuração</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Description">Configurar o comportamento e o nível de detalhamento dos logs</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Title">Nível de log</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Description">Define o nível mínimo para registro nos arquivos de log</sys:String>
    <sys:String x:Key="SettingsPage.General.Title">Configurações gerais</sys:String>
    <sys:String x:Key="SettingsPage.General.Description">Configurar opções gerais do Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia">Analisar detalhes do jogo com o Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.Description">Analisa automaticamente os detalhes do jogo usando o próprio emulador Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.ToolTip">Ative esta opção se estiver tendo problemas para detectar jogos ou seus detalhes</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle">Usar MediaId para o título do jogo</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.Description">Usa o MediaId dos arquivos do jogo para encontrar o título correspondente àquela versão da mídia</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.ToolTip">Desative para sempre usar o título geral do banco de dados em vez de títulos específicos de cada mídia</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork">Usar artes incorporadas</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.Description">Usa as artes incorporadas nos arquivos do jogo (ícones, miniaturas) antes de baixar do banco de dados</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.ToolTip">Quando ativado, o ícone e as miniaturas do jogo são primeiro extraídos do próprio arquivo (STFS/SVOD/ISO/ZAR/XEX). Desative para sempre baixar artes do banco de dados.</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup">Verificar atualizações na inicialização</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.Description">Verifica automaticamente se há atualizações do Xenia e do Xenia Manager ao abrir o aplicativo</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.ToolTip">Desative para ignorar a verificação de atualizações durante a inicialização do aplicativo</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames">Detectar novos jogos automaticamente</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.Description">Detecta automaticamente novos jogos adicionados à pasta Games</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.ToolTip">Exibe uma notificação quando novos arquivos de jogos forem detectados na pasta Games</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc">Mesclar jogos multidisco automaticamente</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.Description">Mescla automaticamente discos detectados do mesmo jogo durante o escaneamento da biblioteca</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.ToolTip">Quando ativado, discos adicionais correspondentes a um jogo existente na biblioteca são mesclados automaticamente sem confirmação</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen">Iniciar no modo Big Screen</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.Description">Abre o modo Big Screen em vez da janela principal ao inicializar</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.ToolTip">Quando ativado, o Xenia Manager abre diretamente no modo Big Screen ao ser iniciado</sys:String>

