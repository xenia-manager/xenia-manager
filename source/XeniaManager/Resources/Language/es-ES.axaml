    <sys:String x:Key="ManagePage.Content.RedownloadXenia.Title">Volver a descargar Xenia</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.Description">Vuelve a descargar y reinstalar la versión de Xenia seleccionada</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.Button">Volver a descargar</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.NoEmulator.Title">No hay ningún emulador instalado</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.NoEmulator.Message">Instala al menos una versión de Xenia antes de volver a descargarla.</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.Confirmation.Title">Confirmación de nueva descarga</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.Confirmation.Message">¿Quieres volver a descargar Xenia {0}?&#10;Se eliminará la instalación actual y se descargará una copia nueva.&#10;&#10;NOTA: NO se eliminará tu contenido, tus partidas guardadas ni tus archivos de configuración.</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadXenia.Success.Title">Nueva descarga completada</sys:String>
