    <sys:String x:Key="ManagePage.Content.ExportLogs.NoEmulator.Message">Instala al menos una versión de Xenia antes de exportar los registros.</sys:String>
    <sys:String x:Key="ManagePage.Content.ExportLogs.MissingStorageProvider.Title">Falta el proveedor de almacenamiento</sys:String>
    <sys:String x:Key="ManagePage.Content.ExportLogs.MissingStorageProvider.Message">El proveedor de almacenamiento no está disponible.</sys:String>
