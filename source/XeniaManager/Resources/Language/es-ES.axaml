    <!-- Settings Page -->
    <sys:String x:Key="SettingsPage.Ui.Title">Ajustes de la interfaz</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Description">Personaliza la interfaz de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Title">Idioma</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.Description">Cambia el idioma de la interfaz de usuario de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Language.ToolTip">NOTA: Parte de la interfaz seguirá en el idioma original hasta que se vuelva a abrir la aplicación.</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Title">Tema</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Description">Cambia el tema de la interfaz de usuario de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Light">Claro</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Amoled">AMOLED</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Dark">Oscuro</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.Steam">Steam</sys:String>
    <sys:String x:Key="SettingsPage.Ui.Theme.Option.System">Sistema</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Title">Pantalla de carga</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.Description">Mostrar el fondo de la pantalla de carga del juego al iniciarlo</sys:String>
    <sys:String x:Key="SettingsPage.Ui.LoadingScreen.ToolTip">Muestra una animación de pantalla de carga mientras se inician los juegos</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Title">Ajustes de depuración</sys:String>
    <sys:String x:Key="SettingsPage.Debug.Description">Configura el comportamiento y el nivel de detalle del registro</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Title">Nivel de registro</sys:String>
    <sys:String x:Key="SettingsPage.Debug.LogLevel.Description">Establece el nivel mínimo de registro para la salida de registros</sys:String>
    <sys:String x:Key="SettingsPage.General.Title">Ajustes generales</sys:String>
    <sys:String x:Key="SettingsPage.General.Description">Configura las opciones generales de Xenia Manager</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia">Analizar detalles del juego con Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.Description">Analiza automáticamente los detalles del juego usando el emulador Xenia</sys:String>
    <sys:String x:Key="SettingsPage.General.ParseGameDetailsWithXenia.ToolTip">Activa esta opción si tienes problemas para detectar juegos o sus detalles</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle">Usar MediaId para el título del juego</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.Description">Usa el MediaId de los archivos del juego para encontrar el título de una entrada de medio coincidente</sys:String>
    <sys:String x:Key="SettingsPage.General.UseMediaIdForTitle.ToolTip">Desactívalo para usar siempre el título de la base de datos en lugar de títulos específicos del medio</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork">Usar imágenes incrustadas</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.Description">Usa las imágenes incrustadas en los archivos del juego (icono, miniaturas) antes de descargarlas de la base de datos</sys:String>
    <sys:String x:Key="SettingsPage.General.UseEmbeddedArtwork.ToolTip">Si está activado, el icono y las miniaturas del juego se extraen primero del propio archivo del juego (STFS/SVOD/ISO/ZAR/XEX). Desactívalo para descargar siempre las imágenes de la base de datos.</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup">Buscar actualizaciones al iniciar</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.Description">Busca automáticamente actualizaciones de Xenia y de Xenia Manager al iniciar la aplicación</sys:String>
    <sys:String x:Key="SettingsPage.General.CheckForUpdatesOnStartup.ToolTip">Desactívalo para omitir la búsqueda de actualizaciones durante el inicio de la aplicación</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames">Detectar juegos nuevos automáticamente</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.Description">Detecta automáticamente cuándo se añaden juegos nuevos a la carpeta Games</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoDetectNewGames.ToolTip">Muestra una notificación cuando se detectan archivos de juego nuevos en el directorio Games</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc">Fusionar automáticamente juegos de varios discos</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.Description">Fusiona automáticamente los discos detectados del mismo juego durante el escaneo de la biblioteca</sys:String>
    <sys:String x:Key="SettingsPage.General.AutoMergeMultiDisc.ToolTip">Si está activado, los discos adicionales que coincidan con un juego existente de la biblioteca se fusionan automáticamente sin preguntar</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen">Iniciar en Big Screen</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.Description">Inicia Big Screen en lugar de la ventana principal al arrancar</sys:String>
    <sys:String x:Key="SettingsPage.General.StartInBigScreen.ToolTip">Si está activado, Xenia Manager abre directamente el modo Big Screen al iniciarse</sys:String>

