    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.NoInputDetected.Title">No se ha detectado ninguna entrada</sys:String>
    <sys:String x:Key="MousehookControlsEditorDialog.DetectInput.NoInputDetected.Message">No se ha detectado ninguna entrada de teclado o ratón en 10 segundos.</sys:String>
