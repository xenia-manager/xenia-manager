    <sys:String x:Key="ManagePage.Content.UpdateSDLDatabase.Title">Actualizar base de datos de SDL</sys:String>
    <sys:String x:Key="ManagePage.Content.UpdateSDLDatabase.Description">Descarga un gamecontrollerdb.txt nuevo para todas las versiones de Xenia</sys:String>
