    <!-- Config UI Settings - APU Options -->
    <sys:String x:Key="ConfigUiSettings.APU.apu.Title">Sistema de audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.Comment">Sistema de audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.any">Cualquiera</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.nop">Nop</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.sdl">SDL</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu.option.xaudio2">XAudio2</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu_max_queued_frames.Title">Máx. de fotogramas de audio en cola</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.apu_max_queued_frames.Comment">Permite cambiar el máximo de fotogramas de audio en búfer para reducir el retardo del audio&#10;Reducir este valor puede causar problemas de rendimiento</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.mute.Title">Silenciar audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.mute.Comment">Silencia toda la salida de audio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.enable_xmp.Title">XMP</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.enable_xmp.Comment">Activa la reproducción del reproductor de música&#10;Esto puede arreglar la música en algunos juegos</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xmp_default_volume.Title">Volumen predeterminado de XMP</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xmp_default_volume.Comment">Volumen de música predeterminado si el juego no lo establece</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_dedicated_xma_thread.Title">Hilo XMA dedicado</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_dedicated_xma_thread.Comment">Activa la decodificación XMA en un hilo independiente&#10;Con esta opción desactivada, se esperan mejores resultados, pero menor rendimiento</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_new_decoder.Title">Decodificador de audio XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_new_decoder.Comment">Activa el uso del nuevo decodificador de audio XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.Title">Decodificador XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.Comment">fake: No se decodificará audio&#10;master: Versión del decodificador idéntica a la de la versión base de Xenia&#10;old: Decodificador basado en la versión master con algunas mejoras&#10;new: Nueva versión del decodificador. Ofrece la mayor estabilidad, pero aún no está terminada</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.fake">Fake</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.master">Master</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.old">Old</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.new">New</sys:String>

    <!-- Config UI Settings - Content Options -->
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.Title">Máscara de licencia</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.Comment">- Sin licencia: modo demo&#10;- Primera licencia: generalmente la licencia de la versión completa en los títulos de Xbox Live Arcade&#10;- Todas las licencias: se activan todas las licencias posibles, pero podría provocar comportamientos indefinidos</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.0">Sin licencias</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.1">Primera licencia</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.-1">Todas las licencias</sys:String>

    <!-- Config UI Settings - CPU Options -->
    <sys:String x:Key="ConfigUiSettings.CPU.break_on_unimplemented_instructions.Title">Interrumpir en instrucciones no implementadas</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.break_on_unimplemented_instructions.Comment">Interrumpe en el depurador del host (o se cierra de forma abrupta si no hay ningún depurador conectado) si se encuentra una instrucción PowerPC no implementada</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disable_context_promotion.Title">Desactivar promoción de contexto</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disable_context_promotion.Comment">Desactiva las optimizaciones de promoción de contexto&#10;Puede ser necesario en algunos juegos deportivos, pero reducirá el rendimiento</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disassemble_functions.Title">Desensamblar funciones</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disassemble_functions.Comment">Desensambla las funciones durante la generación</sys:String>

    <!-- Config UI Settings - D3D12 Options -->
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_allow_variable_refresh_rate_and_tearing.Title">Permitir frecuencia de actualización variable y tearing</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_allow_variable_refresh_rate_and_tearing.Comment">En pantalla completa, permite usar la frecuencia de actualización variable en las pantallas que la admitan&#10;En pantallas que no admitan VRR, puede producirse tearing en ciertos casos</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.Title">Prioridad de la cola</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.Comment">Prioridad de planificación de la cola de comandos gráficos (directa)&#10;0 - Normal&#10;1 - Alta&#10;2 - Tiempo real global, que requiere privilegios de administrador y puede afectar a la respuesta del sistema</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.0">Normal</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.1">Alta</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.2">Tiempo real global</sys:String>

    <!-- Config UI Settings - Display Options -->
    <sys:String x:Key="ConfigUiSettings.Display.fullscreen.Title">Pantalla completa</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.fullscreen.Comment">Indica si el emulador se inicia en pantalla completa</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.present_letterbox.Title">Presentar con bandas (letterbox)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.present_letterbox.Comment">Mantiene la relación de aspecto al estirar mostrando bandas alrededor de la imagen cuando ya no queda más área de overscan que recortar</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.Title">Antialiasing</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.Comment">Efecto de antialiasing de posprocesado que se aplica a la imagen de salida del juego</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.none">Ninguno</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.fxaa">FXAA</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.fxaa_extreme">FXAA extremo</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.Title">Escalado y nitidez</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.Comment">Efecto de posprocesado que se usa para el remuestreo y/o el aumento de nitidez de la salida final de pantalla</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.bilinear">Bilineal</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.cas">CAS</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.fsr">FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_sharpness_reduction.Title">Reducción de nitidez de FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_sharpness_reduction.Comment">Reducción de nitidez de AMD FidelityFX Super Resolution 1.0 (FSR), en pasos&#10;Un valor más bajo es más nítido</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_cas_additional_sharpness.Title">Nitidez adicional de CAS</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_cas_additional_sharpness.Comment">Nitidez adicional de AMD FidelityFX Contrast Adaptive Sharpening (CAS), de 0 a 1&#10;Un valor más alto es más nítido</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_max_upsampling_passes.Title">Máx. de pasadas de sobremuestreo de FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_max_upsampling_passes.Comment">Número máximo de pasadas de sobremuestreo que se realizan en AMD FidelityFX Super Resolution 1.0 (FSR) antes de recurrir al estiramiento bilineal tras la última pasada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_dither.Title">Dithering</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_dither.Comment">Aplica dithering a la imagen final de salida desde la precisión interna a 8 bits por canal para que los degradados sean más suaves</sys:String>

    <!-- Config UI Settings - General Options -->
    <sys:String x:Key="ConfigUiSettings.General.allow_plugins.Title">Permitir plugins</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.allow_plugins.Comment">Permite cargar plugins/trainers desde plugins\\title_id\\plugin.xex&#10;Los plugins son módulos xex homebrew que se pueden usar para crear mods&#10;Esta función es experimental</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.discord.Title">Discord Rich Presence</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.discord.Comment">Activa Discord Rich Presence</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.apply_patches.Title">Aplicar parches</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.apply_patches.Comment">Activa la funcionalidad de parches personalizados</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.controller_hotkeys.Title">Atajos del mando</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.controller_hotkeys.Comment">Atajos para mandos de Xbox y PS</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.launch_module.Title">Módulo de inicio</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.launch_module.Comment">Ejecutable que se inicia desde el .iso o el paquete en lugar de default.xex o del módulo especificado por el juego&#10;Déjalo en blanco para iniciar el módulo predeterminado</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.notification_sound_path.Title">Ruta del sonido de notificación</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.notification_sound_path.Comment">Ruta (incluido el nombre del archivo) del sonido de notificación seleccionado&#10;NOTA: ¡El sonido DEBE estar en formato wav!</sys:String>

    <!-- Config UI Settings - GPU Options -->
    <sys:String x:Key="ConfigUiSettings.GPU.vsync.Title">VSync</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.vsync.Comment">Activa VSYNC</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.framerate_limit.Title">Límite de fotogramas por segundo</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.framerate_limit.Comment">Máximo de fotogramas por segundo&#10;0 = fotogramas ilimitados&#10;Por defecto es 60 cuando se establece en 0 y VSYNC está activado</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.Title">Sistema gráfico</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.Comment">Sistema gráfico que se utilizará</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.any">Cualquiera</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.d3d12">D3D12</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.vulkan">Vulkan</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.null">Nulo</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.Title">Ruta de render target (D3D12)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.Comment">Ruta de emulación de render target que se usará en Direct3D 12&#10;RTV - Render targets del host&#10;ROV - Vistas ordenadas por el rasterizador</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.any">Automática</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.rtv">RTV</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.rov">ROV</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.Title">Ruta de render target (Vulkan)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.Comment">Ruta de emulación de render target que se usará en Vulkan&#10;FBO - Framebuffers del host&#10;FSI - Fragment shader interlock</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.any">Automática</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.fbo">FBO</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.fsi">FSI</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.Title">Lectura de vuelta de resolve</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.Comment">Controla la lectura de vuelta en la CPU de los resultados del resolve de renderizado a textura&#10;None - desactiva la lectura de vuelta&#10;Fast - 1 fotograma de retardo&#10;Full - preciso pero lento</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.none">Ninguna</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.fast">Rápida</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.full">Completa</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_memexport.Title">Lectura de vuelta de memexport</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_memexport.Comment">Lee en la CPU los datos escritos por la exportación de memoria en los shaders.&#10;Puede ser necesario para algunos juegos, pero provoca sincronización a mitad de fotograma con un enorme impacto en el rendimiento</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_x.Title">Escala de resolución de dibujado X</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_x.Comment">Escala entera del ancho en píxeles que se usa para escalar la resolución de renderizado de forma opaca para el juego</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_y.Title">Escala de resolución de dibujado Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_y.Comment">Escala entera del alto en píxeles que se usa para escalar la resolución de renderizado de forma opaca para el juego</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu_allow_invalid_fetch_constants.Title">Permitir fetch constants no válidas</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu_allow_invalid_fetch_constants.Comment">Permite fetch constants de textura y de vértices con tipo no válido&#10;Por lo general no es seguro, pero puede servir para evitar errores de tipo de fetch constant en ciertos juegos</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gamma_render_target_as_srgb.Title">Render target gamma como sRGB</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gamma_render_target_as_srgb.Comment">Cuando el host no puede escribir gamma lineal por tramos directamente con una mezcla correcta, usa salida sRGB en el host para una mezcla conceptualmente correcta en el espacio de color lineal</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_lower_threshold.Title">Umbral inferior de consulta de oclusión</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_lower_threshold.Comment">Si se establece en -1, no se escriben recuentos de muestras y los juegos pueden bloquearse&#10;En caso contrario, el recuento de muestras de cada tile se incrementará en este número en cada EVENT_WRITE_ZPD</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_upper_threshold.Title">Umbral superior de consulta de oclusión</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_upper_threshold.Comment">Establécelo en un número mayor que query_occlusion_sample_lower_threshold&#10;Este valor se ignora si query_occlusion_sample_lower_threshold está establecido en -1</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.use_fuzzy_alpha_epsilon.Title">Usar épsilon alfa difuso</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.use_fuzzy_alpha_epsilon.Comment">Usa una comparación aproximada para los valores alfa para evitar parpadeos en tarjetas gráficas NVIDIA</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.clear_memory_page_state.Title">Borrar estado de páginas de memoria</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.clear_memory_page_state.Comment">Actualiza el estado de las páginas de memoria para habilitar los datos escritos por la GPU</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.Title">Forzar filtrado anisotrópico</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.Comment">Fuerza el filtrado anisotrópico (AF) en las texturas aptas&#10;Los valores más altos mantienen las texturas más nítidas en ángulos oblicuos a costa de ancho de banda de la GPU&#10;En casos raros, forzar el AF puede introducir artefactos visuales</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.-1">Sin forzar (predeterminado)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.0">Desactivar filtrado anisotrópico</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.1">1x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.2">2x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.3">4x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.4">8x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.5">16x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.async_shader_compilation.Title">Compilación asíncrona de shaders</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.async_shader_compilation.Comment">Compila shaders y crea pipelines de forma asíncrona en hilos en segundo plano&#10;Elimina los tirones por compilación de shaders, pero puede causar artefactos de renderizado breves mientras se crean los pipelines&#10;Si está desactivado, los pipelines se crean de forma síncrona, lo que causa tirones pero no artefactos visuales</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.Title">Consulta de oclusión</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.Comment">Controla el comportamiento de la consulta de oclusión por hardware para EVENT_WRITE_ZPD&#10;Se usa para efectos como destellos de lente, descarte de objetos y autoexposición&#10;fake: Escribe un resultado falso sin consultar a la GPU. Seguro para la mayoría de los juegos&#10;fast: Consulta a la GPU pero no espera. Escribe el resultado en caché y lo actualiza cuando la GPU se pone al día. (Predeterminado)&#10;fast-alt: Como fast, pero mantiene los resultados cero en caché para los informes sin resolver&#10;strict: Consulta a la GPU y espera el resultado real. Es lo más preciso, pero menos eficiente</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fake">Fake</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fast">Fast (predeterminado)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fast-alt">Fast-Alt</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.strict">Strict</sys:String>

    <!-- Config UI Settings - HID Options -->
    <sys:String x:Key="ConfigUiSettings.HID.hid.Title">Sistema de entrada</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.Comment">Sistema de entrada que se utilizará</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.any">Cualquiera</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.nop">Nop</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.sdl">SDL</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.winkey">WinKey</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.xinput">XInput</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.Title">Modo de teclado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.Comment">Permite al usuario especificar el modo de funcionamiento del teclado:&#10;0 - Desactivado&#10;1 - Activado&#10;2 - Passthrough, que requiere tener un mando conectado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.0">Desactivado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.1">Activado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.2">Passthrough</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_user_index.Title">Índice de usuario del teclado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_user_index.Comment">Puerto de mando que emula el teclado (0-3)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.left_stick_deadzone_percentage.Title">Zona muerta del stick izquierdo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.left_stick_deadzone_percentage.Comment">Define el nivel de zona muerta del stick izquierdo (0-100 %)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.right_stick_deadzone_percentage.Title">Zona muerta del stick derecho</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.right_stick_deadzone_percentage.Comment">Define el nivel de zona muerta del stick derecho (0-100 %)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.vibration.Title">Vibración</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.vibration.Comment">Activa o desactiva la vibración del mando</sys:String>

    <!-- Config UI Settings - HID.WinKey Options -->
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_a.Title">Botón A</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_a.Comment">Lista de teclas que asignar a A, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_b.Title">Botón B</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_b.Comment">Lista de teclas que asignar a B, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_back.Title">Botón BACK</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_back.Comment">Lista de teclas que asignar a BACK, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_down.Title">Cruceta abajo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_down.Comment">Lista de teclas que asignar a DPAD_DOWN, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "^S" significa Shift+S</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_left.Title">Cruceta izquierda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_left.Comment">Lista de teclas que asignar a DPAD_LEFT, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "^A" significa Shift+A</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_right.Title">Cruceta derecha</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_right.Comment">Lista de teclas que asignar a DPAD_RIGHT, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "^D" significa Shift+D</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_up.Title">Cruceta arriba</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_up.Comment">Lista de teclas que asignar a DPAD_UP, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "^W" significa Shift+W</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_guide.Title">Botón Guide</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_guide.Comment">Lista de teclas que asignar a GUIDE, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "0x08" es Retroceso</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_shoulder.Title">Botón superior izquierdo (LB)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_shoulder.Comment">Lista de teclas que asignar a LEFT_SHOULDER, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb.Title">Pulsación del stick izquierdo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb.Comment">Lista de teclas que asignar a LEFT_THUMB_PRESSED, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_down.Title">Stick izquierdo abajo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_down.Comment">Lista de teclas que asignar a LEFT_THUMB_DOWN, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "_S" significa S sin Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_left.Title">Stick izquierdo a la izquierda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_left.Comment">Lista de teclas que asignar a LEFT_THUMB_LEFT, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "_A" significa A sin Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_right.Title">Stick izquierdo a la derecha</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_right.Comment">Lista de teclas que asignar a LEFT_THUMB_RIGHT, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "_D" significa D sin Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_up.Title">Stick izquierdo arriba</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_up.Comment">Lista de teclas que asignar a LEFT_THUMB_UP, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "_W" significa W sin Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_trigger.Title">Gatillo izquierdo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_trigger.Comment">Lista de teclas que asignar a LEFT_TRIGGER, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I al mismo gatillo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_shoulder.Title">Botón superior derecho (RB)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_shoulder.Comment">Lista de teclas que asignar a RIGHT_SHOULDER, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb.Title">Pulsación del stick derecho</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb.Comment">Lista de teclas que asignar a RIGHT_THUMB_PRESSED, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_down.Title">Stick derecho abajo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_down.Comment">Lista de teclas que asignar a RIGHT_THUMB_DOWN, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "0x28" es la flecha abajo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_left.Title">Stick derecho a la izquierda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_left.Comment">Lista de teclas que asignar a RIGHT_THUMB_LEFT, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "0x25" es la flecha izquierda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_right.Title">Stick derecho a la derecha</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_right.Comment">Lista de teclas que asignar a RIGHT_THUMB_RIGHT, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "0x27" es la flecha derecha</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_up.Title">Stick derecho arriba</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_up.Comment">Lista de teclas que asignar a RIGHT_THUMB_UP, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "0x26" es la flecha arriba</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_trigger.Title">Gatillo derecho</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_trigger.Comment">Lista de teclas que asignar a RIGHT_TRIGGER, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "E O" asigna tanto E como O al mismo gatillo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_start.Title">Botón START</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_start.Comment">Lista de teclas que asignar a START, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_x.Title">Botón X</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_x.Comment">Lista de teclas que asignar a X, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_y.Title">Botón Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_y.Comment">Lista de teclas que asignar a Y, separadas por espacios. Formato: código de tecla virtual (0x26), carácter único (A-Z, 0-9), con modificadores (^ requiere Shift, _ no requiere Shift). Ejemplo: "Q I" asigna tanto Q como I</sys:String>

    <!-- Config UI Settings - Kernel Options -->
    <sys:String x:Key="ConfigUiSettings.Kernel.apply_title_update.Title">Aplicar actualización de título</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.apply_title_update.Comment">Aplica las actualizaciones de título</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.cl.Title">Línea de comandos</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.cl.Comment">Especifica una línea de comandos adicional que se proporciona al invitado</sys:String>

    <!-- Config UI Settings - Logging Options -->
    <sys:String x:Key="ConfigUiSettings.Logging.enable_console.Title">Activar consola</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.enable_console.Comment">Abre una ventana de consola junto con la ventana principal</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.Title">Nivel de registro</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.Comment">Nivel máximo que se registrará</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.0">Error</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.1">Advertencia</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.2">Información</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.3">Depuración</sys:String>

    <!-- Config UI Settings - Memory Options -->
    <sys:String x:Key="ConfigUiSettings.Memory.protect_zero.Title">Proteger página cero</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.protect_zero.Comment">Protege la página cero frente a lecturas y escrituras</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.scribble_heap.Title">Rellenar el heap (scribble)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.scribble_heap.Comment">Escribe un valor específico o aleatorio en toda la memoria de heap asignada</sys:String>

    <!-- Config UI Settings - Storage Options -->
    <sys:String x:Key="ConfigUiSettings.Storage.mount_cache.Title">Montar caché</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_cache.Comment">Activa el montaje de la caché</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_scratch.Title">Montar scratch</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_scratch.Comment">Activa el montaje de scratch</sys:String>

    <!-- Config UI Settings - UI Options -->
    <sys:String x:Key="ConfigUiSettings.UI.show_achievement_notification.Title">Mostrar notificación de logros</sys:String>
    <sys:String x:Key="ConfigUiSettings.UI.show_achievement_notification.Comment">Muestra en pantalla la notificación de logros</sys:String>

    <!-- Config UI Settings - Video Options -->
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.Title">Resolución de pantalla interna</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.Comment">Permite que los juegos que admiten distintas resoluciones rendericen en una resolución concreta</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.0">640x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.1">640x576</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.2">720x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.3">720x576</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.4">800x600</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.5">848x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.6">1024x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.7">1152x864</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.8">1280x720</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.9">1280x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.10">1280x960</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.11">1280x1024</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.12">1360x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.13">1440x900</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.14">1680x1050</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.15">1920x540</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.16">1920x1080</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.17">Personalizada (X/Y)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Title">Ancho de resolución personalizada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Comment">Ancho personalizado para la resolución de pantalla interna&#10;NOTA: Requiere que la resolución de pantalla interna esté establecida en 'Personalizada (X/Y)' para que surta efecto</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Title">Alto de resolución personalizada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Comment">Alto personalizado para la resolución de pantalla interna&#10;NOTA: Requiere que la resolución de pantalla interna esté establecida en 'Personalizada (X/Y)' para que surta efecto</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.widescreen.Title">Pantalla panorámica</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.widescreen.Comment">Alterna entre relación de aspecto 16:9 y 4:3</sys:String>

    <!-- Config UI Settings - Vulkan Options -->
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_immediate.Title">Permitir modo de presentación inmediato</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_immediate.Comment">Cuando esté disponible, permite el modo de presentación inmediato (1.ª prioridad), que ofrece la menor latencia con posibilidad de tearing en ciertos casos</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_mailbox.Title">Permitir modo de presentación mailbox</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_mailbox.Comment">Cuando esté disponible, permite el modo de presentación mailbox (2.ª prioridad), que ofrece baja latencia sin posibilidad de tearing</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_fifo_relaxed.Title">Permitir modo de presentación FIFO relajado</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_fifo_relaxed.Comment">Cuando esté disponible, permite el modo de presentación primero en entrar, primero en salir relajado (3.ª prioridad), que espera a la sincronización vertical de la pantalla del host, pero puede presentar con tearing si los fotogramas no alcanzan la frecuencia de actualización de la pantalla</sys:String>

    <!-- Config UI Settings - Live/Netplay Options -->
    <sys:String x:Key="ConfigUiSettings.Live.api_address.Title">Dirección de la API</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.api_address.Comment">Dirección del servidor de Xenia (p. ej., IP:PUERTO)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.discord_presence_user_index.Title">Índice de usuario de Discord Rich Presence</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.discord_presence_user_index.Comment">Índice del perfil de usuario que se usa para Discord Rich Presence [0-3]</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.Title">Modo de red</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.Comment">Modo de red&#10;0 - Sin conexión&#10;1 - Systemlink&#10;2 - Xbox Live</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.0">Sin conexión</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.1">Systemlink</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.2">Xbox Live</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.upnp.Title">UPnP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.upnp.Comment">Redirige puertos automáticamente mediante UPnP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xhttp.Title">XHTTP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xhttp.Comment">Activa o desactiva XHTTP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xlink_kai_systemlink_hack.Title">Hack de SystemLink para XLink Kai</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xlink_kai_systemlink_hack.Comment">Activa los hacks para la compatibilidad con XLink Kai&#10;Puede romper algunos juegos</sys:String>

    <!-- Config UI Settings - MouseHook Options -->
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_autoaim.Title">Desactivar autoapuntado</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_autoaim.Comment">Desactiva el autoapuntado en los juegos que lo admiten (GoldenEye, Perfect Dark, Saints Row, COD)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_fullscreen_esc_bind.Title">Desactivar tecla ESC en pantalla completa</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_fullscreen_esc_bind.Comment">Desactiva que la tecla Escape salga de la pantalla completa cuando se está en ella</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.fov_sensitivity.Title">Sensibilidad según el FOV</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.fov_sensitivity.Comment">Escala del ratón cuando se reduce el FOV (COD, DR, RDR y juegos con UE3)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_aim_turn_distance.Title">(GoldenEye/Perfect Dark)&#10;Distancia de giro al apuntar</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_aim_turn_distance.Comment">(GoldenEye/Perfect Dark) Distancia que puede moverse la mirilla en modo de apuntado antes de girar la cámara</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_debug_menu.Title">(GoldenEye)&#10;Menú de depuración</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_debug_menu.Comment">(GoldenEye) Activa el menú de depuración, accesible con LB/1</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_gun_sway.Title">(GoldenEye/Perfect Dark)&#10;Balanceo del arma</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_gun_sway.Comment">(GoldenEye/Perfect Dark) Activa el balanceo del arma al girar la cámara</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_remove_blur.Title">(GoldenEye)&#10;Quitar desenfoque</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_remove_blur.Comment">(GoldenEye) Elimina el desenfoque de baja resolución en el modo de gráficos clásicos</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.internal_hook.Title">Hook interno</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.internal_hook.Comment">Usa una técnica de hooking mejor para obtener mejores resultados de inyección del ratón (Saints Row 1)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_x.Title">Invertir eje X</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_x.Comment">Invierte el eje X del ratón</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_y.Title">Invertir eje Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_y.Comment">Invierte el eje Y del ratón</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.menu_sensitivity.Title">(GoldenEye/Saints Row 1)&#10;Sensibilidad en menús</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.menu_sensitivity.Comment">(GoldenEye/Saints Row 1) Sensibilidad del ratón en los menús</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_snappy_wheel.Title">(Red Dead Redemption)&#10;Rueda con saltos</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_snappy_wheel.Comment">(Red Dead Redemption) Ajusta la rueda de armas en incrementos de 45 grados</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_turbo_gallop_horse.Title">(Red Dead Redemption)&#10;Galope turbo</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_turbo_gallop_horse.Comment">(Red Dead Redemption) Activa el galope turbo para caballos y carruajes</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sensitivity.Title">Sensibilidad del ratón</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sensitivity.Comment">Sensibilidad del ratón</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.source_sniper_sensitivity.Title">Sensibilidad de francotirador en Source</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.source_sniper_sensitivity.Comment">Sensibilidad de la mira de francotirador del motor Source</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr1_increase_vehicle_rotation_limit.Title">(Saints Row 1)&#10;Límite de rotación de vehículos</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr1_increase_vehicle_rotation_limit.Comment">(Saints Row 1) Parchea el límite de rotación vertical de los vehículos para que sea prácticamente igual que a pie</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_better_handbrake_cam.Title">(Saints Row 2)&#10;Mejor cámara con freno de mano</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_better_handbrake_cam.Comment">(Saints Row 2) Desvincula la rotación X de los vehículos al usar el freno de mano, de forma similar a SR1</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_hold_fine_aim.Title">(Saints Row 2)&#10;Mantener puntería precisa</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_hold_fine_aim.Comment">(Saints Row 2) Cambia la puntería precisa (ADS) de alternar a mantener pulsado</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_better_drive_cam.Title">(Saints Row 1 y 2)&#10;Mejor cámara de conducción</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_better_drive_cam.Comment">(Saints Row 1 y 2) Desvincula la rotación X de los vehículos cuando el autocentrado está desactivado</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_disable_shared_reload.Title">(Saints Row 1)&#10;Desactivar recarga compartida</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_disable_shared_reload.Comment">(Saints Row 1) Desactiva la recarga de armas al pulsar el botón interno (A)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.swap_wheel.Title">(Saints Row 1)&#10;Intercambiar rueda</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.swap_wheel.Comment">Intercambia las asignaciones de la rueda de armas y de la dirección del zoom del mapa en Saints Row 1</sys:String>

    <!-- About Page -->
    <sys:String x:Key="AboutPage.App.Description">Una completa herramienta de gestión para el emulador Xenia. Instala, actualiza y gestiona fácilmente distintas versiones del emulador Xenia con una interfaz intuitiva.</sys:String>
    <sys:String x:Key="AboutPage.WebsiteButton.Text">Sitio web</sys:String>
    <sys:String x:Key="AboutPage.GithubButton.Text">GitHub</sys:String>
    <sys:String x:Key="AboutPage.CheckForUpdatesButton.Text">Buscar actualizaciones</sys:String>
    <sys:String x:Key="AboutPage.UpdateXeniaManagerButton.Text">Actualizar Xenia Manager</sys:String>
    <sys:String x:Key="AboutPage.CheckForUpdatesFailed.Title">Error al buscar actualizaciones</sys:String>
    <sys:String x:Key="AboutPage.CheckForUpdatesFailed.Message">Se ha producido un error al buscar actualizaciones:&#10;{0}</sys:String>
    <sys:String x:Key="AboutPage.UpdateFailed.Title">Error al actualizar</sys:String>
    <sys:String x:Key="AboutPage.UpdateFailed.Message">Se ha producido un error al actualizar Xenia Manager:&#10;{0}</sys:String>
    <sys:String x:Key="AboutPage.UpdateFailed.NoReleaseInfo">No se ha podido obtener la información de la versión. Inténtalo de nuevo más tarde.</sys:String>
    <sys:String x:Key="AboutPage.DownloadingUpdate">Descargando actualización</sys:String>
    <sys:String x:Key="AboutPage.ExtractingUpdate">Extrayendo actualización</sys:String>
    <sys:String x:Key="AboutPage.LicenseCredits.Text">Licencia y créditos</sys:String>
    <sys:String x:Key="AboutPage.LicenseCredits.SideText">Información legal y agradecimientos</sys:String>
    <sys:String x:Key="AboutPage.License.Text">Este software se distribuye bajo la licencia BSD-3-Clause.</sys:String>
    <sys:String x:Key="AboutPage.Xbox360Emulation.Header">Emulación de Xbox 360</sys:String>
    <sys:String x:Key="AboutPage.Libraries.Header">Bibliotecas</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaProject.Title">Xenia Project</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaProject.ToolTip"> - Emulador original de Xbox 360</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaCanary.Title">Xenia Canary</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaCanary.ToolTip"> - Compilación experimental con las últimas funciones</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaNetplay.Title">Xenia Netplay</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaNetplay.ToolTip"> - Compatibilidad con juego multijugador</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaMousehook.Title">Xenia Mousehook</sys:String>
    <sys:String x:Key="AboutPage.Credits.XeniaMousehook.ToolTip"> - Compatibilidad con teclado y ratón</sys:String>
    <sys:String x:Key="AboutPage.Credits.AvaloniaUi.Title">Avalonia UI</sys:String>
    <sys:String x:Key="AboutPage.Credits.AvaloniaUi.ToolTip"> - Framework de interfaz multiplataforma con Fluent Design</sys:String>
    <sys:String x:Key="AboutPage.Credits.CommunityToolkitMvvm.Title">CommunityToolkit.Mvvm</sys:String>
    <sys:String x:Key="AboutPage.Credits.CommunityToolkitMvvm.ToolTip"> - Framework MVVM para .NET</sys:String>
    <sys:String x:Key="AboutPage.Credits.DependencyInjection.Title">Microsoft.Extensions.DependencyInjection</sys:String>
    <sys:String x:Key="AboutPage.Credits.DependencyInjection.ToolTip"> - Contenedor de inyección de dependencias para .NET</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentAvalonia.Title">FluentAvalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentAvalonia.ToolTip"> - Controles y temas de Fluent Design para Avalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentIcons.Title">FluentIcons</sys:String>
    <sys:String x:Key="AboutPage.Credits.FluentIcons.ToolTip"> - Framework para usar los iconos de símbolos Fluent</sys:String>
    <sys:String x:Key="AboutPage.Credits.NLog.Title">NLog</sys:String>
    <sys:String x:Key="AboutPage.Credits.NLog.ToolTip"> - Framework de registro flexible para .NET</sys:String>
    <sys:String x:Key="AboutPage.Credits.Xbox360Toolkit.Title">Xbox 360 Toolkit</sys:String>
    <sys:String x:Key="AboutPage.Credits.Xbox360Toolkit.ToolTip"> - Análisis de los detalles de los juegos</sys:String>
    <sys:String x:Key="AboutPage.Credits.Sdl3Cs.Title">ppy.SDL3-CS</sys:String>
    <sys:String x:Key="AboutPage.Credits.Sdl3Cs.ToolTip"> - Bindings de SDL3 para la compatibilidad con mandos</sys:String>
    <sys:String x:Key="AboutPage.Credits.SharpCompress.Title">SharpCompress</sys:String>
    <sys:String x:Key="AboutPage.Credits.SharpCompress.ToolTip"> - Gestión de archivos comprimidos y compresión</sys:String>
    <sys:String x:Key="AboutPage.Credits.SystemIOHashing.Title">System.IO.Hashing</sys:String>
    <sys:String x:Key="AboutPage.Credits.SystemIOHashing.ToolTip"> - Algoritmos de hash rápidos (XxHash)</sys:String>
    <sys:String x:Key="AboutPage.Credits.TweenAvalonia.Title">TweenAvalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.TweenAvalonia.ToolTip"> - Animaciones tween programáticas para Avalonia</sys:String>
    <sys:String x:Key="AboutPage.Credits.ZstdSharp.Title">ZstdSharp</sys:String>
    <sys:String x:Key="AboutPage.Credits.ZstdSharp.ToolTip"> - Compresión Zstandard para .NET</sys:String>
    <sys:String x:Key="AboutPage.FooterNote.Text">Esta aplicación no está afiliada, respaldada ni patrocinada de ninguna manera por Microsoft Corporation ni por el Xenia Project. Todas las marcas comerciales, logotipos y nombres de marca son propiedad de sus respectivos titulares.&#10;Xbox 360 es una marca registrada de Microsoft Corporation en Estados Unidos y/o en otros países.&#10;Xenia es una marca registrada del Xenia Project.&#10;Cualquier referencia a estas u otras marcas comerciales se hace únicamente con el fin de identificar la compatibilidad o la funcionalidad y no implica asociación ni respaldo alguno por parte de los titulares de las marcas.&#10;Este software está destinado únicamente a fines educativos e informativos. No contiene ni distribuye ningún contenido protegido por derechos de autor propiedad de Microsoft Corporation ni de terceros. Los usuarios son los únicos responsables de garantizar que el uso de este software cumpla con todas las leyes aplicables, incluidas las de derechos de autor y licencias.&#10;Cualquier uso de esta aplicación para ejecutar o interactuar con software o firmware propietario debe realizarse dentro de los límites de los contratos de licencia de usuario final (EULA) pertinentes. Los desarrolladores y distribuidores de esta aplicación no toleran ni apoyan la piratería en ninguna forma.&#10;Esta aplicación se proporciona 'tal cual', sin garantía de ningún tipo, ni expresa ni implícita. Úsala bajo tu propia responsabilidad.</sys:String>
    <sys:String x:Key="AboutPage.UseExperimentalBuild.Title">Usar compilación experimental</sys:String>
    <sys:String x:Key="AboutPage.UseExperimentalBuild.Description">Actívalo para recibir actualizaciones de funciones experimentales y acceso anticipado a nuevas funciones</sys:String>
    <sys:String x:Key="AboutPage.WebsiteButton.ToolTip">Abre el sitio web de Xenia Manager</sys:String>
    <sys:String x:Key="AboutPage.GithubButton.ToolTip">Abre el repositorio de GitHub de Xenia Manager</sys:String>
    <sys:String x:Key="AboutPage.InfoBar.XeniaManagerUpdateAvailable.Message">Hay una versión más reciente de Xenia Manager disponible.</sys:String>
    <sys:String x:Key="AboutPage.InfoBar.NoXeniaManagerUpdateAvailable.Message">Ya tienes la última versión de Xenia Manager.</sys:String>

    <!-- Library Page - Drag & Drop -->
    <sys:String x:Key="LibraryPage.DragDrop.Title">Suelta los archivos para añadir juegos</sys:String>
    <sys:String x:Key="LibraryPage.DragDrop.Subtitle">Se admiten archivos .iso, .xex y .zar</sys:String>

    <!-- Multi-Disc Support -->
    <sys:String x:Key="GameButton.ContextFlyout.EditGame.ManageDiscs.Header">Gestionar discos</sys:String>
    <sys:String x:Key="GameButton.ContextFlyout.EditGame.ManageDiscs.ToolTip">Añade, renombra o elimina discos de juegos de varios discos</sys:String>
    <sys:String x:Key="GameButton.ContextFlyout.ManageDiscs.Error.Title">Error al gestionar los discos</sys:String>
