    <sys:String x:Key="ManagePage.Content.RedownloadBindings.NotInstalled.Message">Xenia Mousehook no está instalado.&#10;Instala Xenia Mousehook antes de volver a descargar las asignaciones.</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadBindings.Confirmation.Title">Confirmación de nueva descarga</sys:String>
    <sys:String x:Key="ManagePage.Content.RedownloadBindings.Confirmation.Message">¿Quieres volver a descargar el archivo de asignaciones de Xenia {0}?&#10;&#10;Esto sustituirá tu bindings.ini actual por una copia nueva del repositorio.</sys:String>
