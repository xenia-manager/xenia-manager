    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Success.Message">Se han exportado {0} acceso(s) directo(s) de juegos correctamente.&#10;Fallidos: {1}&#10;&#10;Exportaciones correctas:&#10;{2}&#10;&#10;Exportaciones fallidas:&#10;{3}</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Error.Title">Error al exportar</sys:String>
    <sys:String x:Key="LibraryPage.Options.ExportShortcuts.Error.Message">Se ha producido un error al exportar los accesos directos de los juegos.&#10;{0}</sys:String>
