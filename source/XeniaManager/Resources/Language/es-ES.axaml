    <sys:String x:Key="LibraryPage.Options.OptimizeGameSettings.Success.Message">Se han optimizado {0} juego(s) correctamente.&#10;Sin cambios: {1}&#10;No encontrados: {2}&#10;Fallidos: {3}&#10;&#10;Juegos optimizados:&#10;{4}&#10;&#10;Juegos sin cambios:&#10;{5}&#10;&#10;Juegos sin ajustes optimizados:&#10;{6}&#10;&#10;Optimizaciones fallidas:&#10;{7}</sys:String>
