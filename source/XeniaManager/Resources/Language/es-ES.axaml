    <sys:String x:Key="ManagePage.Content.UpdateSDLDatabase.Success.Title">Actualización completada</sys:String>
    <sys:String x:Key="ManagePage.Content.UpdateSDLDatabase.Success.Message">La base de datos de mandos de SDL se ha actualizado correctamente en todas las versiones de Xenia.</sys:String>
