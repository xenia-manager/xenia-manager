    <sys:String x:Key="ManagePage.Content.ClearShaderCache.Title">Borrar caché de shaders</sys:String>
    <sys:String x:Key="ManagePage.Content.ClearShaderCache.Description">Elimina los archivos de la caché de shaders</sys:String>
    <sys:String x:Key="ManagePage.Content.ClearShaderCache.Button">Borrar</sys:String>
    <sys:String x:Key="ManagePage.Content.ClearShaderCache.NoEmulator.Title">No hay ningún emulador instalado</sys:String>
    <sys:String x:Key="ManagePage.Content.ClearShaderCache.NoEmulator.Message">Instala al menos una versión de Xenia antes de borrar la caché de shaders.</sys:String>
    <sys:String x:Key="ManagePage.Content.ClearShaderCache.Success.Title">Caché de shaders borrada</sys:String>
    <sys:String x:Key="ManagePage.Content.ClearShaderCache.Success.Message">Se han borrado {0} archivos de la caché de shaders de Xenia {1} correctamente.</sys:String>
