    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoSelection.Message">Selecciona un archivo de configuración antes de optimizar los ajustes.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoGame.Title">Ningún juego seleccionado</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NoGame.Message">Selecciona un juego antes de optimizar los ajustes.</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NotFound.Title">Ajustes optimizados no encontrados</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.NotFound.Message">No se han encontrado ajustes optimizados para: {0}</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.ConfigNotFound.Title">Configuración no encontrada</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.ConfigNotFound.Message">No se ha podido cargar el archivo de configuración de: {0}</sys:String>
    <sys:String x:Key="XeniaSettingsPage.OptimizeSettings.Success.Title">Ajustes optimizados</sys:String>
