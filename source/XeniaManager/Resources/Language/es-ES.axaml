    <sys:String x:Key="ManagePage.Content.Management.Title">Gestión de contenido</sys:String>
    <sys:String x:Key="ManagePage.Content.Management.Description">Gestiona el contenido y los perfiles</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.Title">Copia de seguridad automática de partidas</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.Description">Realiza automáticamente una copia de seguridad de la partida guardada del perfil seleccionado</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.NoProfiles.Title">No hay perfiles disponibles</sys:String>
    <sys:String x:Key="ManagePage.Content.AutomaticSaveBackup.NoProfiles.Message">No se han encontrado perfiles para activar la copia de seguridad automática de partidas.&#10;Crea o importa antes un perfil.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Title">Carpeta de contenido unificada</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Description">Hace que todas las versiones de Xenia compartan la misma carpeta de contenido. Requiere derechos de administrador y una unidad NTFS.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.ToolTip">NOTA: Requiere privilegios de administrador y una unidad con formato NTFS, ya que esta función utiliza enlaces simbólicos</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.AdminRequired.Title">Se requiere administrador</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.AdminRequired.Message">Esta acción requiere ejecutar Xenia Manager como administrador.&#10;Reinicia Xenia Manager con privilegios administrativos.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Title">Separar carpetas de contenido</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Message">¿Quieres separar las carpetas de contenido?&#10;Cada versión de Xenia tendrá su propio directorio de contenido independiente.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Title">Unificar carpetas de contenido</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Message">¿Quieres unificar las carpetas de contenido?&#10;Todas las versiones de Xenia compartirán el mismo directorio de contenido.&#10;&#10;Selecciona el contenido de qué versión se usará como base.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Success.Title">Unificación de carpetas de contenido correcta</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Unify.Success.Message">Las carpetas de contenido se han unificado correctamente.&#10;Ahora todas las versiones de Xenia comparten el mismo directorio de contenido.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Success.Title">Separación de carpetas de contenido correcta</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Separate.Success.Message">Las carpetas de contenido se han separado correctamente.&#10;Ahora cada versión de Xenia tiene su propio directorio de contenido independiente.</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Operation.Failed.Title">Error en la operación de carpetas de contenido</sys:String>
    <sys:String x:Key="ManagePage.Emulator.Settings.UnifiedContentFolder.Operation.Failed.Message">No se han podido unificar/separar las carpetas de contenido.&#10;Error: {0}</sys:String>

