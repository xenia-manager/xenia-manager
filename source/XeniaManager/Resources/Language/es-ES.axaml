    <sys:String x:Key="ManagePage.Content.ExportLogs.Title">Exportar registros</sys:String>
    <sys:String x:Key="ManagePage.Content.ExportLogs.Description">Exporta el archivo de registro de Xenia a la ubicación indicada</sys:String>
    <sys:String x:Key="ManagePage.Content.ExportLogs.Button">Exportar registros</sys:String>
