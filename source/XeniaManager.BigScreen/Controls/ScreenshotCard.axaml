<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
             mc:Ignorable="d" d:DesignWidth="384" d:DesignHeight="216"
             x:Class="XeniaManager.BigScreen.Controls.ScreenshotCard"
             x:DataType="vm:ScreenshotItemViewModel"
             Focusable="True"
             Classes.selected="{Binding IsSelected}">
    <Grid>
        <Border x:Name="Tile" Background="{DynamicResource CardBackground}" CornerRadius="12" />
        <Border x:Name="ArtClip" CornerRadius="6" ClipToBounds="True">
            <Image Source="{Binding Image}"
                   IsVisible="{Binding HasImage}"
                   VerticalAlignment="Bottom"
                   Stretch="UniformToFill" />
        </Border>
        <Border x:Name="TitleBar"
                Background="{DynamicResource CardTitleBar}"
                IsVisible="{Binding IsSelected}"
                VerticalAlignment="Bottom"
                CornerRadius="0,0,8,8">
            <TextBlock Text="{Binding GameTitle}"
                       Foreground="{DynamicResource TextPrimary}"
                       Padding="20"
                       FontSize="15"
                       TextTrimming="CharacterEllipsis" />
        </Border>
        <Border x:Name="BorderOverlay"
                Margin="-2"
                CornerRadius="6"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
