<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:controls="using:XeniaManager.BigScreen.Controls"
             mc:Ignorable="d" d:DesignWidth="384" d:DesignHeight="216"
             x:Class="XeniaManager.BigScreen.Controls.ScreenshotCard"
             x:DataType="vm:ScreenshotItemViewModel"
             Focusable="True"
             Classes.selected="{Binding IsSelected}">
    <controls:ArtTile Art="{Binding Image}"
                      HasArt="{Binding HasImage}"
                      Title="{Binding GameTitle}"
                      ArtCornerRadius="6"
                      OverlayCornerRadius="6" />
</UserControl>
