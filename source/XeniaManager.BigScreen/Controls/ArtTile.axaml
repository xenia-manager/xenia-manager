<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="XeniaManager.BigScreen.Controls.ArtTile"
             x:Name="Root"
             x:CompileBindings="False">
    <!-- Shared art tile: primary/secondary art, title bar on selection and a
         border overlay carrying the selection strokes. The DataContext type
         differs per card (GameCardViewModel vs ScreenshotItemViewModel), so
         the IsSelected binding is resolved at runtime. -->
    <Grid>
        <Border x:Name="Tile" CornerRadius="12" Background="{DynamicResource CardBackground}" />
        <Border x:Name="ArtClip"
                CornerRadius="{Binding #Root.ArtCornerRadius}"
                ClipToBounds="True">
            <Panel>
                <Image Source="{Binding #Root.Art}"
                       IsVisible="{Binding #Root.HasArt}"
                       Stretch="UniformToFill"
                       VerticalAlignment="Bottom" />
                <Image Source="{Binding #Root.SecondaryArt}"
                       IsVisible="{Binding #Root.HasSecondaryArt}"
                       Stretch="UniformToFill" />
            </Panel>
        </Border>
        <Border x:Name="TitleBar"
                IsVisible="{Binding IsSelected}"
                CornerRadius="0,0,8,8"
                VerticalAlignment="Bottom"
                Background="{DynamicResource CardTitleBar}">
            <TextBlock Text="{Binding #Root.Title}"
                       Classes="card-title" />
        </Border>
        <Border x:Name="BorderOverlay"
                CornerRadius="{Binding #Root.OverlayCornerRadius}"
                Margin="-2"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
