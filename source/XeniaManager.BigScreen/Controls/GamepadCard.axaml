<Button xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
        xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="64"
        x:Class="XeniaManager.BigScreen.Controls.GamepadCard"
        x:DataType="vm:GamepadItemViewModel"
        Classes.selected="{Binding IsSelected}">
    <Button.Template>
        <ControlTemplate TargetType="Button">
            <Border x:Name="RowBorder"
                    Padding="22,14"
                    Margin="0,0,0,8"
                    Background="{DynamicResource CardSubtleFill}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="3"
                    CornerRadius="8">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center" />
            </Border>
        </ControlTemplate>
    </Button.Template>
    <DockPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    Margin="0,0,40,0">
            <fluent:SymbolIcon x:Name="BatteryIconControl"
                               Symbol="{Binding BatteryIcon}"
                               Margin="0,2,0,0" />
            <TextBlock x:Name="BatteryTextBlock"
                       Text="{Binding BatteryText}"
                       VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,0,40,0"
                    VerticalAlignment="Center">
            <TextBlock x:Name="StatusLabelTextBlock"
                       Text="{Binding StatusLabel}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="StatusValueTextBlock"
                       Text="{Binding StatusValue}"
                       VerticalAlignment="Center"
                       Classes.status-primary="{Binding IsPrimary}" />
        </StackPanel>
        <TextBlock x:Name="NameTextBlock"
                   Text="{Binding Name}"
                   Margin="0,0,80,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </DockPanel>
</Button>
