<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="XeniaManager.BigScreen.Controls.ModalHost">
    <!-- Every open modal renders here, bottom to top - later entries overlay
         earlier ones, so confirmations sit on top of the view beneath them.
         Only the top entry receives input. -->
    <Panel x:Name="StackHost" />
</UserControl>