<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
             mc:Ignorable="d" d:DesignWidth="384" d:DesignHeight="216"
             x:Class="XeniaManager.BigScreen.Controls.Cards.ScreenshotCard"
             x:DataType="vm:ScreenshotItemViewModel"
             Focusable="True"
             Classes.selected="{Binding IsSelected}">
    <Grid>
        <Border x:Name="Tile" CornerRadius="6" Background="{DynamicResource CardBackground}" />
        <Border x:Name="ArtClip" CornerRadius="6" ClipToBounds="True">
            <Image Source="{Binding Image}"
                   IsVisible="{Binding HasImage}"
                   Stretch="UniformToFill"
                   VerticalAlignment="Bottom"
                   Margin="4" />
        </Border>
        <Border x:Name="TitleBar"
                Background="{DynamicResource CardTitleBar}"
                CornerRadius="0,0,8,8"
                VerticalAlignment="Bottom"
                IsVisible="{Binding IsSelected}">
            <TextBlock Text="{Binding GameTitle}"
                       Classes="card-title" />
        </Border>
        <Border x:Name="BorderOverlay"
                CornerRadius="6"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>