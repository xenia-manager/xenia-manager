<Button xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
        mc:Ignorable="d"
        d:DesignWidth="180"
        d:DesignHeight="150"
        x:Class="XeniaManager.BigScreen.Controls.Cards.DiscOptionCard"
        x:DataType="vm:DiscOptionItemViewModel"
        Classes.selected="{Binding IsSelected}"
        Classes.missing="{Binding IsMissing}"
        Width="180"
        Height="150"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Center">
    <Button.Template>
        <ControlTemplate TargetType="Button">
            <Border x:Name="RowBorder"
                    Padding="14,12"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorderInner}"
                    BorderThickness="3"
                    BoxShadow="{DynamicResource CardShadowSoft}"
                    CornerRadius="10">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center" />
            </Border>
        </ControlTemplate>
    </Button.Template>
    <StackPanel Spacing="8">
        <Path Width="36"
              Height="36"
              Fill="{DynamicResource TextSecondary}"
              HorizontalAlignment="Center">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <EllipseGeometry Center="18,18"
                                     RadiusX="16"
                                     RadiusY="16" />
                    <EllipseGeometry Center="18,18"
                                     RadiusX="7"
                                     RadiusY="7" />
                </GeometryGroup>
            </Path.Data>
        </Path>
        <TextBlock Text="{Binding Label}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="18"
                   Foreground="{DynamicResource TextPrimary}" />
        <TextBlock Text="{Binding StatusText}"
                   IsVisible="{Binding IsStatusVisible}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}" />
    </StackPanel>
</Button>