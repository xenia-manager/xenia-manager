<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:controls="using:XeniaManager.BigScreen.Controls"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="XeniaManager.BigScreen.Controls.GameCard"
             x:DataType="vm:GameCardViewModel"
             Focusable="True"
             Classes.selected="{Binding IsSelected}">
    <controls:ArtTile Art="{Binding BoxArt}"
                      HasArt="{Binding HasBoxArt}"
                      SecondaryArt="{Binding DiscArt}"
                      HasSecondaryArt="{Binding HasDiscArt}"
                      Title="{Binding Title}" />
</UserControl>
