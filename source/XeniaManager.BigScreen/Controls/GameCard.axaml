<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Items"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="200"
             x:Class="XeniaManager.BigScreen.Controls.GameCard"
             x:DataType="vm:GameCardViewModel"
             Focusable="True"
             Classes.selected="{Binding IsSelected}">
    <Grid>
        <Border x:Name="Tile" CornerRadius="10" Background="{DynamicResource CardBackground}" Margin="2" />
        <Border x:Name="ArtClip" Background="Transparent" CornerRadius="10" Margin="2">
            <Panel>
                <Image Source="{Binding BoxArt}"
                       IsVisible="{Binding ShowBoxArt}"
                       Stretch="UniformToFill"
                       VerticalAlignment="Bottom" />
                <Image Source="{Binding DiscArt}"
                       IsVisible="{Binding ShowDiscArt}"
                       Stretch="UniformToFill" />
            </Panel>
        </Border>
        <Border x:Name="TitleBar"
                Background="{DynamicResource CardTitleBar}"
                CornerRadius="0,0,8,8"
                VerticalAlignment="Bottom"
                IsVisible="{Binding IsSelected}">
            <TextBlock Text="{Binding Title}"
                       Classes="card-title" />
        </Border>
        <Border x:Name="BorderOverlay"
                CornerRadius="10"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>