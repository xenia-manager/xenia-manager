<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Modals"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="XeniaManager.BigScreen.Controls.Modals.ConfirmationModal"
             x:DataType="vm:ConfirmationModalViewModel">

    <Grid>
        <!-- The confirmation's own backdrop: fills the whole content area,
             the prompt card sits centered on top of it -->
        <Border Background="{DynamicResource ModalCardScrim}" />

        <!-- PROMPT CARD: consistent size, anchored center -->
        <Border Classes="modal-card"
                Width="640"
                MinHeight="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- HEADER -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           Classes="modal-title"
                           Margin="0,0,0,25" />

                <!-- MESSAGE: top-left aligned -->
                <TextBlock Grid.Row="1"
                           Text="{Binding Message}"
                           Classes="modal-message" />

                <!-- OPTIONS: anchored bottom right -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="12"
                            Margin="0,25,0,0">
                    <Button x:Name="BtnOption1"
                            Classes="option-button"
                            Classes.selected="{Binding IsOption1Selected}"
                            Content="{Binding Option1Text}"
                            Click="OnOption1Click" />
                    <Button x:Name="BtnOption2"
                            Classes="option-button"
                            Classes.selected="{Binding IsOption2Selected}"
                            Content="{Binding Option2Text}"
                            Click="OnOption2Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>