<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Screens"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:card="using:XeniaManager.BigScreen.Controls.Cards"
             xmlns:prim="using:XeniaManager.BigScreen.Controls.Primitives"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="XeniaManager.BigScreen.Views.Screens.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="{Binding ScreenBackground}">
    <Grid RowDefinitions="Auto, *, Auto" Margin="60">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,20,0,30">
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource Library.Title}"
                       Classes="screen-title" />
            <prim:IconStat Grid.Column="1"
                           Icon="ArrowSort"
                           Stat="{Binding SortText}"
                           IconRotation="90"
                           IconSize="26"
                           Spacing="16"
                           VerticalAlignment="Center"
                           FontSize="24" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,20">
            <!-- CAROUSEL VIEW: horizontal card row -->
            <Grid IsVisible="{Binding !IsListView}">
                <ScrollViewer x:Name="SvCarousel"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GamesRow"
                                  ItemsSource="{Binding Games}"
                                  Margin="0,40,0,0"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="items:GameCardViewModel">
                                <card:LibraryCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="20" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty-library stub: subtle disc card, shown when there are no games -->
                <Border IsVisible="{Binding ShowEmptyStub}"
                        Height="200"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="320"
                        Classes="empty-state">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <fluent:SymbolIcon Symbol="PlayCircle"
                                           FontSize="72" />
                        <TextBlock Text="{DynamicResource Library.NoGamesFound}"
                                   FontSize="24" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- LIST VIEW: vertical list + details pane -->
            <Grid ColumnDefinitions="3*,4*" ColumnSpacing="40" IsVisible="{Binding IsListView}">
                <Border Grid.Column="0"
                        Padding="14"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="4"
                        BoxShadow="{DynamicResource CardShadow}"
                        CornerRadius="12">
                    <ScrollViewer x:Name="SvList"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="GamesList"
                                      ItemsSource="{Binding Games}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="items:GameCardViewModel">
                                    <card:LibraryListItem />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="1"
                        IsVisible="{Binding Details, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <card:GameDetailsPanel DataContext="{Binding Details}" />
                </Border>

                <!-- Empty-library stub (list view) -->
                <Border Grid.Column="0"
                        Grid.ColumnSpan="2"
                        IsVisible="{Binding ShowEmptyStub}"
                        Height="200"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="320"
                        Classes="empty-state">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <fluent:SymbolIcon Symbol="PlayCircle"
                                           FontSize="72" />
                        <TextBlock Text="{DynamicResource Library.NoGamesFound}"
                                   FontSize="24" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Classes="hint-bar" IsVisible="{Binding IsHintBarVisible}">
            <prim:InputHint Char="B" KeyColour="{DynamicResource HintKeyB}"
                            Text="{DynamicResource Library.Hint.Back}" />
            <prim:InputHint Char="A" KeyColour="{DynamicResource HintKeyA}"
                            Text="{DynamicResource Library.Hint.Play}" />
            <prim:InputHint Char="X" KeyColour="{DynamicResource HintKeyX}"
                            Text="{DynamicResource Library.Hint.Sort}" />
            <prim:InputHint Char="Y" KeyColour="{DynamicResource HintKeyY}"
                            Text="{DynamicResource Library.Hint.Details}" />
            <prim:InputHint Icon="CaretLeft" KeyColour="{DynamicResource HintKeyBack}"
                            Text="{DynamicResource Library.Hint.SwapView}" />
        </StackPanel>
    </Grid>
</UserControl>