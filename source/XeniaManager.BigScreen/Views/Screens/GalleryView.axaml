<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Screens"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:card="using:XeniaManager.BigScreen.Controls.Cards"
             xmlns:prim="using:XeniaManager.BigScreen.Controls.Primitives"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="XeniaManager.BigScreen.Views.Screens.GalleryView"
             x:DataType="vm:GalleryViewModel"
             Background="{Binding ScreenBackground}">

    <Grid>
        <!-- CONTENT (header + gallery + hints), inset by the screen margin -->
        <Grid Margin="60" RowDefinitions="Auto, *, Auto">

            <!-- HEADER: title left, sort indicator top right -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,20,0,45">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Gallery.Title}"
                           Classes="screen-title" />
                <prim:IconStat Grid.Column="1"
                                   Icon="ArrowSort"
                                   Stat="{Binding GallerySortText}"
                                   IconRotation="90"
                                   IconSize="26"
                                   Spacing="16"
                                   VerticalAlignment="Center"
                                   FontSize="24" />
            </Grid>

            <!-- GALLERY GRID (4 across, scrolls down) -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SvCarousel"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ScreenshotsGrid"
                                  ItemsSource="{Binding Screenshots}"
                                  Margin="0,0,0,40">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="items:ScreenshotItemViewModel">
                                <card:ScreenshotCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemsAlignment="Start"
                                           ItemSpacing="16"
                                           LineSpacing="16"
                                           Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty-gallery stub: shown when there are no screenshots -->
                <Border IsVisible="{Binding ShowEmptyScreenshots}"
                        Height="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="360"
                        Classes="empty-state">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <fluent:SymbolIcon Symbol="Camera"
                                           FontSize="72" />
                        <TextBlock Text="{DynamicResource Gallery.NoScreenshotsFound}"
                                   FontSize="24" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HINTS (gallery) -->
            <StackPanel Grid.Row="2" Classes="hint-bar">
                <prim:InputHint Char="B" KeyColour="{DynamicResource HintKeyB}"
                                    Text="{DynamicResource Gallery.Hint.Back}" />
                <prim:InputHint Char="A" KeyColour="{DynamicResource HintKeyA}"
                                    Text="{DynamicResource Gallery.Hint.Select}" />
                <prim:InputHint Char="X" KeyColour="{DynamicResource HintKeyX}"
                                    Text="{DynamicResource Gallery.Hint.Sort}" />
            </StackPanel>
        </Grid>

        <!-- SCREENSHOT VIEWER (nested sub-screen, covers the whole screen while open) -->
        <ContentControl Content="{Binding Viewer}"
                        IsHitTestVisible="{Binding IsViewerOpen}"
                        IsVisible="{Binding IsViewerOpen}" />
    </Grid>
</UserControl>