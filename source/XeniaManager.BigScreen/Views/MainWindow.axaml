<windowing:FAAppWindow xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:vm="using:XeniaManager.BigScreen.ViewModels"
                       xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
                       xmlns:controls="using:XeniaManager.BigScreen.Controls"
                       xmlns:views="using:XeniaManager.BigScreen.Views"
                       xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
                       xmlns:windowing="using:FluentAvalonia.UI.Windowing"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
                       x:Class="XeniaManager.BigScreen.Views.MainWindow"
                       x:DataType="vm:MainWindowViewModel"
                       Icon="/Assets/icon.ico"
                       Title="{DynamicResource MainWindow.Title}"
                       Width="1920" Height="1080"
                       WindowState="FullScreen"
                       WindowDecorations="None"
                       WindowStartupLocation="CenterScreen"
                       Background="{Binding Dashboard.Background}">

    <Panel>
        <!-- Shared centered column so the header margins align with the content rows -->
        <Grid RowDefinitions="150, *" ColumnDefinitions="*, Auto, *">

            <!-- Vignette overlay over the background (ignores input, images only) -->
            <Border Grid.ColumnSpan="3" Grid.RowSpan="2"
                    IsVisible="{Binding Dashboard.VignetteVisible}"
                    IsHitTestVisible="False"
                    Background="{DynamicResource BackgroundVignette}" />

            <!-- Black fade overlay for background transitions (ignores input) -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2"
                    Opacity="{Binding Dashboard.FadeOpacity}"
                    IsHitTestVisible="False"
                    Background="Black">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- TOP DASHBOARD HEADER -->
            <Grid Grid.Row="0" Grid.Column="1"
                  ColumnDefinitions="Auto, *, Auto"
                  VerticalAlignment="Center">

                <!-- PROFILE (LEFT): focusable chip - opens the profile picker -->
                <controls:ProfileButton Grid.Column="0"
                                        VerticalAlignment="Center" />

                <!-- SYSTEM STATUS (RIGHT) -->
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="16"
                            VerticalAlignment="Center">
                    <Grid Height="26" Width="26">
                        <fluent:SymbolIcon Symbol="{Binding Header.NetworkIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="24"
                                           Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                    <Grid Height="26" Width="26">
                        <fluent:SymbolIcon Symbol="{Binding Header.BatteryIcon}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="24"
                                           Foreground="{DynamicResource TextPrimary}" />
                    </Grid>
                    <TextBlock Text="{Binding Header.Time}"
                               MinWidth="{Binding Header.ClockMinWidth}"
                               VerticalAlignment="Center"
                               Classes="header-text"
                               FontSize="18"
                               Foreground="{DynamicResource TextPrimary}"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>

            <!-- MAIN DASHBOARD CONTENT -->
            <ContentControl Grid.Row="1" Grid.Column="1"
                            Content="{Binding Dashboard}"
                            Margin="0,0,0,80" />

            <!-- OVERLAY LAYER (covers the whole window when a screen is open) -->
            <Panel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2"
                   IsVisible="{Binding IsOverlayOpen}"
                   IsHitTestVisible="{Binding IsOverlayOpen}">
                <!-- Full-screen backdrop -->
                <Border Background="{DynamicResource OverlayBackdrop}" />
                <!-- Screens are created at startup; opening just flips visibility -->
                <Grid IsVisible="{Binding IsLibraryScreen}">
                    <views:LibraryView DataContext="{Binding Library}" />
                </Grid>
                <Grid IsVisible="{Binding IsMediaScreen}">
                    <views:MediaView DataContext="{Binding Media}" />
                </Grid>
                <Grid IsVisible="{Binding IsSettingsScreen}">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Grid>
            </Panel>
        </Grid>

        <!-- MODAL LAYER: covers the ENTIRE window - a sibling of the content grid,
             not a grid child, so the backdrop is always full-screen -->
        <Panel IsVisible="{Binding IsModalOpen}"
               IsHitTestVisible="{Binding IsModalOpen}">
            <!-- Transparent black backdrop over everything -->
            <Border Background="{DynamicResource ModalBackdrop}" />
            <!-- The top modal's view, rebuilt on every stack change -->
            <controls:ModalHost />
        </Panel>
    </Panel>

</windowing:FAAppWindow>