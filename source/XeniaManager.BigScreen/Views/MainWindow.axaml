<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XeniaManager.BigScreen.ViewModels"
        xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
        xmlns:controls="using:XeniaManager.BigScreen.Controls"
        xmlns:views="using:XeniaManager.BigScreen.Views"
        xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="XeniaManager.BigScreen.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="XeniaManager.BigScreen"
        Width="1920" Height="1080"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen"
        Background="{Binding Dashboard.Background}">

    <Window.DataTemplates>
        <DataTemplate DataType="items:GameCardViewModel">
            <controls:GameCard/>
        </DataTemplate>
        <DataTemplate DataType="items:OptionsCardViewModel">
            <controls:OptionsCard/>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- Subtle dark halo so header text stays readable over any background image -->
        <Style Selector="TextBlock.header-text">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="1" Color="Black" Opacity="0.7" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Styles>

    <!-- Shared centered column so the header margins align with the content rows -->
    <Grid RowDefinitions="150, *" ColumnDefinitions="*, Auto, *">

        <!-- Vignette overlay over the background (ignores input, images only) -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="3"
                Background="{DynamicResource BackgroundVignette}"
                IsVisible="{Binding Dashboard.VignetteVisible}"
                IsHitTestVisible="False" />

        <!-- Black fade overlay for background transitions (ignores input) -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Grid.Column="0"
                Background="Black"
                Opacity="{Binding Dashboard.FadeOpacity}"
                IsHitTestVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- TOP DASHBOARD HEADER -->
        <Grid Grid.Row="0" Grid.Column="1"
              ColumnDefinitions="Auto, *, Auto"
              VerticalAlignment="Center">

            <!-- PROFILE (LEFT) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource CardBackground}"
                        BoxShadow="0 4 12 0 #40000000">
                    <fluent:SymbolIcon Symbol="PersonCircle"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,-4,0,0">
                    <TextBlock Classes="header-text" Text="{Binding Header.Gamertag}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="18"
                               FontWeight="Bold" />
                    <controls:IconStat Icon="Star" Stat="{Binding Header.Gamerscore}" IconSize="13" FontSize="13" />
                </StackPanel>
            </StackPanel>

            <!-- SYSTEM STATUS (RIGHT) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="16">
                <Grid Width="26" Height="26">
                    <fluent:SymbolIcon Symbol="{Binding Header.WifiIcon}"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                </Grid>
                <Grid Width="26" Height="26">
                    <fluent:SymbolIcon Symbol="{Binding Header.BatteryIcon}"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                </Grid>
                <TextBlock Classes="header-text" Text="{Binding Header.Time}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           MinWidth="70"
                           TextAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- MAIN DASHBOARD CONTENT -->
        <ContentControl Grid.Row="1" Grid.Column="1"
                        Content="{Binding Dashboard}"
                        Margin="0,0,0,80" />

        <!-- OVERLAY LAYER (covers the whole window when a screen is open) -->
        <Panel Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Grid.Column="0"
               IsVisible="{Binding IsOverlayOpen}"
               IsHitTestVisible="{Binding IsOverlayOpen}">
            <!-- Full-screen backdrop -->
            <Border Background="#E60A0C10" />
            <!-- Screens are created at startup; opening just flips visibility -->
            <Grid IsVisible="{Binding IsLibraryScreen}">
                <views:LibraryView DataContext="{Binding Library}" />
            </Grid>
            <Grid IsVisible="{Binding IsMediaScreen}">
                <views:MediaView DataContext="{Binding Media}" />
            </Grid>
            <Grid IsVisible="{Binding IsSettingsScreen}">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Grid>
        </Panel>
    </Grid>

</Window>
