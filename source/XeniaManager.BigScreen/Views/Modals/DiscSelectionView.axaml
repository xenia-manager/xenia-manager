<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Modals"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:card="using:XeniaManager.BigScreen.Controls.Cards"
             xmlns:prim="using:XeniaManager.BigScreen.Controls.Primitives"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="XeniaManager.BigScreen.Views.Modals.DiscSelectionView"
             x:DataType="vm:DiscSelectionViewModel">

    <Grid>
        <!-- The disc selection's own backdrop: fills the whole content area,
             the prompt card sits centered on top of it -->
        <Border Background="{DynamicResource ModalCardScrim}" />

        <!-- DISC SELECTION CARD: compact, centered, slightly larger than a confirmation -->
        <Border Classes="modal-card"
                Width="880"
                MinHeight="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid RowDefinitions="Auto, *, Auto">

                <!-- HEADER: game icon + name, disc selection line underneath -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" ColumnSpacing="20">
                    <Border Width="56"
                            Height="56"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CardBorder}"
                            ClipToBounds="True"
                            CornerRadius="8">
                        <Grid>
                            <Image Source="{Binding Icon}"
                                   IsVisible="{Binding HasIcon}"
                                   Stretch="Uniform" />
                            <fluent:SymbolIcon Symbol="Games"
                                               IsVisible="{Binding !HasIcon}"
                                               FontSize="26"
                                               Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{DynamicResource DiscSelection.Header}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Grid>

                <!-- DISC OPTIONS: one card per disc, centered row -->
                <ItemsControl x:Name="DiscList"
                              Grid.Row="1"
                              ItemsSource="{Binding Discs}"
                              Margin="0,48,0,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:DiscOptionItemViewModel">
                            <card:DiscOptionCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- HINTS: B back · A select (top modal only) -->
                <StackPanel Grid.Row="2" Classes="hint-bar" Margin="0,36,0,0" IsVisible="{Binding IsHintBarVisible}">
                    <prim:InputHint Char="B" KeyColour="{DynamicResource HintKeyB}"
                                    Text="{DynamicResource DiscSelection.Hint.Back}" />
                    <prim:InputHint Char="A" KeyColour="{DynamicResource HintKeyA}"
                                    Text="{DynamicResource DiscSelection.Hint.Select}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>