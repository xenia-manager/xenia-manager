<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Modals"
             xmlns:set="using:XeniaManager.BigScreen.Controls.Settings"
             xmlns:prim="using:XeniaManager.BigScreen.Controls.Primitives"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
             x:Class="XeniaManager.BigScreen.Views.Modals.GameSettingsPaneView"
             x:DataType="vm:GameSettingsPaneViewModel">

    <UserControl.DataTemplates>
        <!-- Section header row -->
        <DataTemplate DataType="vm:ConfigSectionViewModel">
            <StackPanel Margin="0,10,0,12" Spacing="4">
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
        </DataTemplate>
        <!-- Config option row -->
        <DataTemplate DataType="vm:ConfigOptionViewModel">
            <set:ConfigOptionRow Margin="0,0,0,10" />
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Keep the virtualized rows invisible: no selection chrome, the rows
             style themselves via their own Classes.selected -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" RowSpacing="20">

        <!-- HEADER: title -->
        <prim:IconStat Grid.Row="0"
                       Icon="Settings"
                       Stat="{DynamicResource GameModal.Settings.Title}"
                       IconSize="26"
                       Spacing="14"
                       FontSize="24"
                       VerticalAlignment="Center" />

        <!-- SECTIONS: virtualized flat list (section headers + option rows) so
             only the visible rows are ever instantiated -->
        <ListBox x:Name="SettingsList"
                 Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden" />
    </Grid>
</UserControl>
