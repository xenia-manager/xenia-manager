<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Modals"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:card="using:XeniaManager.BigScreen.Controls.Cards"
             xmlns:prim="using:XeniaManager.BigScreen.Controls.Primitives"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="780"
             x:Class="XeniaManager.BigScreen.Views.Modals.InstalledContentPaneView"
             x:DataType="vm:InstalledContentPaneViewModel">
    <Grid RowDefinitions="Auto, *"
          RowSpacing="24">

        <!-- HEADER: content type + count -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="40"
                    VerticalAlignment="Center">
            <prim:IconStat Icon="Document"
                           Stat="{Binding TypeText}"
                           Classes="pane-header-stat" />
            <prim:IconStat Icon="Library"
                           Stat="{Binding CountText}"
                           Classes="pane-header-stat" />
        </StackPanel>

        <!-- BODY: content rows -->
        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="ContentList"
                              ItemsSource="{Binding Rows}"
                              Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="items:ContentItemViewModel">
                            <card:ContentRow />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"
                                        Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state: nothing installed of this type -->
            <prim:EmptyState IsVisible="{Binding ShowEmpty}"
                             Symbol="Document"
                             Text="{DynamicResource GameModal.Content.Empty}"
                             Width="520"
                             Height="220"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>