<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels.Modals"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:card="using:XeniaManager.BigScreen.Controls.Cards"
             xmlns:prim="using:XeniaManager.BigScreen.Controls.Primitives"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="780"
             x:Class="XeniaManager.BigScreen.Views.Modals.GameScreenshotsPaneView"
             x:DataType="vm:GameScreenshotsPaneViewModel">
    <Grid>
        <!-- GRID VIEW (pane content) -->
        <Grid RowDefinitions="Auto, *" RowSpacing="24">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <prim:IconStat Grid.Column="0"
                               Icon="Camera"
                               Stat="{Binding CountText}"
                               IconSize="26"
                               Spacing="14"
                               FontSize="24"
                               VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SvScreenshots"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="ScreenshotsGrid"
                                  ItemsSource="{Binding Rows}"
                                  Margin="0,0,0,20">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="items:ScreenshotItemViewModel">
                                <card:ScreenshotCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemsAlignment="Start"
                                           ItemSpacing="16"
                                           LineSpacing="16"
                                           Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading state -->
                <Border IsVisible="{Binding IsLoading}"
                        Height="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="360"
                        Classes="empty-state">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <fluent:SymbolIcon Symbol="Camera"
                                           FontSize="72" />
                        <TextBlock Text="{DynamicResource GameModal.Screenshots.Loading}"
                                   FontSize="24" />
                    </StackPanel>
                </Border>

                <!-- Empty state: no screenshots for this game -->
                <Border IsVisible="{Binding ShowEmpty}"
                        Height="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="360"
                        Classes="empty-state">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <fluent:SymbolIcon Symbol="Camera"
                                           FontSize="72" />
                        <TextBlock Text="{DynamicResource GameModal.Screenshots.Empty}"
                                   FontSize="24" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>