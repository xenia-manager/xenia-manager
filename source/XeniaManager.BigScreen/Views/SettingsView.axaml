<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels"
             xmlns:controls="using:XeniaManager.BigScreen.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="XeniaManager.BigScreen.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{Binding ScreenBackground}">

    <UserControl.Styles>
        <!-- Quit-toggle: rendered as a toggle switch (track + sliding thumb), no tick glyph -->
        <Style Selector="CheckBox.quit-toggle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Height="34" VerticalAlignment="Center" Width="66">
                            <Border x:Name="Track"
                                    CornerRadius="17"
                                    Background="{DynamicResource CardBorder}"
                                    BorderBrush="{DynamicResource TextSecondary}"
                                    BorderThickness="2" />
                            <Ellipse x:Name="Thumb"
                                     Height="26"
                                     HorizontalAlignment="Left"
                                     Margin="4,0,0,0"
                                     VerticalAlignment="Center"
                                     Width="26"
                                     Fill="#FFFFFFFF">
                                <Ellipse.Transitions>
                                    <Transitions>
                                        <ThicknessTransition Property="Margin" Duration="0:0:0.15" />
                                    </Transitions>
                                </Ellipse.Transitions>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="CheckBox.quit-toggle:checked /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        </Style>

        <Style Selector="CheckBox.quit-toggle:checked /template/ Ellipse#Thumb">
            <Setter Property="Margin" Value="32,0,4,0" />
        </Style>

        <Style Selector="CheckBox.quit-toggle:focus-visible /template/ Border#Track">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="60">
        <TextBlock Grid.Row="0"
                   Classes="screen-title"
                   Text="{DynamicResource Settings.Title}"
                   Margin="0,20,0,30" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Orientation="Vertical" Spacing="14">

                <!-- BACKGROUND TYPE -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <ComboBox x:Name="BackgroundModeCombo"
                                  DockPanel.Dock="Right"
                                  ItemsSource="{Binding BackgroundModeOptions}"
                                  SelectedItem="{Binding SelectedBackgroundMode}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  VerticalAlignment="Center"
                                  Width="420"
                                  FontSize="22"
                                  Padding="12,8" />
                        <TextBlock Text="{DynamicResource Settings.BackgroundType}"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- LIBRARY VIEW -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <ComboBox x:Name="LibraryViewModeCombo"
                                  DockPanel.Dock="Right"
                                  ItemsSource="{Binding LibraryViewModeOptions}"
                                  SelectedItem="{Binding SelectedLibraryViewMode}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  VerticalAlignment="Center"
                                  Width="420"
                                  FontSize="22"
                                  Padding="12,8" />
                        <TextBlock Text="{DynamicResource Settings.LibraryView}"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- PRIMARY COLOUR -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <controls:ColorPickerField x:Name="PrimaryColorField"
                                                   DockPanel.Dock="Right"
                                                   Color="{Binding PrimaryColor, Mode=TwoWay}"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings.PrimaryColour}"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- ACCENT COLOUR -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <controls:ColorPickerField x:Name="AccentColorField"
                                                   DockPanel.Dock="Right"
                                                   Color="{Binding AccentColor, Mode=TwoWay}"
                                                   VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Settings.AccentColour}"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- VIGNETTE OPACITY -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding VignetteText}"
                                   VerticalAlignment="Center"
                                   Width="60"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextAlignment="Right" />
                        <Slider DockPanel.Dock="Right"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding VignetteOpacity, Mode=TwoWay}"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Width="340" />
                        <TextBlock Text="{DynamicResource Settings.Vignette}"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- BACKGROUND IMAGE -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <Button x:Name="BtnSelectImage"
                                DockPanel.Dock="Right"
                                Content="{DynamicResource Settings.SelectImage}"
                                Padding="20,10"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Click="OnSelectImageClick" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ImageDisplayText}"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{DynamicResource Settings.BackgroundImage}"
                                   VerticalAlignment="Center"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DockPanel>
                </Border>

                <!-- QUIT BEHAVIOUR -->
                <Border CornerRadius="10"
                        Padding="24,16"
                        Background="{DynamicResource CardBackground}"
                        BoxShadow="{DynamicResource CardShadow}">
                    <DockPanel>
                        <CheckBox x:Name="ChkQuitBehaviour"
                                  DockPanel.Dock="Right"
                                  IsChecked="{Binding ReturnToXeniaOnQuit}"
                                  Padding="12,8"
                                  VerticalAlignment="Center"
                                  Classes="quit-toggle" />
                        <StackPanel Orientation="Vertical"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock Text="{DynamicResource Settings.ReturnToXeniaOnQuit}"
                                       FontSize="24"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{DynamicResource Settings.ReturnToXeniaOnQuit.Description}"
                                       FontSize="18"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Classes="hint-bar">
            <controls:InputHint Char="B" KeyColour="{DynamicResource HintKeyB}" Text="{DynamicResource Settings.Hint.Back}" />
        </StackPanel>
    </Grid>
</UserControl>
