<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:controls="using:XeniaManager.BigScreen.Controls"
             xmlns:fluent="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="XeniaManager.BigScreen.Views.MediaView"
             x:DataType="vm:MediaViewModel"
             Background="{Binding ScreenBackground}">

    <Grid>
        <!-- CONTENT (header + gallery + hints), inset by the screen margin -->
        <Grid Margin="60" RowDefinitions="Auto, *, Auto">

            <!-- HEADER: title left, sort indicator top right -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,20,0,45">
                <TextBlock Grid.Column="0"
                           Classes="screen-title"
                           Text="{DynamicResource Media.Title}" />
                <controls:IconStat Grid.Column="1"
                                   Icon="ArrowSort"
                                   Stat="{Binding MediaSortText}"
                                   IconSize="26"
                                   FontSize="24"
                                   Spacing="16"
                                   IconRotation="90"
                                   VerticalAlignment="Center" />
            </Grid>

            <!-- GALLERY GRID (4 across, scrolls down) -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="SvCarousel"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ScreenshotsGrid"
                                  ItemsSource="{Binding Screenshots}"
                                  Margin="0,0,0,40">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="items:ScreenshotItemViewModel">
                                <controls:ScreenshotCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           ItemSpacing="16"
                                           LineSpacing="16"
                                           ItemsAlignment="Start" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty-gallery stub: shown when there are no screenshots -->
                <Border Width="360" Height="220"
                        Classes="empty-state"
                        IsVisible="{Binding ShowEmptyScreenshots}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Vertical"
                                VerticalAlignment="Center"
                                Spacing="16">
                        <fluent:SymbolIcon Symbol="Camera"
                                           FontSize="72" />
                        <TextBlock Text="{DynamicResource Media.NoScreenshotsFound}"
                                   FontSize="24" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- HINTS (gallery) -->
            <StackPanel Grid.Row="2" Classes="hint-bar">
                <controls:InputHint Char="Y" KeyColour="{DynamicResource HintKeyY}" Text="{DynamicResource Media.Hint.Sort}" />
                <controls:InputHint Char="B" KeyColour="{DynamicResource HintKeyB}" Text="{DynamicResource Media.Hint.Back}" />
            </StackPanel>
        </Grid>

        <!-- SCREENSHOT VIEWER (nested sub-screen, covers the whole screen while open) -->
        <ContentControl Content="{Binding Viewer}"
                        IsVisible="{Binding IsViewerOpen}"
                        IsHitTestVisible="{Binding IsViewerOpen}" />
    </Grid>
</UserControl>
