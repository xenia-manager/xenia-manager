<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:XeniaManager.BigScreen.Controls"
        xmlns:fluent="using:FluentIcons.Avalonia.Fluent">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- CARD BASE -->
    <Style Selector="controls|GameCard, controls|OptionsCard">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <DoubleTransition Property="Height" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <!-- GAME CARD -->
    <Style Selector="controls|GameCard Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style Selector="controls|GameCard.selected Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
    </Style>

    <Style Selector="controls|GameCard">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="200" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Border overlay above the box art: carries every card stroke -->
    <Style Selector="controls|GameCard Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="5" />
    </Style>

    <Style
        Selector="controls|GameCard:pointerover Border#BorderOverlay, controls|GameCard.selected Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="5" />
    </Style>

    <!-- Subtle dark halo around card text so it stays readable on any background -->
    <Style
        Selector="controls|GameCard TextBlock, controls|OptionsCard TextBlock, controls|LibraryCard TextBlock, controls|ScreenshotCard TextBlock, controls|IconStat TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="0" Color="Black" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle dark halo behind the dashboard header text -->
    <Style Selector="TextBlock.header-text">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="1" Color="Black" Opacity="0.7" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Screen header title (Library / Media / Settings) -->
    <Style Selector="TextBlock.screen-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- SETTINGS SCREEN: section header between groups of cards -->
    <Style Selector="TextBlock.settings-section">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,10" />
    </Style>

    <!-- SETTINGS SCREEN: card surface (row border, background and shadow) -->
    <Style Selector="Border.settings-card">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="24,16" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <!-- SETTINGS SCREEN: left card label -->
    <Style Selector="TextBlock.settings-label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SETTINGS SCREEN: right-side value text (percentages, image name) -->
    <Style Selector="TextBlock.settings-value">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SETTINGS SCREEN: secondary description text -->
    <Style Selector="TextBlock.settings-subtitle">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- SETTINGS SCREEN: action button -->
    <Style Selector="Button.settings-button">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SETTINGS SCREEN: settings dropdown -->
    <Style Selector="ComboBox.settings-combo">
        <Setter Property="Width" Value="420" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- GAMEPAD CARD (settings controller row): subtle black fill,
         reserved border that turns accent on hover/selection -->
    <Style Selector="controls|GamepadCard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|GamepadCard Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    </Style>

    <Style
        Selector="controls|GamepadCard:pointerover Border#RowBorder, controls|GamepadCard:focus-visible Border#RowBorder, controls|GamepadCard.selected Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style Selector="controls|GamepadCard TextBlock#NameTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|GamepadCard TextBlock#BatteryTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|GamepadCard TextBlock#StatusLabelTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|GamepadCard TextBlock#StatusValueTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The primary gamepad's status value glows in the accent colour -->
    <Style Selector="controls|GamepadCard TextBlock#StatusValueTextBlock.status-primary">
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="controls|GamepadCard fluent|SymbolIcon#BatteryIconControl">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Card title-bar text (game + screenshot tiles) -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Bottom hint bar (keycap + label rows) -->
    <Style Selector="StackPanel.hint-bar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="36" />
        <Setter Property="Margin" Value="-15,36,0,-15" />
    </Style>

    <!-- Empty-state stub: card surface, shadow and secondary text -->
    <Style Selector="Border.empty-state">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.empty-state TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.empty-state fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- SETTINGS OVERLAY ROWS: reserved border thickness so focus doesn't change size -->
    <Style Selector="Border.settings-row">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <Style Selector="Border.settings-row.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- GAME CARD SELECTED (grows) -->
    <Style Selector="controls|GameCard.selected">
        <Setter Property="Width" Value="250" />
        <Setter Property="Height" Value="250" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- LIBRARY CARD (carousel) -->
    <Style Selector="controls|LibraryCard">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|LibraryCard > Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="controls|LibraryCard.selected > Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <!-- LIBRARY LIST ITEM (list view rows) -->
    <Style Selector="controls|LibraryListItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|LibraryListItem Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    </Style>

    <Style
        Selector="controls|LibraryListItem:pointerover Border#RowBorder, controls|LibraryListItem:focus-visible Border#RowBorder, controls|LibraryListItem.selected Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- SCREENSHOT CARD (media gallery) -->
    <Style Selector="controls|ScreenshotCard">
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|ScreenshotCard Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style Selector="controls|ScreenshotCard.selected Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
    </Style>

    <!-- Border overlay above the art: carries every card stroke -->
    <Style Selector="controls|ScreenshotCard Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style
        Selector="controls|ScreenshotCard:pointerover Border#BorderOverlay, controls|ScreenshotCard.selected Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <!-- OPTION CARD: reserved 4px border so hover/focus doesn't change size -->
    <Style Selector="controls|OptionsCard">
        <Setter Property="Width" Value="333" />
        <Setter Property="Height" Value="160" />
    </Style>

    <Style Selector="controls|OptionsCard Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="controls|OptionsCard:pointerover Border#Tile, controls|OptionsCard.selected Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- PROFILE BUTTON (header avatar chip): reserved 2px border so focus doesn't change size -->
    <Style Selector="controls|ProfileButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|ProfileButton Border#AvatarCircle">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style
        Selector="controls|ProfileButton:pointerover Border#AvatarCircle, controls|ProfileButton:focus-visible Border#AvatarCircle, controls|ProfileButton.selected Border#AvatarCircle">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
    </Style>

    <!-- MODAL CARD: regular card background with the regular card border -->
    <Style Selector="Border.modal-card">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowPopup}" />
        <Setter Property="Padding" Value="36" />
    </Style>

    <!-- MODAL SCREEN: the modal itself is a regular bordered card, inset from the screen edges -->
    <Style Selector="Border.modal-screen">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowPopup}" />
        <Setter Property="Margin" Value="60" />
    </Style>

    <!-- Modal text -->
    <Style Selector="TextBlock.modal-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.modal-message">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="30" />
    </Style>

    <!-- CONFIRMATION OPTION BUTTONS: distinct dark surface, accent border on selection -->
    <Style Selector="Button.option-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="MinWidth" Value="170" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RowBorder"
                            Background="{DynamicResource CardBorder}"
                            BorderBrush="{DynamicResource CardBorderInner}"
                            BorderThickness="3"
                            CornerRadius="10"
                            BoxShadow="{DynamicResource CardShadowFlat}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Padding="24,12" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        Selector="Button.option-button:pointerover /template/ Border#RowBorder, Button.option-button:focus-visible /template/ Border#RowBorder, Button.option-button.selected /template/ Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- PROFILE ROW (profile picker + manage profiles list) -->
    <Style Selector="controls|ProfileRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|ProfileRow Border#RowBorder">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderInner}" />
    </Style>

    <Style
        Selector="controls|ProfileRow:pointerover Border#RowBorder, controls|ProfileRow:focus-visible Border#RowBorder, controls|ProfileRow.selected Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- CREATE PROFILE STUB ROW (manage profiles) -->
    <Style Selector="controls|CreateProfileRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|CreateProfileRow Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderInner}" />
    </Style>

    <Style
        Selector="controls|CreateProfileRow:pointerover Border#RowBorder, controls|CreateProfileRow:focus-visible Border#RowBorder, controls|CreateProfileRow.selected Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style Selector="controls|CreateProfileRow.selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

</Styles>