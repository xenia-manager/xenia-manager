<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:XeniaManager.BigScreen.Controls"
        xmlns:fluent="using:FluentIcons.Avalonia.Fluent">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- CARD BASE -->
    <Style Selector="controls|GameCard, controls|OptionsCard">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <DoubleTransition Property="Height" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <!-- GAME CARD -->
    <Style Selector="controls|GameCard Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style Selector="controls|GameCard.selected Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
    </Style>

    <Style Selector="controls|GameCard">
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="200" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Border overlay above the box art: carries every card stroke -->
    <Style Selector="controls|GameCard Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="5" />
    </Style>

    <Style Selector="controls|GameCard:pointerover Border#BorderOverlay, controls|GameCard.selected Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="5" />
    </Style>

    <!-- Subtle dark halo around card text so it stays readable on any background -->
    <Style Selector="controls|GameCard TextBlock, controls|OptionsCard TextBlock, controls|LibraryCard TextBlock, controls|ScreenshotCard TextBlock, controls|IconStat TextBlock">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="2" OffsetX="0" OffsetY="0" Color="Black" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle dark halo behind the dashboard header text -->
    <Style Selector="TextBlock.header-text">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="3" OffsetX="0" OffsetY="1" Color="Black" Opacity="0.7" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Screen header title (Library / Media / Settings) -->
    <Style Selector="TextBlock.screen-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Card title-bar text (game + screenshot tiles) -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Bottom hint bar (keycap + label rows) -->
    <Style Selector="StackPanel.hint-bar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="36" />
        <Setter Property="Margin" Value="-15,16,0,-15" />
    </Style>

    <!-- Empty-state stub: card surface, shadow and secondary text -->
    <Style Selector="Border.empty-state">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="Border.empty-state TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.empty-state fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- SETTINGS OVERLAY ROWS: reserved border thickness so focus doesn't change size -->
    <Style Selector="Border.settings-row">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <Style Selector="Border.settings-row.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- GAME CARD SELECTED (grows) -->
    <Style Selector="controls|GameCard.selected">
        <Setter Property="Width" Value="250" />
        <Setter Property="Height" Value="250" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- LIBRARY CARD (carousel) -->
    <Style Selector="controls|LibraryCard">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|LibraryCard > Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="controls|LibraryCard.selected > Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <!-- LIBRARY LIST ITEM (list view rows) -->
    <Style Selector="controls|LibraryListItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|LibraryListItem Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    </Style>

    <Style Selector="controls|LibraryListItem:pointerover Border#RowBorder, controls|LibraryListItem:focus-visible Border#RowBorder, controls|LibraryListItem.selected Border#RowBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <!-- SCREENSHOT CARD (media gallery) -->
    <Style Selector="controls|ScreenshotCard">
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="controls|ScreenshotCard Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style Selector="controls|ScreenshotCard.selected Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
    </Style>

    <!-- Border overlay above the art: carries every card stroke -->
    <Style Selector="controls|ScreenshotCard Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="controls|ScreenshotCard:pointerover Border#BorderOverlay, controls|ScreenshotCard.selected Border#BorderOverlay">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <!-- OPTION CARD: reserved 4px border so hover/focus doesn't change size -->
    <Style Selector="controls|OptionsCard">
        <Setter Property="Width" Value="333" />
        <Setter Property="Height" Value="160" />
    </Style>

    <Style Selector="controls|OptionsCard Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="4" />
    </Style>

    <Style Selector="controls|OptionsCard:pointerover Border#Tile, controls|OptionsCard.selected Border#Tile">
        <Setter Property="BoxShadow" Value="{DynamicResource CardShadowSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

</Styles>
