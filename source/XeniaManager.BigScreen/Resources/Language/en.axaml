<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <!-- Core PlaytimeFormatter keys (required by Core's PlaytimeFormatter.Format) -->
    <sys:String x:Key="LibraryPage.GameButton.Playtime.NeverPlayed">Never played</sys:String>
    <sys:String x:Key="LibraryPage.GameButton.Playtime.Minutes">{0} min</sys:String>
    <sys:String x:Key="LibraryPage.GameButton.Playtime.Hours">{0} hrs</sys:String>

    <!-- MainWindow -->
    <sys:String x:Key="MainWindow.Title">Xenia Manager BigScreen</sys:String>

    <!-- Header -->
    <sys:String x:Key="Header.Guest">Guest</sys:String>

    <!-- Dashboard -->
    <sys:String x:Key="Dashboard.NoGamesFound">No games found</sys:String>

    <!-- Library screen -->
    <sys:String x:Key="Library.Title">Game Library</sys:String>
    <sys:String x:Key="Library.NoGamesFound">No games found</sys:String>
    <sys:String x:Key="Library.Sort.Alphabetical">Alphabetical</sys:String>
    <sys:String x:Key="Library.Sort.TimePlayed">Time Played</sys:String>
    <sys:String x:Key="Library.Sort.LastPlayed">Last Played</sys:String>
    <sys:String x:Key="Library.Hint.Sort">Sort</sys:String>
    <sys:String x:Key="Library.Hint.SwapView">Swap View</sys:String>
    <sys:String x:Key="Library.Hint.Play">Play</sys:String>
    <sys:String x:Key="Library.Hint.Back">Back</sys:String>

    <!-- Library list view details pane -->
    <sys:String x:Key="Library.Details.NoInfo">No information available</sys:String>
    <sys:String x:Key="Library.Details.Description">Description</sys:String>
    <sys:String x:Key="Library.Details.Genre">Genre:</sys:String>
    <sys:String x:Key="Library.Details.Developer">Developer:</sys:String>
    <sys:String x:Key="Library.Details.Publisher">Publisher:</sys:String>
    <sys:String x:Key="Library.Details.Released">Released:</sys:String>

    <!-- Media screen -->
    <sys:String x:Key="Media.Title">Media</sys:String>
    <sys:String x:Key="Media.NoScreenshotsFound">No screenshots found</sys:String>
    <sys:String x:Key="Media.Sort.NewestFirst">Newest First</sys:String>
    <sys:String x:Key="Media.Sort.OldestFirst">Oldest First</sys:String>
    <sys:String x:Key="Media.Sort.ByGame">By Game</sys:String>
    <sys:String x:Key="Media.UnknownGame">Unknown Game</sys:String>
    <sys:String x:Key="Media.Hint.Sort">Sort</sys:String>
    <sys:String x:Key="Media.Hint.Select">Select</sys:String>
    <sys:String x:Key="Media.Hint.Back">Back</sys:String>

    <!-- Media screenshot viewer -->
    <sys:String x:Key="Media.Viewer.Close">Close</sys:String>

    <!-- Settings screen -->
    <sys:String x:Key="Settings.Title">Settings</sys:String>
    <sys:String x:Key="Settings.Section.Preferences">Preferences</sys:String>
    <sys:String x:Key="Settings.Section.Theme">Theme</sys:String>
    <sys:String x:Key="Settings.Section.Controllers">Controllers</sys:String>
    <sys:String x:Key="Settings.ActiveProfile">Active Profile</sys:String>
    <sys:String x:Key="Settings.ManageProfiles">Manage Profiles</sys:String>
    <sys:String x:Key="Settings.BackgroundType">Background Type</sys:String>
    <sys:String x:Key="Settings.LibraryView">Library View</sys:String>
    <sys:String x:Key="Settings.LibraryView.Carousel">Carousel</sys:String>
    <sys:String x:Key="Settings.LibraryView.List">List</sys:String>
    <sys:String x:Key="Settings.CardImage">Card Image</sys:String>
    <sys:String x:Key="Settings.CardImage.BoxArt">Box Art</sys:String>
    <sys:String x:Key="Settings.CardImage.Icon">Icon</sys:String>
    <sys:String x:Key="Settings.TimeFormat">Time Format</sys:String>
    <sys:String x:Key="Settings.TimeFormat.TwelveHour">12-Hour</sys:String>
    <sys:String x:Key="Settings.TimeFormat.TwentyFourHour">24-Hour</sys:String>
    <sys:String x:Key="Settings.BackgroundMode.Image">Image</sys:String>
    <sys:String x:Key="Settings.BackgroundMode.Solid">Solid Colour</sys:String>
    <sys:String x:Key="Settings.BackgroundMode.LinearGradient">Linear Gradient</sys:String>
    <sys:String x:Key="Settings.BackgroundMode.RadialGradient">Radial Gradient</sys:String>
    <sys:String x:Key="Settings.BackgroundMode.Dynamic">Dynamic (Selected Game)</sys:String>
    <sys:String x:Key="Settings.PrimaryColour">Primary Colour</sys:String>
    <sys:String x:Key="Settings.AccentColour">Accent Colour</sys:String>
    <sys:String x:Key="Settings.Vignette">Vignette</sys:String>
    <sys:String x:Key="Settings.BackgroundImage">Background Image</sys:String>
    <sys:String x:Key="Settings.SelectImage">Select Image</sys:String>
    <sys:String x:Key="Settings.NoImage">None</sys:String>
    <sys:String x:Key="Settings.SelectImageDialogTitle">Select Background Image</sys:String>
    <sys:String x:Key="Settings.ReturnToXeniaOnQuit">Return to Xenia Manager on Quit</sys:String>
    <sys:String x:Key="Settings.ReturnToXeniaOnQuit.Description">On: Returns to Xenia Manager · Off: Closes Everything</sys:String>
    <sys:String x:Key="Settings.Controllers.None">No controllers connected</sys:String>
    <sys:String x:Key="Settings.Controllers.Primary">Primary</sys:String>
    <sys:String x:Key="Settings.Controllers.Secondary">Secondary</sys:String>
    <sys:String x:Key="Settings.Controllers.StatusLabel">Status:</sys:String>
    <sys:String x:Key="Settings.Controllers.BatteryUnknown">Unknown</sys:String>
    <sys:String x:Key="Settings.Hint.Back">Back</sys:String>

    <!-- Splash screen -->
    <sys:String x:Key="Splash.Title">Xenia Big Screen</sys:String>
    <sys:String x:Key="Splash.Loading">Loading…</sys:String>
    <sys:String x:Key="Splash.LoadingProfile">Loading Profile</sys:String>
    <sys:String x:Key="Splash.LoadingSettings">Loading Settings</sys:String>
    <sys:String x:Key="Splash.LoadingDashboard">Loading Dashboard</sys:String>
    <sys:String x:Key="Splash.LoadingLibrary">Loading Library</sys:String>
    <sys:String x:Key="Splash.LoadingMedia">Loading Media</sys:String>
    <sys:String x:Key="Splash.LoadingDone">Loading Done</sys:String>

    <!-- Modal system (generic) -->
    <sys:String x:Key="Modal.Confirm">Confirm</sys:String>
    <sys:String x:Key="Modal.Cancel">Cancel</sys:String>

    <!-- Profile picker -->
    <sys:String x:Key="Profiles.Title">Profiles</sys:String>
    <sys:String x:Key="Profiles.NoProfilesFound">No profiles found - manage them from Settings</sys:String>
    <sys:String x:Key="Profiles.Hint.Back">Back</sys:String>
    <sys:String x:Key="Profiles.Hint.Select">Select</sys:String>
    <sys:String x:Key="Profiles.Hint.Manage">Manage</sys:String>

    <!-- Manage Profiles overlay -->
    <sys:String x:Key="ManageProfiles.Title">Manage Profiles</sys:String>
    <sys:String x:Key="ManageProfiles.NoProfilesFound">No profiles found - create one with the + button</sys:String>
    <sys:String x:Key="ManageProfiles.CreateNewProfile">Create New Profile</sys:String>
    <sys:String x:Key="ManageProfiles.Hint.Back">Back</sys:String>
    <sys:String x:Key="ManageProfiles.Hint.Delete">Delete</sys:String>
    <sys:String x:Key="ManageProfiles.Hint.Import">Import</sys:String>
    <sys:String x:Key="ManageProfiles.Hint.Export">Export</sys:String>
    <sys:String x:Key="ManageProfiles.Save.Button">Save</sys:String>
    <sys:String x:Key="ManageProfiles.Save.Success">{0} profile(s) saved</sys:String>
    <sys:String x:Key="ManageProfiles.Save.Error">Failed to save profiles</sys:String>
    <sys:String x:Key="ManageProfiles.Create.Success">Created '{0}' - edit and save to finish</sys:String>
    <sys:String x:Key="ManageProfiles.Delete.Confirmation.Title">Delete Profile</sys:String>
    <sys:String x:Key="ManageProfiles.Delete.Confirmation.Message">Delete '{0}'? ALL of its saves, achievements and content will be permanently lost. This cannot be undone.</sys:String>
    <sys:String x:Key="ManageProfiles.Delete.Success">Profile deleted</sys:String>
    <sys:String x:Key="ManageProfiles.Delete.Error">Failed to delete profile</sys:String>
    <sys:String x:Key="ManageProfiles.Unsaved.Title">Unsaved Changes</sys:String>
    <sys:String x:Key="ManageProfiles.Unsaved.Message">Save changes to '{0}'?</sys:String>
    <sys:String x:Key="ManageProfiles.Unsaved.Save">Save</sys:String>
    <sys:String x:Key="ManageProfiles.Unsaved.Discard">Discard</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Gamertag">Gamertag</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Gamertag.Watermark">Enter a gamertag</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Gamertag.Error.Empty">Gamertag cannot be empty</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Gamertag.Error.TooLong">Gamertag cannot be longer than {0} characters</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Gamertag.Error.InvalidFormat">Gamertag must start with a letter and contain only letters and numbers</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Country">Country</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.Language">Language</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.LiveEnabled">Xbox Live</sys:String>
    <sys:String x:Key="ManageProfiles.Edit.SubscriptionTier">Subscription Tier</sys:String>
    <sys:String x:Key="ManageProfiles.Import.FilePicker.Title">Import Profile</sys:String>
    <sys:String x:Key="ManageProfiles.Import.Replace.Confirmation.Title">Replace Profile</sys:String>
    <sys:String x:Key="ManageProfiles.Import.Replace.Confirmation.Message">A profile named '{0}' ({1}) already exists. Replace it?</sys:String>
    <sys:String x:Key="ManageProfiles.Import.Success">Imported '{0}'</sys:String>
    <sys:String x:Key="ManageProfiles.Import.Canceled">Import canceled</sys:String>
    <sys:String x:Key="ManageProfiles.Import.Failed">Failed to import profile</sys:String>
    <sys:String x:Key="ManageProfiles.Export.FilePicker.Title">Export Profile</sys:String>
    <sys:String x:Key="ManageProfiles.Export.Confirmation.Title">Export Saves</sys:String>
    <sys:String x:Key="ManageProfiles.Export.Confirmation.Message">Include the profile's saves and content in the export?</sys:String>
    <sys:String x:Key="ManageProfiles.Export.Success">Exported '{0}'</sys:String>
    <sys:String x:Key="ManageProfiles.Export.Failed">Failed to export profile</sys:String>
</ResourceDictionary>