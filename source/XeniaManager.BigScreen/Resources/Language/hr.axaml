    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Comment">Prilagođena širina za internu rezoluciju prikaza&#10;NAPOMENA: Zahtjeva internu rezoluciju prikaza da bude postavljena na "Prilagođeno (X/Y)" kako bi funkcionirala</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Title">Prilagođena visina rezolucije</sys:String>
