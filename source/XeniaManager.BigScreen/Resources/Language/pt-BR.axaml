    <sys:String x:Key="ConfigUiSettings.APU.mute.Comment">Silencia toda a saída de áudio</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.enable_xmp.Title">XMP</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.enable_xmp.Comment">Ativa a reprodução do reprodutor de música&#10;Isso pode corrigir a música em alguns jogos</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xmp_default_volume.Title">Volume padrão do XMP</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xmp_default_volume.Comment">Volume padrão da música caso o jogo não o defina</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_dedicated_xma_thread.Title">Thread dedicada para XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_dedicated_xma_thread.Comment">Ativa a decodificação XMA em uma thread separada&#10;Com esta opção desativada, espere maior compatibilidade, mas menor desempenho</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_new_decoder.Title">Decodificador de áudio XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.use_new_decoder.Comment">Ativa o uso do novo decodificador de áudio XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.Title">Decodificador XMA</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.Comment">fake: Nenhum áudio será decodificado&#10;master: Versão do decodificador idêntica à do Xenia base&#10;old: Decodificador baseado na versão master com pequenas melhorias&#10;new: Nova versão do decodificador. Oferece máxima estabilidade, mas ainda não está finalizada</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.fake">Falso (Fake)</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.master">Master</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.old">Antigo (Old)</sys:String>
    <sys:String x:Key="ConfigUiSettings.APU.xma_decoder.option.new">Novo (New)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.Title">Máscara de licença (License Mask)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.Comment">- No License: Modo de demonstração (Demo)&#10;- First License: Geralmente a licença de versão completa em títulos Xbox Live Arcade&#10;- All Licenses: Todas as licenças possíveis ativadas (pode causar comportamentos indefinidos)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.0">Sem Licença (Demo)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.1">Primeira Licença (Completa)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Content.license_mask.option.-1">Todas as Licenças</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.break_on_unimplemented_instructions.Title">Interromper em Instruções não Implementadas</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.break_on_unimplemented_instructions.Comment">Interrompe a execução para o depurador do host (ou encerra o jogo caso não haja depurador anexado) ao encontrar uma instrução PowerPC não implementada</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disable_context_promotion.Title">Desativar Promoção de Contexto</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disable_context_promotion.Comment">Desativa otimizações de promoção de contexto&#10;Pode ser necessário para certos jogos esportivos, mas reduz o desempenho</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disassemble_functions.Title">Desmontar Funções (Disassemble)</sys:String>
    <sys:String x:Key="ConfigUiSettings.CPU.disassemble_functions.Comment">Desmonta funções durante a geração de código</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_allow_variable_refresh_rate_and_tearing.Title">Permitir Taxa de Atualização Variável (VRR) e Tearing</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_allow_variable_refresh_rate_and_tearing.Comment">Em tela cheia, permite o uso de VRR (G-Sync/FreeSync) em monitores compatíveis&#10;Em monitores sem suporte a VRR, screen tearing pode ocorrer em certos casos</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.Title">Prioridade da Fila de Comandos</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.Comment">Prioridade de agendamento da fila de comandos gráficos diretos&#10;0 - Normal&#10;1 - Alta&#10;2 - Tempo real global (requer privilégios de administrador e pode afetar a responsividade do sistema)</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.0">Normal</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.1">Alta</sys:String>
    <sys:String x:Key="ConfigUiSettings.D3D12.d3d12_queue_priority.option.2">Tempo real global (Global Realtime)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.fullscreen.Title">Tela Cheia</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.fullscreen.Comment">Inicia o emulador em modo de tela cheia</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.present_letterbox.Title">Exibir barras pretas (Letterbox)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.present_letterbox.Comment">Mantém a proporção da tela ao esticar, exibindo barras nas bordas quando não houver mais área de overscan para recortar</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.Title">Antisserrilhamento (Anti-Aliasing)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.Comment">Efeito de pós-processamento de antisserrilhamento aplicado à imagem final do jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.none">Nenhum</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.fxaa">FXAA</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_antialiasing.option.fxaa_extreme">FXAA Extremo</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.Title">Escalonamento e Nitidez</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.Comment">Efeito de pós-processamento usado para reamostragem e/ou nitidez da imagem final</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.bilinear">Bilinear</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.cas">CAS</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_scaling_and_sharpening.option.fsr">FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_sharpness_reduction.Title">Redução de nitidez do FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_sharpness_reduction.Comment">Redução de nitidez para AMD FidelityFX Super Resolution 1.0 (FSR), em pontos de parada&#10;Valores menores produzem imagens mais nítidas</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_cas_additional_sharpness.Title">Nitidez Adicional do CAS</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_cas_additional_sharpness.Comment">Nitidez adicional para AMD FidelityFX Contrast Adaptive Sharpening (CAS), de 0 a 1&#10;Valores maiores produzem imagens mais nítidas</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_max_upsampling_passes.Title">Máximo de Passagens de Upsampling do FSR</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_ffx_fsr_max_upsampling_passes.Comment">Número máximo de passagens de upsampling realizadas no AMD FidelityFX Super Resolution 1.0 (FSR) antes de recorrer ao estiramento bilinear após a passagem final</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_dither.Title">Dither</sys:String>
    <sys:String x:Key="ConfigUiSettings.Display.postprocess_dither.Comment">Aplica dithering à imagem final para reduzir bandas de cor em gradientes ao converter para 8 bits por canal</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.allow_plugins.Title">Permitir Plugins</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.allow_plugins.Comment">Permite o carregamento de plugins pelo emulador. Essa é uma função experimental.</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.discord.Title">Discord Rich Presence</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.discord.Comment">Ativa a integração de status do jogo no Discord</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.apply_patches.Title">Aplicar Patches</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.apply_patches.Comment">Aplica automaticamente os patches instalados ao iniciar o jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.controller_hotkeys.Title">Atalhos no Controle</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.controller_hotkeys.Comment">Ativa combinações de botões no controle como atalhos</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.launch_module.Title">Módulo de Inicialização</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.launch_module.Comment">Especifica um módulo executável alternativo a ser iniciado. Deixe em branco para iniciar o executável padrão.</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.notification_sound_path.Title">Som de Notificação</sys:String>
    <sys:String x:Key="ConfigUiSettings.General.notification_sound_path.Comment">Caminho para o arquivo de som de notificação personalizado&#10;AVISO: Precisa estar no formato .wav!</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.vsync.Title">VSync</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.vsync.Comment">Habilitar VSYNC</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.framerate_limit.Title">Limite de Taxa de Quadros (FPS)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.framerate_limit.Comment">Número máximo de quadros por segundo&#10;0 = Quadros ilimitados&#10;O padrão é 60 quando definido como 0 e o VSync estiver ativado</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.Title">Sistema de Gráficos</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.Comment">API gráfica a ser utilizada</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.any">Automático</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.d3d12">D3D12</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.vulkan">Vulkan</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu.option.null">Nenhum (Null)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.Title">Caminho do Render Target (D3D12)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.Comment">Caminho de emulação de render target no Direct3D 12&#10;RTV - Destinos de renderização do host&#10;ROV - Visualizações ordenadas pelo rasterizador (Rasterizer-ordered views)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.any">Automático</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.rtv">RTV</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_d3d12.option.rov">ROV</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.Title">Caminho do Render Target (Vulkan)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.Comment">Caminho de emulação de render target no Vulkan&#10;FBO - Framebuffers do host&#10;FSI - Fragment shader interlock</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.any">Automático</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.fbo">FBO</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.render_target_path_vulkan.option.fsi">FSI</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.Title">Leitura de Resolve (Readback)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.Comment">Controla a leitura pela CPU dos resultados de resolve de render-to-texture&#10;None - desativa a leitura&#10;Fast - atraso de 1 quadro&#10;Full - preciso, porém mais lento</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.none">Nenhum (None)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.fast">Rápido (Fast)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_resolve.option.full">Completo (Full)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_memexport.Title">Leitura de Memexport (Readback)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.readback_memexport.Comment">Lê na CPU os dados gravados pela exportação de memória dos shaders.&#10;Pode ser necessário para alguns jogos, mas causa sincronização no meio do quadro com grande impacto no desempenho</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_x.Title">Escala de Resolução Horizontal (X)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_x.Comment">Escala inteira de largura em pixels usada para aumentar a resolução de renderização de forma transparente para o jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_y.Title">Escala de Resolução Vertical (Y)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.draw_resolution_scale_y.Comment">Escala inteira de altura em pixels usada para aumentar a resolução de renderização de forma transparente para o jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu_allow_invalid_fetch_constants.Title">Permitir Constantes de Busca Inválidas</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gpu_allow_invalid_fetch_constants.Comment">Permite constantes de busca de textura e vértice com tipo inválido&#10;Geralmente inseguro, mas pode ser usado para contornar erros de tipo de constante de busca em certos jogos</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gamma_render_target_as_srgb.Title">Render Target de gama como sRGB</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.gamma_render_target_as_srgb.Comment">Quando o host não puder gravar gama linear por partes diretamente com mistura correta, usa saída sRGB no host para mistura conceitualmente correta no espaço de cores linear</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_lower_threshold.Title">Limite inferior de amostra de oclusão</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_lower_threshold.Comment">Se definido como -1, nenhuma contagem de amostras é gravada e os jogos podem travar&#10;Caso contrário, a contagem de amostras de cada bloco será incrementada a cada EVENT_WRITE_ZPD por este valor</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_upper_threshold.Title">Limite superior de amostra de oclusão</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.query_occlusion_sample_upper_threshold.Comment">Defina um número maior que o limite inferior de amostra de oclusão&#10;Este valor é ignorado se o limite inferior estiver definido como -1</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.use_fuzzy_alpha_epsilon.Title">Usar Aproximação de Alpha Epsilon</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.use_fuzzy_alpha_epsilon.Comment">Usa comparação aproximada para valores alfa para evitar cintilação em placas de vídeo NVIDIA</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.clear_memory_page_state.Title">Limpar Estado da Página de Memória</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.clear_memory_page_state.Comment">Atualiza o estado das páginas de memória para habilitar dados gravados pela GPU</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.Title">Forçar Filtragem Anisotrópica</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.Comment">Força filtragem anisotrópica (AF) para texturas qualificadas&#10;Valores mais altos mantêm texturas nítidas em ângulos oblíquos ao custo de largura de banda da GPU&#10;Em casos raros, pode causar artefatos visuais</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.-1">Sem Substituição (Padrão)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.0">Desativar Filtragem Anisotrópica</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.1">1x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.2">2x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.3">4x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.4">8x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.anisotropic_override.option.5">16x</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.async_shader_compilation.Title">Compilação Assíncrona de Shaders</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.async_shader_compilation.Comment">Compila shaders e cria pipelines de forma assíncrona em segundo plano&#10;Elimina engasgos de compilação, mas pode causar breves artefatos visuais enquanto os pipelines são criados&#10;Quando desativado, os pipelines são criados sincronamente causando engasgos, mas sem artefatos visuais</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.Title">Consulta de Oclusão (Occlusion Query)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.Comment">Controla o comportamento de consulta de oclusão de hardware para EVENT_WRITE_ZPD&#10;Usado para efeitos como reflexo de lente (lens flare), descarte de objetos (culling) e autoexposição&#10;fake: Grava um resultado falso sem consultar a GPU. Seguro para a maioria dos jogos&#10;fast: Consulta a GPU sem esperar. Grava o resultado em cache e atualiza quando a GPU alcançar. (Padrão)&#10;fast-alt: Como o modo rápido, mas mantém resultados zero em cache para relatórios não resolvidos&#10;strict: Consulta a GPU e aguarda pelo resultado real. Mais preciso, menor desempenho</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fake">Falsa (Fake)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fast">Rápida (Padrão)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.fast-alt">Rápida Alternativa (Fast-Alt)</sys:String>
    <sys:String x:Key="ConfigUiSettings.GPU.occlusion_query.option.strict">Estrita (Strict)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.Title">Sistema de Controles</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.Comment">Sistema de entrada/controles a ser utilizado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.any">Automático</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.nop">Nenhum (Nop)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.sdl">SDL</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.winkey">WinKey</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.hid.option.xinput">XInput</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.Title">Modo de Teclado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.Comment">Especifica o modo de funcionamento do teclado:&#10;0 - Desativado&#10;1 - Ativado&#10;2 - Passagem direta (Passthrough, requer controle conectado)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.0">Desativado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.1">Ativado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_mode.option.2">Passagem direta (Passthrough)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_user_index.Title">Índice de usuário do teclado</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.keyboard_user_index.Comment">Porta do controle que o teclado emula (0 a 3)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.left_stick_deadzone_percentage.Title">Deadzone do Analógico Esquerdo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.left_stick_deadzone_percentage.Comment">Define o nível da zona morta para o analógico esquerdo (0 a 100%)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.right_stick_deadzone_percentage.Title">Deadzone do Analógico Direito</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.right_stick_deadzone_percentage.Comment">Define o nível da zona morta para o analógico direito (0 a 100%)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.vibration.Title">Vibração</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.vibration.Comment">Ativa ou desativa a vibração do controle</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_a.Title">Botão A</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_a.Comment">Lista de teclas mapeadas para A, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q I" mapeia tanto Q quanto I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_b.Title">Botão B</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_b.Comment">Lista de teclas mapeadas para B, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q I" mapeia tanto Q quanto I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_back.Title">Botão BACK</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_back.Comment">Lista de teclas mapeadas para BACK, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q I" mapeia tanto Q quanto I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_down.Title">D-Pad para baixo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_down.Comment">Lista de teclas mapeadas para DPAD_DOWN, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "^S" significa Shift+S</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_left.Title">D-Pad para esquerda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_left.Comment">Lista de teclas mapeadas para DPAD_LEFT, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "^A" significa Shift+A</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_right.Title">D-Pad para direita</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_right.Comment">Lista de teclas mapeadas para DPAD_RIGHT, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "^D" significa Shift+D</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_up.Title">D-Pad para cima</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_dpad_up.Comment">Lista de teclas mapeadas para DPAD_UP, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "^W" significa Shift+W</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_guide.Title">Botão Guide</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_guide.Comment">Lista de teclas mapeadas para GUIDE, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Example: "0x08" is Backspace</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_shoulder.Title">Botão LB</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_shoulder.Comment">Lista de teclas mapeadas para LEFT_SHOULDER, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "1 2" mapeia tanto 1 quanto 2</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb.Title">Pressionar analógico esquerdo (LS)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb.Comment">Lista de teclas mapeadas para LEFT_THUMB_PRESSED, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "F" mapeia F</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_down.Title">Analógico esquerdo para baixo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_down.Comment">Lista de teclas mapeadas para LEFT_THUMB_DOWN, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "_S" exige S sem Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_left.Title">Analógico esquerdo para a esquerda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_left.Comment">Lista de teclas mapeadas para LEFT_THUMB_LEFT, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "_A" exige A sem Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_right.Title">Analógico esquerdo para a direita</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_right.Comment">Lista de teclas mapeadas para LEFT_THUMB_RIGHT, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "_D" exige D sem Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_up.Title">Analógico esquerdo para cima</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_thumb_up.Comment">Lista de teclas mapeadas para LEFT_THUMB_UP, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "_W" exige W sem Shift</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_trigger.Title">Gatilho Esquerdo (LT)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_left_trigger.Comment">Lista de teclas mapeadas para LEFT_TRIGGER, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q" mapeia Q</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_shoulder.Title">Botão RB</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_shoulder.Comment">Lista de teclas mapeadas para RIGHT_SHOULDER, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q" mapeia Q</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb.Title">Pressionar analógico direito (RS)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb.Comment">Lista de teclas mapeadas para RIGHT_THUMB_PRESSED, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "C" mapeia C</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_down.Title">Analógico direito para baixo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_down.Comment">Lista de teclas mapeadas para RIGHT_THUMB_DOWN, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "0x28" é a Seta para Baixo</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_left.Title">Analógico direito para a esquerda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_left.Comment">Lista de teclas mapeadas para RIGHT_THUMB_LEFT, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "0x25" é a Seta para a Esquerda</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_right.Title">Analógico direito para a direita</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_right.Comment">Lista de teclas mapeadas para RIGHT_THUMB_RIGHT, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "0x27" é a Seta para a Direita</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_up.Title">Analógico direito para cima</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_thumb_up.Comment">Lista de teclas mapeadas para RIGHT_THUMB_UP, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "0x26" é a Seta para Cima</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_trigger.Title">Gatilho direito (RT)</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_right_trigger.Comment">Lista de teclas mapeadas para RIGHT_TRIGGER, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "E O" mapeia tanto E quanto O ao mesmo gatilho</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_start.Title">Botão START</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_start.Comment">Lista de teclas mapeadas para START, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q I" mapeia tanto Q quanto I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_x.Title">Botão X</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_x.Comment">Lista de teclas mapeadas para X, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q I" mapeia tanto Q quanto I</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_y.Title">Botão Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.HID.WinKey.keybind_y.Comment">Lista de teclas mapeadas para Y, separadas por espaços. Formato: código de tecla virtual (0x26), caractere único (A-Z, 0-9), com modificadores (^ exige Shift, _ exige sem Shift). Exemplo: "Q I" mapeia tanto Q quanto I</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.apply_title_update.Title">Aplicar Atualizações do Jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.apply_title_update.Comment">Aplica atualizações de jogo (Title Updates) instaladas</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.cl.Title">Linha de Comando</sys:String>
    <sys:String x:Key="ConfigUiSettings.Kernel.cl.Comment">Especifica argumentos de linha de comando adicionais fornecidos ao jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.enable_console.Title">Ativar Console de Log</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.enable_console.Comment">Abre uma janela de console com os logs ao iniciar o emulador</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.Title">Nível de Log</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.Comment">Nível máximo de detalhamento a ser registrado</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.0">Erro</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.1">Aviso</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.2">Informação (Info)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Logging.log_level.option.3">Depuração (Debug)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.protect_zero.Title">Proteger Página Zero</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.protect_zero.Comment">Protege a página de memória zero contra operações de leitura e gravação</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.scribble_heap.Title">Preenchimento de Heap (Scribble)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Memory.scribble_heap.Comment">Preenche com valores específicos ou aleatórios toda a memória heap alocada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_cache.Title">Montar Partição de Cache</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_cache.Comment">Ativa a montagem da partição de cache do console</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_scratch.Title">Montar Partição Temporária (Scratch)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Storage.mount_scratch.Comment">Ativa a montagem da partição temporária de trabalho (Scratch)</sys:String>
    <sys:String x:Key="ConfigUiSettings.UI.show_achievement_notification.Title">Exibir Notificações de Conquista</sys:String>
    <sys:String x:Key="ConfigUiSettings.UI.show_achievement_notification.Comment">Exibe na tela a notificação de conquista desbloqueada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.Title">Resolução Interna de Renderização</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.Comment">Permite que jogos compatíveis com diferentes resoluções sejam renderizados na resolução selecionada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.0">640x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.1">640x576</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.2">720x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.3">720x576</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.4">800x600</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.5">848x480</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.6">1024x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.7">1152x864</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.8">1280x720</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.9">1280x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.10">1280x960</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.11">1280x1024</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.12">1360x768</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.13">1440x900</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.14">1680x1050</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.15">1920x540</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.16">1920x1080</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution.option.17">Personalizada (X/Y)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Title">Largura da Resolução Personalizada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_x.Comment">Largura personalizada para a resolução interna&#10;NOTA: Exige que a 'Resolução interna de renderização' esteja definida como "Personalizada (X/Y)" para ter efeito</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Title">Altura da Resolução Personalizada</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.internal_display_resolution_y.Comment">Altura personalizada para a resolução interna&#10;NOTA: Exige que a 'Resolução interna de renderização' esteja definida como "Personalizada (X/Y)" para ter efeito</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.widescreen.Title">Widescreen</sys:String>
    <sys:String x:Key="ConfigUiSettings.Video.widescreen.Comment">Alterna entre as proporções de tela 16:9 (Widescreen) e 4:3</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_immediate.Title">Permitir modo de apresentação imediato (Immediate)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_immediate.Comment">Quando disponível, permite o modo de apresentação imediata (1ª prioridade), oferecendo a menor latência possível com risco de tearing em certos casos</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_mailbox.Title">Permitir Modo de Apresentação Mailbox</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_mailbox.Comment">Quando disponível, permite o modo de apresentação mailbox (2ª prioridade), oferecendo baixa latência sem ocorrência de tearing</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_fifo_relaxed.Title">Permitir modo de apresentação FIFO Relaxed</sys:String>
    <sys:String x:Key="ConfigUiSettings.Vulkan.vulkan_allow_present_mode_fifo_relaxed.Comment">Quando disponível, permite o modo de apresentação FIFO relaxado (3ª prioridade), aguardando o V-Sync do monitor, mas permitindo tearing se a taxa de quadros cair abaixo da taxa de atualização</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.api_address.Title">Endereço da API</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.api_address.Comment">Endereço do servidor do Xenia Netplay (ex.: IP:PORTA)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.discord_presence_user_index.Title">Índice de usuário no Discord Rich Presence</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.discord_presence_user_index.Comment">Índice do perfil de usuário usado para o Discord Rich Presence (0 a 3)</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.Title">Modo de Rede</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.Comment">Modo de conexão de rede&#10;0 - Offline&#10;1 - System Link&#10;2 - Xbox Live</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.0">Offline</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.1">Systemlink</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.network_mode.option.2">Xbox Live</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.upnp.Title">UPnP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.upnp.Comment">Ativa o redirecionamento automático de portas via UPnP no roteador</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xhttp.Title">XHTTP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xhttp.Comment">Ativa a emulação da biblioteca de rede XHTTP</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xlink_kai_systemlink_hack.Title">Hack de System Link para XLink Kai</sys:String>
    <sys:String x:Key="ConfigUiSettings.Live.xlink_kai_systemlink_hack.Comment">Ativa compatibilidade especial para partidas via túnel XLink Kai</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_autoaim.Title">Desativar Mira Automática</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_autoaim.Comment">Desativa os auxílios de mira automática do jogo ao mirar com o mouse</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_fullscreen_esc_bind.Title">Desativar tecla ESC para sair de tela cheia</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.disable_fullscreen_esc_bind.Comment">Impede que a tecla ESC saia do modo de tela cheia</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.fov_sensitivity.Title">Sensibilidade proporcional ao FOV</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.fov_sensitivity.Comment">Ajusta automaticamente a sensibilidade do mouse com base no campo de visão (FOV)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_aim_turn_distance.Title">(GoldenEye/Perfect Dark)&#10;Distância de rotação da mira</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_aim_turn_distance.Comment">Define a distância para virar a câmera ao mirar</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_debug_menu.Title">(GoldenEye)&#10;Menu de depuração</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_debug_menu.Comment">Ativa o menu secreto de depuração</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_gun_sway.Title">(GoldenEye/Perfect Dark)&#10;Oscilação da arma</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_gun_sway.Comment">Ativa a animação de oscilação da arma ao movimentar a mira</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_remove_blur.Title">(GoldenEye)&#10;Remover desfoque</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.ge_remove_blur.Comment">Remove o efeito de motion blur do jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.internal_hook.Title">Hook interno</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.internal_hook.Comment">Ativa a injeção do hook interno do Mousehook para suporte direto à câmera</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_x.Title">Inverter eixo X</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_x.Comment">Inverte o movimento horizontal do mouse</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_y.Title">Inverter eixo Y</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.invert_y.Comment">Inverte o movimento vertical do mouse</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.menu_sensitivity.Title">(GoldenEye/Saints Row 1)&#10;Sensibilidade do menu</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.menu_sensitivity.Comment">Sensibilidade do ponteiro do mouse dentro dos menus do jogo</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_snappy_wheel.Title">(Red Dead Redemption)&#10;Roda de seleção rápida</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_snappy_wheel.Comment">Melhora a resposta e o encaixe ao selecionar armas na roda de itens</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_turbo_gallop_horse.Title">(Red Dead Redemption)&#10;Galope turbo para cavalos</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.rdr_turbo_gallop_horse.Comment">Permite galope contínuo sem precisar pressionar repetidamente o botão</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sensitivity.Title">Sensibilidade do Mouse</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sensitivity.Comment">Sensibilidade geral do mouse</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.source_sniper_sensitivity.Title">Sensibilidade de mira sniper (estilo Source)</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.source_sniper_sensitivity.Comment">Sensibilidade de mira telescópica calibrada como nos jogos da engine Source/Valve</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr1_increase_vehicle_rotation_limit.Title">(Saints Row 1)&#10;Aumentar limite de rotação do veículo</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr1_increase_vehicle_rotation_limit.Comment">Aumenta o limite de rotação da câmera ao dirigir veículos</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_better_handbrake_cam.Title">(Saints Row 2)&#10;Melhor câmera de freio de mão</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_better_handbrake_cam.Comment">Evita giros desorientadores da câmera ao puxar o freio de mão</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_hold_fine_aim.Title">(Saints Row 2)&#10;Segurar para mirar com precisão</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr2_hold_fine_aim.Comment">Permite segurar o botão para manter a mira de precisão ativada</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_better_drive_cam.Title">(Saints Row 1 &amp; 2)&#10;Melhor câmera de direção</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_better_drive_cam.Comment">Melhora a centralização e estabilidade da câmera de condução</sys:String>
    <sys:String x:Key="ConfigUiSettings.MouseHook.sr_disable_shared_reload.Title">(Saints Row 1)&#10;Desativar recarga compartilhada</sys:String>
