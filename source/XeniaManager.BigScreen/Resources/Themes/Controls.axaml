<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:set="using:XeniaManager.BigScreen.Controls.Settings">

    <!-- COLOUR PICKER FIELD -->
    <ControlTheme x:Key="{x:Type set:ColorPickerField}"
                  TargetType="set:ColorPickerField">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="set:ColorPickerField">
                <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="12">
                    <Border x:Name="PART_Swatch"
                            Grid.Column="0"
                            Width="56" Height="38"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="2"
                            Background="{DynamicResource CardTitleBar}"
                            IsHitTestVisible="True" />
                    <TextBox x:Name="PART_HexBox"
                             Grid.Column="1"
                             Width="150"
                             FontSize="20"
                             VerticalContentAlignment="Center"
                             Padding="10,4" />
                    <Popup x:Name="PART_Popup"
                           IsLightDismissEnabled="True"
                           Placement="Bottom"
                           HorizontalOffset="-140">
                        <set:PalettePicker x:Name="PART_Palette" />
                    </Popup>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- PALETTE PICKER -->
    <ControlTheme x:Key="{x:Type set:PalettePicker}"
                  TargetType="set:PalettePicker">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="set:PalettePicker">
                <Border Background="{DynamicResource CardBackground}"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="2"
                        BoxShadow="{DynamicResource CardShadowPopup}"
                        Padding="14"
                        Margin="6">
                    <StackPanel x:Name="PART_Palette"
                                Orientation="Horizontal"
                                Spacing="10" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>