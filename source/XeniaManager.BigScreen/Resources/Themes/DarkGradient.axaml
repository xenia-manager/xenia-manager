<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Card surfaces -->
    <Color x:Key="CardBackgroundColor">#FF1F232B</Color>
    <Color x:Key="CardTitleBarColor">#FF101216</Color>
    <Color x:Key="CardBorderColor">#FF191C22</Color>
    <Color x:Key="CardBorderInnerColor">#FF2C313B</Color>
    <Color x:Key="CardSubtleFillColor">#FF1A1E24</Color>
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardTitleBar" Color="{StaticResource CardTitleBarColor}" />
    <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="CardBorderInner" Color="{StaticResource CardBorderInnerColor}" />
    <SolidColorBrush x:Key="CardSubtleFill" Color="{StaticResource CardSubtleFillColor}" />

    <!-- Vignette overlay: transparent center fading to dark at the edges -->
    <RadialGradientBrush x:Key="BackgroundVignette"
                         Center="50%,50%"
                         GradientOrigin="50%,50%">
        <GradientStop Offset="0" Color="#00000000" />
        <GradientStop Offset="0.75" Color="#00000000" />
        <GradientStop Offset="1" Color="#33000000" />
    </RadialGradientBrush>

    <!-- Selection accents (overridden at runtime by user settings) -->
    <SolidColorBrush x:Key="AccentColor" Color="#107C41" />

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFA0A0A0</Color>
    <Color x:Key="TextErrorColor">#FFE5484D</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextError" Color="{StaticResource TextErrorColor}" />

    <!-- Input hint keycap colours -->
    <Color x:Key="HintKeyX">#FF2D6DF6</Color>
    <Color x:Key="HintKeyY">#FFE6A817</Color>
    <Color x:Key="HintKeyA">#FF107C10</Color>
    <Color x:Key="HintKeyB">#FFC50F1F</Color>
    <Color x:Key="HintKeyBack">#B3FFFFFF</Color>

    <!-- Card shadows -->
    <BoxShadows x:Key="CardShadow">0 4 12 0 #40000000</BoxShadows>
    <BoxShadows x:Key="CardShadowSelected">0 6 20 0 #66000000</BoxShadows>
    <BoxShadows x:Key="CardShadowSoft">0 2 6 0 #40000000</BoxShadows>
    <BoxShadows x:Key="CardShadowFlat">0 2 6 0 #33000000</BoxShadows>
    <BoxShadows x:Key="CardShadowPopup">0 8 24 0 #66000000</BoxShadows>

    <!-- Overlay backdrops -->
    <SolidColorBrush x:Key="OverlayBackdrop" Color="#E60A0C10" />
    <SolidColorBrush x:Key="ViewerBackdrop" Color="#FF0A0C10" />

    <!-- Modal backdrop: transparent black, covers the entire window -->
    <SolidColorBrush x:Key="ModalBackdrop" Color="#4D000000" />

    <!-- Confirmation modal backdrop: fills the whole content area (30% black) -->
    <SolidColorBrush x:Key="ModalCardScrim" Color="#4D000000" />

    <!-- FLUENTAVALONIA CONTROL OVERRIDES (brush-typed keys) -->
    <Color x:Key="SystemAccentColor">#FF107C41</Color>
    <Color x:Key="SystemAccentColorLight1">#FF2D9B41</Color>
    <Color x:Key="SystemAccentColorLight2">#FF52B061</Color>
    <Color x:Key="SystemAccentColorLight3">#FF7BC67F</Color>
    <Color x:Key="SystemAccentColorDark1">#FF0E6B38</Color>
    <Color x:Key="SystemAccentColorDark2">#FF0C5A30</Color>
    <Color x:Key="SystemAccentColorDark3">#FF0A4A28</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ControlOutlineBrush" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="ControlOutlineBrushPointerOver" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="ControlOutlineBrushFocused" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ControlOutlineBrushDisabled" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{DynamicResource CardBorderColor}" />

    <!-- ACCENT FILL FAMILY (ComboBoxItem selected bar etc.) -->
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource SystemAccentColorDark1}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource SystemAccentColorDark1}"
                     Opacity="0.9" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource SystemAccentColorDark1}"
                     Opacity="0.8" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#37000000" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{DynamicResource TextPrimaryColor}"
                     Opacity="0.8" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{DynamicResource TextPrimaryColor}"
                     Opacity="0.4" />
</ResourceDictionary>