<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XeniaManager.BigScreen.App"
             xmlns:local="using:XeniaManager.BigScreen"
             xmlns:vm="using:XeniaManager.BigScreen.ViewModels"
             xmlns:items="using:XeniaManager.BigScreen.ViewModels.Items"
             xmlns:controls="using:XeniaManager.BigScreen.Controls"
             xmlns:style="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <!-- Explicit templates match first; the ViewLocator is the last-resort
             fallback for view models without a dedicated template -->
        <DataTemplate DataType="vm:ConfirmationModalViewModel">
            <controls:ConfirmationModal />
        </DataTemplate>
        <DataTemplate DataType="items:ProfileItemViewModel">
            <controls:ProfileRow />
        </DataTemplate>
        <DataTemplate DataType="items:GameCardViewModel">
            <controls:GameCard />
        </DataTemplate>
        <DataTemplate DataType="items:OptionsCardViewModel">
            <controls:OptionsCard />
        </DataTemplate>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://XeniaManager.BigScreen/Resources/Themes/DarkGradient.axaml" />
                <ResourceInclude Source="avares://XeniaManager.BigScreen/Resources/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <style:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="False" />
        <StyleInclude Source="avares://XeniaManager.BigScreen/Resources/BigScreenStyle.axaml"></StyleInclude>
    </Application.Styles>
</Application>